diff --git a/memhub/apps/core/src/one_memory/model_catalog.py b/memhub/apps/core/src/one_memory/model_catalog.py
new file mode 100644
index 0000000..c7e4f3f
--- /dev/null
+++ b/memhub/apps/core/src/one_memory/model_catalog.py
@@ -0,0 +1,252 @@
+"""Bounded model discovery without generation or profile mutations (ADR-0053)."""
+
+from __future__ import annotations
+
+import asyncio
+from enum import StrEnum
+from urllib.parse import urlparse
+from uuid import UUID
+
+import httpx
+from pydantic import BaseModel, ConfigDict, Field, SecretStr, model_validator
+
+from one_memory.http_client import create_async_client
+from one_memory.model_probe import _body_error_code, _headers
+from one_memory.model_profiles import ModelProfileStore, ProviderKind, validate_model_base_url
+from one_memory.secrets import SecretStore
+
+MAX_RESPONSE_BYTES = 1024 * 1024
+MAX_MODELS = 200
+
+
+class CatalogCode(StrEnum):
+    OK = "ok"
+    UNSUPPORTED = "unsupported"
+    MISSING_API_KEY = "missing_api_key"  # pragma: allowlist secret
+    UNREACHABLE = "unreachable"
+    UNAUTHORIZED = "unauthorized"
+    INVALID_RESPONSE = "invalid_response"
+    RATE_LIMITED = "rate_limited"
+    INSUFFICIENT_BALANCE = "insufficient_balance"
+    PROFILE_CHANGED = "profile_changed"
+
+
+class ModelCatalogRequest(BaseModel):
+    model_config = ConfigDict(frozen=True, extra="forbid")
+
+    provider_kind: ProviderKind
+    base_url: str = Field(min_length=1, max_length=2048)
+    api_key: SecretStr | None = None
+    profile_id: str | None = Field(default=None, min_length=36, max_length=36)
+    expected_profile_revision: int | None = Field(default=None, ge=1, strict=True)
+
+    @model_validator(mode="after")
+    def validate_request(self) -> ModelCatalogRequest:
+        validate_model_base_url(self.base_url)
+        parsed = urlparse(self.base_url)
+        if parsed.query or parsed.fragment:
+            raise ValueError("Model base URL cannot contain query or fragment")
+        if (self.profile_id is None) != (self.expected_profile_revision is None):
+            raise ValueError("Profile identity and revision must be supplied together")
+        if self.profile_id is not None and str(UUID(self.profile_id)) != self.profile_id:
+            raise ValueError("Profile identity must be canonical")
+        return self
+
+
+class CatalogModel(BaseModel):
+    model_config = ConfigDict(frozen=True, extra="forbid")
+
+    id: str = Field(min_length=1, max_length=256)
+    display_name: str = Field(min_length=1, max_length=256)
+
+
+class ModelCatalogResult(BaseModel):
+    model_config = ConfigDict(frozen=True, extra="forbid")
+
+    code: CatalogCode
+    models: tuple[CatalogModel, ...] = Field(default=(), max_length=MAX_MODELS)
+    has_more: bool = False
+
+
+class ModelCatalog:
+    def __init__(
+        self,
+        *,
+        store: ModelProfileStore,
+        secrets: SecretStore,
+        transport: httpx.AsyncBaseTransport | None = None,
+    ) -> None:
+        self.store = store
+        self.secrets = secrets
+        self.transport = transport
+
+    async def fetch(self, request: ModelCatalogRequest) -> ModelCatalogResult:
+        if request.provider_kind not in {
+            ProviderKind.ANTHROPIC,
+            ProviderKind.OPENAI_COMPATIBLE,
+            ProviderKind.OLLAMA,
+        }:
+            return ModelCatalogResult(code=CatalogCode.UNSUPPORTED)
+        try:
+            secret = await asyncio.to_thread(self._secret, request)
+        except KeyError:
+            return ModelCatalogResult(code=CatalogCode.PROFILE_CHANGED)
+        if request.provider_kind is not ProviderKind.OLLAMA and not secret:
+            return ModelCatalogResult(code=CatalogCode.MISSING_API_KEY)
+        url = _models_url(request.provider_kind, request.base_url)
+        headers = (
+            {}
+            if request.provider_kind is ProviderKind.OLLAMA
+            else _headers(request.provider_kind, secret)
+        )
+        async with create_async_client(
+            timeout=20.0, follow_redirects=False, transport=self.transport
+        ) as client:
+            try:
+                response = await _bounded_get(client, url, headers)
+                if request.provider_kind is ProviderKind.ANTHROPIC and response.status_code in {
+                    401,
+                    403,
+                }:
+                    if (
+                        request.api_key is None
+                        and request.profile_id is not None
+                        and not await asyncio.to_thread(self._profile_matches, request)
+                    ):
+                        return ModelCatalogResult(code=CatalogCode.PROFILE_CHANGED)
+                    # Some Messages gateways expose an OpenAI-authenticated catalog.
+                    # Retry only this GET, at the identical URL, without forwarding
+                    # x-api-key. This does not change the generation protocol.
+                    headers = _headers(ProviderKind.OPENAI_COMPATIBLE, secret)
+                    headers["anthropic-version"] = "2023-06-01"
+                    response = await _bounded_get(client, url, headers)
+            except (httpx.RequestError, ValueError):
+                return ModelCatalogResult(code=CatalogCode.UNREACHABLE)
+            except _ResponseTooLarge:
+                return ModelCatalogResult(code=CatalogCode.INVALID_RESPONSE)
+        if (
+            request.api_key is None
+            and request.profile_id is not None
+            and not await asyncio.to_thread(self._profile_matches, request)
+        ):
+            return ModelCatalogResult(code=CatalogCode.PROFILE_CHANGED)
+        result = _catalog_response(response)
+        if secret and any(
+            secret in model.id or secret in model.display_name for model in result.models
+        ):
+            return ModelCatalogResult(code=CatalogCode.INVALID_RESPONSE)
+        return result
+
+    def _profile_matches(self, request: ModelCatalogRequest) -> bool:
+        profile = self.store.get(request.profile_id or "", self.secrets)
+        return bool(
+            profile
+            and profile.revision == request.expected_profile_revision
+            and profile.provider_kind == request.provider_kind
+            and (profile.base_url or "").rstrip("/") == request.base_url.rstrip("/")
+        )
+
+    def _secret(self, request: ModelCatalogRequest) -> str | None:
+        if request.api_key is not None:
+            return request.api_key.get_secret_value()
+        if request.profile_id is None:
+            return None
+        if not self._profile_matches(request):
+            raise KeyError("profile_changed")
+        assert request.expected_profile_revision is not None
+        secret = self.store.resolve_snapshot_secret(
+            request.profile_id, request.expected_profile_revision, self.secrets
+        )
+        # Re-read after the secure-store access, which can take user interaction.
+        if not self._profile_matches(request):
+            raise KeyError("profile_changed")
+        return secret
+
+
+def _models_url(provider: ProviderKind, base_url: str) -> str:
+    if provider is ProviderKind.ANTHROPIC:
+        from hy_memory.agent.anthropic_messages import messages_url
+
+        return messages_url(base_url).removesuffix("/messages") + "/models"
+    suffix = "/api/tags" if provider is ProviderKind.OLLAMA else "/models"
+    return base_url.rstrip("/") + suffix
+
+
+class _ResponseTooLarge(Exception):
+    pass
+
+
+async def _bounded_get(
+    client: httpx.AsyncClient, url: str, headers: dict[str, str]
+) -> httpx.Response:
+    async with client.stream("GET", url, headers=headers) as response:
+        # Authentication classification needs no provider-controlled body.
+        if response.status_code in {401, 403}:
+            return httpx.Response(response.status_code)
+        content = bytearray()
+        async for chunk in response.aiter_bytes(chunk_size=65536):
+            if len(content) + len(chunk) > MAX_RESPONSE_BYTES:
+                raise _ResponseTooLarge
+            content.extend(chunk)
+        return httpx.Response(response.status_code, content=bytes(content))
+
+
+def _catalog_response(response: httpx.Response) -> ModelCatalogResult:
+    statuses = {
+        400: CatalogCode.UNSUPPORTED,
+        401: CatalogCode.UNAUTHORIZED,
+        403: CatalogCode.UNAUTHORIZED,
+        404: CatalogCode.UNSUPPORTED,
+        405: CatalogCode.UNSUPPORTED,
+        501: CatalogCode.UNSUPPORTED,
+        402: CatalogCode.INSUFFICIENT_BALANCE,
+        429: CatalogCode.RATE_LIMITED,
+    }
+    if response.status_code in statuses:
+        return ModelCatalogResult(code=statuses[response.status_code])
+    body_error = _body_error_code(response)
+    if body_error is not None:
+        try:
+            code = CatalogCode(body_error.value)
+        except ValueError:
+            code = CatalogCode.INVALID_RESPONSE
+        return ModelCatalogResult(code=code)
+    if not response.is_success:
+        return ModelCatalogResult(code=CatalogCode.INVALID_RESPONSE)
+    try:
+        body = response.json()
+        return _parse_models(body)
+    except (ValueError, TypeError, KeyError):
+        return ModelCatalogResult(code=CatalogCode.INVALID_RESPONSE)
+
+
+def _parse_models(body: object) -> ModelCatalogResult:
+    if not isinstance(body, dict):
+        raise ValueError("invalid_catalog")
+    values = body.get("models") if isinstance(body.get("models"), list) else body.get("data")
+    if not isinstance(values, list) or not isinstance(body.get("has_more", False), bool):
+        raise ValueError("invalid_catalog")
+    models: list[CatalogModel] = []
+    seen: set[str] = set()
+    has_more = body.get("has_more", False)
+    for value in values:
+        if not isinstance(value, dict):
+            raise ValueError("invalid_catalog_item")
+        model_id = value.get("id") or value.get("name") or value.get("model")
+        label = value.get("display_name") or model_id
+        if not all(
+            isinstance(field, str)
+            and 0 < len(field) <= 256
+            and field.strip() == field
+            and all(ord(char) >= 32 and ord(char) != 127 for char in field)
+            for field in (model_id, label)
+        ):
+            raise ValueError("invalid_catalog_item")
+        if model_id in seen:
+            continue
+        seen.add(model_id)
+        if len(models) >= MAX_MODELS:
+            has_more = True
+            break
+        models.append(CatalogModel(id=model_id, display_name=label))
+    return ModelCatalogResult(code=CatalogCode.OK, models=tuple(models), has_more=has_more)
