+import type { ProviderKind } from "@one-memory/contracts";
+import {
+  type Ref,
+  useEffect,
+  useImperativeHandle,
+  useMemo,
+  useRef,
+  useState,
+} from "react";
+import { getModelCatalog } from "./api";
+import type {
+  ModelCatalogCode,
+  ModelCatalogInput,
+  ModelCatalogResult,
+} from "./model-catalog-client";
+
+export interface ModelCatalogActions {
+  loadIfNeeded(): void;
+}
+
+const MESSAGES: Record<
+  Exclude<ModelCatalogCode, "ok"> | "request_failed",
+  string
+> = {
+  unsupported: "这个服务暂不提供模型列表，可以继续手动填写模型名。",
+  missing_api_key: "请先填写 API Key，再获取模型列表。", // pragma: allowlist secret
+  unreachable: "暂时无法连接模型列表接口，请检查地址或继续手动填写。",
+  unauthorized: "模型列表认证未通过，请检查 API Key 是否属于当前服务。",
+  invalid_response: "模型列表的返回格式无法识别，可以继续手动填写模型名。",
+  rate_limited: "模型列表请求频率受限，请稍后刷新或手动填写。",
+  insufficient_balance: "模型账户余额不足，请检查账户或更换 API Key。",
+  profile_changed: "已保存的配置发生变化，请刷新配置后重试。",
+  request_failed: "暂时无法获取模型列表，可以稍后刷新或继续手动填写。",
+};
+
+export function ModelCatalogPicker({
+  provider,
+  baseUrl,
+  apiKey,
+  savedProfile,
+  endpointReady,
+  disabled,
+  selectedModel,
+  onSelect,
+  controlsRef,
+}: {
+  provider: ProviderKind;
+  baseUrl: string;
+  apiKey: string;
+  savedProfile?: { profile_id: string; revision: number };
+  endpointReady: boolean;
+  disabled: boolean;
+  selectedModel: string;
+  onSelect(model: string): void;
+  controlsRef?: Ref<ModelCatalogActions>;
+}) {
+  const input = useMemo<ModelCatalogInput>(
+    () => ({
+      provider_kind: provider,
+      base_url: baseUrl.trim(),
+      ...(apiKey.trim()
+        ? { api_key: apiKey.trim() }
+        : savedProfile
+          ? {
+              profile_id: savedProfile.profile_id,
+              expected_profile_revision: savedProfile.revision,
+            }
+          : {}),
+    }),
+    [
+      provider,
+      baseUrl,
+      apiKey,
+      savedProfile?.profile_id,
+      savedProfile?.revision,
+    ],
+  );
+  const [state, setState] = useState<{
+    input: ModelCatalogInput;
+    loading: boolean;
+    result?: ModelCatalogResult;
+    failed?: boolean;
+  } | null>(null);
+  const request = useRef<AbortController | null>(null);
+  const lastAttempt = useRef<ModelCatalogInput | null>(null);
+  useEffect(
+    () => () => {
+      request.current?.abort();
+      request.current = null;
+    },
+    [input],
+  );
+  const current = state?.input === input ? state : null;
+  const available =
+    endpointReady &&
+    (provider === "ollama" || !!input.api_key || !!input.profile_id);
+
+  async function load(force = false) {
+    if (disabled || !available || request.current) return;
+    if (!force && JSON.stringify(lastAttempt.current) === JSON.stringify(input))
+      return;
+    lastAttempt.current = input;
+    const controller = new AbortController();
+    request.current = controller;
+    setState({ input, loading: true });
+    try {
+      const result = await getModelCatalog(input, controller.signal);
+      if (!controller.signal.aborted && request.current === controller) {
+        setState({ input, loading: false, result });
+      }
+    } catch {
+      if (!controller.signal.aborted && request.current === controller) {
+        setState({ input, loading: false, failed: true });
+      }
+    } finally {
+      if (request.current === controller) request.current = null;
+    }
+  }
+  useImperativeHandle(controlsRef, () => ({
+    loadIfNeeded: () => {
+      void load();
+    },
+  }));
+  const result = current?.result;
+  return (
+    <div className="model-form-field">
+      <button
+        type="button"
+        className="quiet"
+        disabled={disabled || !available || current?.loading}
+        onClick={() => void load(true)}
+      >
+        {current?.loading
+          ? "正在获取模型列表…"
+          : current
+            ? "刷新模型列表"
+            : "获取模型列表"}
+      </button>
+      <small>
+        填写接口地址和密钥后可自动获取，也可手动刷新。列表仅供选择，测试通过后才会启用模型。
+      </small>
+      {result?.code === "ok" && result.models.length > 0 && (
+        <label>
+          从模型列表选择
+          <select
+            aria-label="从模型列表选择"
+            disabled={disabled}
+            value={
+              result.models.some((item) => item.id === selectedModel)
+                ? selectedModel
+                : ""
+            }
+            onChange={(event) => {
+              if (event.target.value) onSelect(event.target.value);
+            }}
+          >
+            <option value="">选择候选，或保留手动填写的模型名</option>
+            {result.models.map((item) => (
+              <option key={item.id} value={item.id}>
+                {item.display_name === item.id
+                  ? item.id
+                  : `${item.display_name} · ${item.id}`}
+              </option>
+            ))}
+          </select>
+        </label>
+      )}
+      <small role="status" aria-live="polite">
+        {current?.failed
+          ? MESSAGES.request_failed
+          : result?.code === "ok"
+            ? result.models.length
+              ? `已获取 ${result.models.length} 个候选模型。${result.has_more ? "列表尚未完整返回，未显示的模型仍可手填。" : ""}`
+              : "服务返回的模型列表为空，仍可手动填写模型名。"
+            : result
+              ? MESSAGES[result.code]
+              : ""}
+      </small>
+    </div>
+  );
+}
