@@ -0,0 +1,512 @@
+"""ADR-0053: catalog selection is bounded, credential-bound, and generation-free."""
+
+import asyncio
+import json
+from uuid import uuid4
+
+import httpx
+import pytest
+from pydantic import SecretStr, ValidationError
+
+from one_memory.api import create_app
+from one_memory.config import Settings
+from one_memory.model_catalog import (
+    MAX_RESPONSE_BYTES,
+    CatalogCode,
+    ModelCatalog,
+    ModelCatalogRequest,
+)
+from one_memory.model_profiles import ModelProfileInput, ModelProfilePatch, ModelProfileStore
+from one_memory.secrets import InMemorySecretStore
+
+API_KEY = "synthetic-catalog-key"  # pragma: allowlist secret
+ADMIN_TOKEN = "synthetic-admin-token"  # pragma: allowlist secret
+
+
+@pytest.fixture
+def catalog_store(tmp_path):
+    return ModelProfileStore(tmp_path / "catalog.sqlite3"), InMemorySecretStore()
+
+
+def _request(**overrides):
+    return ModelCatalogRequest(
+        **{
+            "provider_kind": "anthropic",
+            "base_url": "https://models.example.test",
+            "api_key": SecretStr(API_KEY),
+            **overrides,
+        }
+    )
+
+
+def _fetch(catalog_store, handler, **overrides):
+    store, secrets = catalog_store
+    return asyncio.run(
+        ModelCatalog(store=store, secrets=secrets, transport=httpx.MockTransport(handler)).fetch(
+            _request(**overrides)
+        )
+    )
+
+
+def _profile(catalog_store):
+    store, secrets = catalog_store
+    return store.create(
+        ModelProfileInput(
+            name="Synthetic catalog",
+            provider_kind="anthropic",
+            base_url="https://models.example.test",
+            model="synthetic-model",
+            api_key=SecretStr(API_KEY),
+        ),
+        secrets,
+    )
+
+
+@pytest.mark.parametrize("suffix", ["", "/", "/v1", "/v1/", "/v1/messages"])
+def test_anthropic_catalog_normalizes_paths_and_preserves_display_name(catalog_store, suffix):
+    requests = []
+
+    def handler(request):
+        requests.append(request)
+        assert request.method == "GET" and request.url.path == "/v1/models"
+        assert request.headers["x-api-key"] == API_KEY
+        assert request.headers["anthropic-version"] == "2023-06-01"
+        assert "authorization" not in request.headers
+        assert request.content == b""
+        return httpx.Response(
+            200,
+            json={"data": [{"id": "synthetic-model", "display_name": "Synthetic model"}]},
+        )
+
+    result = _fetch(catalog_store, handler, base_url="https://models.example.test" + suffix)
+    assert result.code == CatalogCode.OK
+    assert [(item.id, item.display_name) for item in result.models] == [
+        ("synthetic-model", "Synthetic model")
+    ]
+    assert result.has_more is False and len(requests) == 1
+    assert catalog_store[0].list(catalog_store[1]) == []
+    assert API_KEY not in result.model_dump_json()
+
+
+@pytest.mark.parametrize("status", [401, 403])
+def test_anthropic_catalog_retries_bearer_once_at_identical_url(catalog_store, status):
+    requests = []
+
+    def handler(request):
+        requests.append(request)
+        if len(requests) == 1:
+            return httpx.Response(status, json={"error": {"message": API_KEY}})
+        assert request.url == requests[0].url and request.method == "GET"
+        assert request.headers["Authorization"] == f"Bearer {API_KEY}"
+        assert "x-api-key" not in request.headers
+        return httpx.Response(200, json={"data": [{"id": "synthetic-model"}]})
+
+    result = _fetch(catalog_store, handler)
+    assert result.code == CatalogCode.OK and len(requests) == 2
+    assert API_KEY not in result.model_dump_json()
+
+
+def test_anthropic_failed_bearer_retry_does_not_loop(catalog_store):
+    requests = []
+
+    def handler(request):
+        requests.append(request)
+        return httpx.Response(401, content=API_KEY.encode())
+
+    result = _fetch(catalog_store, handler)
+    assert result.code == CatalogCode.UNAUTHORIZED and len(requests) == 2
+    assert result.models == () and API_KEY not in result.model_dump_json()
+
+
+@pytest.mark.parametrize(
+    "provider,base,path,body",
+    [
+        (
+            "openai_compatible",
+            "https://models.example.test/v1",
+            "/v1/models",
+            {"data": [{"id": "synthetic-model", "owned_by": "ignored"}]},
+        ),
+        (
+            "ollama",
+            "http://127.0.0.1:11434",
+            "/api/tags",
+            {"models": [{"name": "synthetic-model"}]},
+        ),
+    ],
+)
+def test_existing_provider_catalogs(catalog_store, provider, base, path, body):
+    def handler(request):
+        assert request.method == "GET" and request.url.path == path
+        if provider == "ollama":
+            assert "authorization" not in request.headers
+        else:
+            assert request.headers["authorization"] == f"Bearer {API_KEY}"
+        return httpx.Response(200, json=body)
+
+    result = _fetch(
+        catalog_store,
+        handler,
+        provider_kind=provider,
+        base_url=base,
+        api_key=None if provider == "ollama" else SecretStr(API_KEY),
+    )
+    assert result.code == CatalogCode.OK
+    assert result.models[0].display_name == "synthetic-model"
+
+
+@pytest.mark.parametrize(
+    "status,code",
+    [
+        (400, "unsupported"),
+        (404, "unsupported"),
+        (405, "unsupported"),
+        (501, "unsupported"),
+        (402, "insufficient_balance"),
+        (429, "rate_limited"),
+        (500, "invalid_response"),
+    ],
+)
+def test_catalog_http_errors_are_safe_and_do_not_retry(catalog_store, status, code):
+    requests = []
+
+    def handler(request):
+        requests.append(request)
+        return httpx.Response(status, content=API_KEY.encode())
+
+    result = _fetch(catalog_store, handler)
+    assert result.code.value == code and result.models == ()
+    assert len(requests) == 1 and API_KEY not in result.model_dump_json()
+
+
+def test_openai_auth_failure_is_not_retried(catalog_store):
+    requests = []
+
+    def handler(request):
+        requests.append(request)
+        return httpx.Response(401)
+
+    assert _fetch(catalog_store, handler, provider_kind="openai_compatible").code == "unauthorized"
+    assert len(requests) == 1
+
+
+@pytest.mark.parametrize(
+    "error,code",
+    [
+        ("authentication_error", "unauthorized"),
+        ("rate_limit_error", "rate_limited"),
+        ("insufficient_balance", "insufficient_balance"),
+        ("unknown_model", "invalid_response"),
+    ],
+)
+def test_http_200_error_envelopes_are_not_model_lists(catalog_store, error, code):
+    result = _fetch(
+        catalog_store,
+        lambda _: httpx.Response(200, json={"error": {"type": error, "message": API_KEY}}),
+    )
+    assert result.code == code and result.models == ()
+    assert API_KEY not in result.model_dump_json()
+
+
+def test_catalog_does_not_follow_redirects(catalog_store):
+    requests = []
+
+    def handler(request):
+        requests.append(request)
+        return httpx.Response(302, headers={"location": "https://other.example.test/models"})
+
+    assert _fetch(catalog_store, handler).code == CatalogCode.INVALID_RESPONSE
+    assert len(requests) == 1
+
+
+def test_network_error_is_safe(catalog_store):
+    def handler(request):
+        raise httpx.ConnectError(API_KEY, request=request)
+
+    result = _fetch(catalog_store, handler)
+    assert result.code == CatalogCode.UNREACHABLE and API_KEY not in result.model_dump_json()
+
+
+@pytest.mark.parametrize(
+    "body",
+    [
+        [],
+        {},
+        {"data": "bad"},
+        {"data": [{}]},
+        {"data": [None]},
+        {"data": [{"id": "x" * 257}]},
+        {"data": [{"id": "bad\nmodel"}]},
+        {"data": [{"id": "model", "display_name": "x" * 257}]},
+        {"data": [{"id": 42}]},
+        {"data": [], "has_more": "yes"},
+    ],
+)
+def test_catalog_rejects_malformed_or_unbounded_fields(catalog_store, body):
+    assert (
+        _fetch(catalog_store, lambda _: httpx.Response(200, json=body)).code == "invalid_response"
+    )
+
+
+@pytest.mark.parametrize("has_more", [False, True])
+def test_catalog_preserves_pagination_flag_and_deduplicates(catalog_store, has_more):
+    result = _fetch(
+        catalog_store,
+        lambda _: httpx.Response(
+            200,
+            json={
+                "data": [{"id": "model-a"}, {"id": "model-a"}, {"id": "model-b"}],
+                "has_more": has_more,
+            },
+        ),
+    )
+    assert [item.id for item in result.models] == ["model-a", "model-b"]
+    assert result.has_more is has_more
+
+
+def test_catalog_caps_models_without_changing_model_ids(catalog_store):
+    result = _fetch(
+        catalog_store,
+        lambda _: httpx.Response(
+            200, json={"data": [{"id": f"model-{index}"} for index in range(201)]}
+        ),
+    )
+    assert result.code == "ok" and len(result.models) == 200 and result.has_more
+    assert result.models[-1].id == "model-199"
+
+
+def test_empty_catalog_is_a_valid_empty_selection(catalog_store):
+    result = _fetch(catalog_store, lambda _: httpx.Response(200, json={"data": []}))
+    assert result.code == "ok" and result.models == () and not result.has_more
+
+
+@pytest.mark.parametrize("field", ["id", "display_name"])
+def test_catalog_rejects_secret_echo_in_candidate_fields(catalog_store, field):
+    result = _fetch(
+        catalog_store,
+        lambda _: httpx.Response(200, json={"data": [{"id": "model", field: f"echo-{API_KEY}"}]}),
+    )
+    assert result.code == "invalid_response" and result.models == ()
+    assert API_KEY not in result.model_dump_json()
+
+
+def test_catalog_limits_response_while_streaming(catalog_store):
+    class LargeStream(httpx.AsyncByteStream):
+        chunks_read = 0
+
+        async def __aiter__(self):
+            for _ in range(40):
+                self.chunks_read += 1
+                yield b" " * 65536
+
+    stream = LargeStream()
+    result = _fetch(catalog_store, lambda _: httpx.Response(200, stream=stream))
+    assert result.code == "invalid_response"
+    assert stream.chunks_read == MAX_RESPONSE_BYTES // 65536 + 1
+
+
+def test_exact_response_limit_and_malformed_json(catalog_store):
+    body = json.dumps({"data": []}).encode()
+    body += b" " * (MAX_RESPONSE_BYTES - len(body))
+    assert _fetch(catalog_store, lambda _: httpx.Response(200, content=body)).code == "ok"
+    assert _fetch(catalog_store, lambda _: httpx.Response(200, content=b"not-json")).code == (
+        "invalid_response"
+    )
+
+
+def test_saved_key_is_used_without_mutating_profile(catalog_store):
+    profile = _profile(catalog_store)
+
+    def handler(request):
+        assert request.headers["x-api-key"] == API_KEY
+        return httpx.Response(200, json={"data": [{"id": "another-model"}]})
+
+    result = _fetch(
+        catalog_store,
+        handler,
+        api_key=None,
+        profile_id=profile.profile_id,
+        expected_profile_revision=profile.revision,
+    )
+    assert result.code == "ok"
+    assert catalog_store[0].require(profile.profile_id, catalog_store[1]) == profile
+
+
+@pytest.mark.parametrize("change", ["revision", "provider", "address", "missing"])
+def test_saved_key_binding_fails_before_resolution_or_network(catalog_store, monkeypatch, change):
+    profile = _profile(catalog_store)
+    overrides = {
+        "api_key": None,
+        "profile_id": profile.profile_id,
+        "expected_profile_revision": profile.revision,
+    }
+    if change == "revision":
+        overrides["expected_profile_revision"] += 1
+    elif change == "provider":
+        overrides["provider_kind"] = "openai_compatible"
+    elif change == "address":
+        overrides["base_url"] = "https://other.example.test"
+    else:
+        overrides["profile_id"] = str(uuid4())
+
+    def forbidden(*_args, **_kwargs):
+        raise AssertionError("must not resolve or send")
+
+    monkeypatch.setattr(catalog_store[1], "resolve", forbidden)
+    assert _fetch(catalog_store, forbidden, **overrides).code == "profile_changed"
+
+
+def test_profile_revision_is_rechecked_after_key_access(catalog_store, monkeypatch):
+    store, secrets = catalog_store
+    profile = _profile(catalog_store)
+    original_resolve = secrets.resolve
+
+    def resolve_and_update(reference):
+        value = original_resolve(reference)
+        store.update(
+            profile.profile_id,
+            ModelProfilePatch(expected_revision=profile.revision, model="updated-model"),
+            secrets,
+        )
+        return value
+
+    monkeypatch.setattr(secrets, "resolve", resolve_and_update)
+    result = _fetch(
+        catalog_store,
+        lambda _: pytest.fail("changed profile must not dispatch"),
+        api_key=None,
+        profile_id=profile.profile_id,
+        expected_profile_revision=profile.revision,
+    )
+    assert result.code == "profile_changed"
+
+
+def test_profile_change_during_first_get_prevents_bearer_retry(catalog_store):
+    store, secrets = catalog_store
+    profile = _profile(catalog_store)
+    requests = []
+
+    def handler(request):
+        requests.append(request)
+        store.update(
+            profile.profile_id,
+            ModelProfilePatch(expected_revision=profile.revision, model="updated-model"),
+            secrets,
+        )
+        return httpx.Response(401)
+
+    result = _fetch(
+        catalog_store,
+        handler,
+        api_key=None,
+        profile_id=profile.profile_id,
+        expected_profile_revision=profile.revision,
+    )
+    assert result.code == "profile_changed" and len(requests) == 1
+
+
+def test_explicit_new_key_can_discover_a_new_address_without_saving(catalog_store, monkeypatch):
+    profile = _profile(catalog_store)
+
+    def forbidden(*_args, **_kwargs):
+        raise AssertionError("new key must not resolve a stored credential")
+
+    monkeypatch.setattr(catalog_store[1], "resolve", forbidden)
+
+    def handler(request):
+        assert request.url.host == "new.example.test"
+        assert request.headers["x-api-key"] == API_KEY
+        return httpx.Response(200, json={"data": []})
+
+    result = _fetch(
+        catalog_store,
+        handler,
+        base_url="https://new.example.test",
+        profile_id=profile.profile_id,
+        expected_profile_revision=profile.revision,
+    )
+    assert result.code == "ok"
+    assert catalog_store[0].require(profile.profile_id, catalog_store[1]) == profile
+
+
+@pytest.mark.parametrize(
+    "provider,code", [("anthropic", "missing_api_key"), ("hy_default", "unsupported")]
+)
+def test_missing_credentials_and_unsupported_providers_do_not_dispatch(
+    catalog_store, provider, code
+):
+    result = _fetch(
+        catalog_store,
+        lambda _: pytest.fail("must not dispatch"),
+        api_key=None,
+        provider_kind=provider,
+    )
+    assert result.code == code
+
+
+@pytest.mark.parametrize(
+    "base",
+    [
+        "http://remote.example.test",
+        "https://user:pass@example.test",  # pragma: allowlist secret
+        "https://models.example.test?token=test",
+        "https://models.example.test/#fragment",
+    ],
+)
+def test_catalog_reuses_endpoint_validation(base):
+    with pytest.raises(ValidationError):
+        _request(base_url=base)
+
+
+@pytest.mark.integration
+def test_catalog_route_requires_admin_and_returns_only_safe_fields(tmp_path):
+    async def scenario():
+        secrets = InMemorySecretStore()
+        app = create_app(
+            Settings(
+                data_dir=tmp_path / "data", source_home=tmp_path, api_token=SecretStr(ADMIN_TOKEN)
+            ),
+            secret_store=secrets,
+        )
+        requests = []
+
+        def handler(request):
+            requests.append(request)
+            return httpx.Response(200, json={"data": [{"id": "synthetic-model"}]})
+
+        async with (
+            app.router.lifespan_context(app),
+            httpx.AsyncClient(
+                transport=httpx.ASGITransport(app=app),
+                base_url="http://test",
+                headers={"Origin": "http://127.0.0.1:5173"},
+            ) as client,
+        ):
+            app.state.model_catalog = ModelCatalog(
+                store=app.state.model_profile_store,
+                secrets=secrets,
+                transport=httpx.MockTransport(handler),
+            )
+            payload = {
+                "provider_kind": "anthropic",
+                "base_url": "https://models.example.test",
+                "api_key": API_KEY,
+            }
+            rejected = await client.post("/api/v1/model-catalog", json=payload)
+            assert rejected.status_code == 401 and requests == []
+            client.headers["Authorization"] = f"Bearer {ADMIN_TOKEN}"
+            result = await client.post("/api/v1/model-catalog", json=payload)
+            assert result.status_code == 200 and result.json() == {
+                "code": "ok",
+                "models": [{"id": "synthetic-model", "display_name": "synthetic-model"}],
+                "has_more": False,
+            }
+            assert API_KEY not in result.text and len(requests) == 1
+            assert app.state.model_profile_store.list(secrets) == []
+            invalid = await client.post(
+                "/api/v1/model-catalog", json={**payload, "base_url": "invalid"}
+            )
+            assert invalid.status_code == 422 and API_KEY not in invalid.text
+            assert len(requests) == 1
+
+    asyncio.run(scenario())
