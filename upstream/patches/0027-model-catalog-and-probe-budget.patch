+import { describe, expect, it } from "vitest";
+import { parseModelCatalog } from "./model-catalog-client";
+
+const valid = {
+  code: "ok",
+  models: [{ id: "model-a", display_name: "Model A" }],
+  has_more: false,
+};
+describe("bounded model catalog receipt", () => {
+  it("retains only public model fields", () => {
+    expect(
+      parseModelCatalog({ ...valid, diagnostic: "not forwarded" }),
+    ).toEqual(valid);
+  });
+  it.each([
+    null,
+    { ...valid, code: "unexpected" },
+    { ...valid, has_more: "false" },
+    { ...valid, models: Array(201).fill(valid.models[0]) },
+    { ...valid, models: [valid.models[0], valid.models[0]] },
+    { ...valid, models: [{ id: "x".repeat(257), display_name: "Model" }] },
+    { ...valid, models: [{ id: "model", display_name: " " }] },
+    { ...valid, diagnostic: "x".repeat(1024 * 1024) },
+    { ...valid, code: "unauthorized" },
+  ])("rejects invalid or oversized receipt %#", (value) => {
+    expect(() => parseModelCatalog(value)).toThrow("model_catalog_invalid");
+  });
+  it("accepts an empty unsupported result without inventing model availability", () => {
+    expect(
+      parseModelCatalog({ code: "unsupported", models: [], has_more: false })
+        .code,
+    ).toBe("unsupported");
+  });
+});
diff --git a/memhub/apps/web/src/model-catalog-client.ts b/memhub/apps/web/src/model-catalog-client.ts
new file mode 100644
index 0000000..74da930
--- /dev/null
+++ b/memhub/apps/web/src/model-catalog-client.ts
@@ -0,0 +1,63 @@
+import type { ProviderKind } from "@one-memory/contracts";
+
+export const MODEL_CATALOG_CODES = [
+  "ok",
+  "unsupported",
+  "missing_api_key",
+  "unreachable",
+  "unauthorized",
+  "invalid_response",
+  "rate_limited",
+  "insufficient_balance",
+  "profile_changed",
+] as const;
+export type ModelCatalogCode = (typeof MODEL_CATALOG_CODES)[number];
+export interface ModelCatalogInput {
+  provider_kind: ProviderKind;
+  base_url: string;
+  api_key?: string;
+  profile_id?: string;
+  expected_profile_revision?: number;
+}
+export interface ModelCatalogResult {
+  code: ModelCatalogCode;
+  models: Array<{ id: string; display_name: string }>;
+  has_more: boolean;
+}
+
+export function parseModelCatalog(value: unknown): ModelCatalogResult {
+  const invalid = () => new Error("model_catalog_invalid");
+  if (!value || typeof value !== "object" || Array.isArray(value))
+    throw invalid();
+  if (new TextEncoder().encode(JSON.stringify(value)).length > 1024 * 1024)
+    throw invalid();
+  const row = value as Record<string, unknown>;
+  if (
+    !MODEL_CATALOG_CODES.includes(row.code as ModelCatalogCode) ||
+    typeof row.has_more !== "boolean" ||
+    !Array.isArray(row.models) ||
+    row.models.length > 200
+  ) {
+    throw invalid();
+  }
+  const ids = new Set<string>();
+  const models = row.models.map((item: unknown) => {
+    if (!item || typeof item !== "object" || Array.isArray(item))
+      throw invalid();
+    const model = item as Record<string, unknown>;
+    for (const field of ["id", "display_name"]) {
+      if (
+        typeof model[field] !== "string" ||
+        !model[field].trim() ||
+        model[field].length > 256
+      )
+        throw invalid();
+    }
+    const id = model.id as string;
+    if (ids.has(id)) throw invalid();
+    ids.add(id);
+    return { id, display_name: model.display_name as string };
+  });
+  if (row.code !== "ok" && (models.length || row.has_more)) throw invalid();
+  return { code: row.code as ModelCatalogCode, models, has_more: row.has_more };
+}
