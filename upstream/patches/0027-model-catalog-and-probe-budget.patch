+// @vitest-environment jsdom
+import {
+  act,
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from "@testing-library/react";
+import { createRef } from "react";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { getModelCatalog } from "./api";
+import {
+  type ModelCatalogActions,
+  ModelCatalogPicker,
+} from "./ModelCatalogPicker";
+import type { ModelCatalogResult } from "./model-catalog-client";
+
+vi.mock("./api", () => ({ getModelCatalog: vi.fn() }));
+const catalog = vi.mocked(getModelCatalog);
+const result = (id = "model-a"): ModelCatalogResult => ({
+  code: "ok",
+  models: [{ id, display_name: "Readable model" }],
+  has_more: false,
+});
+const props = () => ({
+  provider: "anthropic" as const,
+  baseUrl: "https://models.example.invalid",
+  apiKey: "synthetic-key", // pragma: allowlist secret
+  endpointReady: true,
+  disabled: false,
+  selectedModel: "hand-written-model",
+  onSelect: vi.fn(),
+});
+afterEach(cleanup);
+beforeEach(() => {
+  catalog.mockReset();
+  catalog.mockResolvedValue(result());
+});
+
+it("fetches independently and changes the model only when the user selects a candidate", async () => {
+  const p = props();
+  render(<ModelCatalogPicker {...p} />);
+  expect(catalog).not.toHaveBeenCalled();
+  fireEvent.click(screen.getByRole("button", { name: "获取模型列表" }));
+  const picker = await screen.findByLabelText("从模型列表选择");
+  expect(catalog).toHaveBeenCalledExactlyOnceWith(
+    {
+      provider_kind: "anthropic",
+      base_url: p.baseUrl,
+      api_key: p.apiKey,
+    },
+    expect.any(AbortSignal),
+  );
+  expect(p.onSelect).not.toHaveBeenCalled();
+  fireEvent.change(picker, { target: { value: "model-a" } });
+  expect(p.onSelect).toHaveBeenCalledExactlyOnceWith("model-a");
+  expect(catalog).toHaveBeenCalledTimes(1);
+  expect(screen.getByText(/列表仅供选择，测试通过后才会启用模型/)).toBeTruthy();
+});
+
+it.each([
+  { baseUrl: "https://other.example.invalid" },
+  { apiKey: "replacement-synthetic-key" }, // pragma: allowlist secret
+  { provider: "openai_compatible" as const },
+])(
+  "clears old candidates and discards a late response after input changes: %j",
+  async (change) => {
+    let finish!: (value: ModelCatalogResult) => void;
+    catalog.mockImplementationOnce(
+      () =>
+        new Promise((resolve) => {
+          finish = resolve;
+        }),
+    );
+    const p = props();
+    const view = render(<ModelCatalogPicker {...p} />);
+    fireEvent.click(screen.getByRole("button", { name: "获取模型列表" }));
+    const firstSignal = catalog.mock.calls[0][1];
+    view.rerender(<ModelCatalogPicker {...p} {...change} />);
+    expect(firstSignal?.aborted).toBe(true);
+    fireEvent.click(screen.getByRole("button", { name: "获取模型列表" }));
+    expect(
+      await screen.findByRole("option", { name: /Readable model · model-a/ }),
+    ).toBeTruthy();
+    await act(async () => finish(result("late-old-model")));
+    expect(screen.queryByRole("option", { name: /late-old-model/ })).toBeNull();
+    expect(screen.getByRole("option", { name: /model-a/ })).toBeTruthy();
+    expect(p.onSelect).not.toHaveBeenCalled();
+    view.rerender(
+      <ModelCatalogPicker {...p} {...change} apiKey="changed-again" />, // pragma: allowlist secret
+    );
+    expect(screen.queryByLabelText("从模型列表选择")).toBeNull();
+    expect(catalog).toHaveBeenCalledTimes(2);
+  },
+);
+
+it("auto-fetches a completed input once even after failure, while explicit refresh retries", async () => {
+  catalog.mockResolvedValue({
+    code: "unsupported",
+    models: [],
+    has_more: false,
+  });
+  const controls = createRef<ModelCatalogActions>();
+  render(<ModelCatalogPicker {...props()} controlsRef={controls} />);
+  await act(async () => controls.current?.loadIfNeeded());
+  expect(await screen.findByText(/这个服务暂不提供模型列表/)).toBeTruthy();
+  await act(async () => controls.current?.loadIfNeeded());
+  expect(catalog).toHaveBeenCalledTimes(1);
+  fireEvent.click(screen.getByRole("button", { name: "刷新模型列表" }));
+  await waitFor(() => expect(catalog).toHaveBeenCalledTimes(2));
+});
+
+it("uses only the supplied saved profile revision when the key is blank", async () => {
+  render(
+    <ModelCatalogPicker
+      {...props()}
+      apiKey=""
+      savedProfile={{ profile_id: "profile-1", revision: 4 }}
+    />,
+  );
+  fireEvent.click(screen.getByRole("button", { name: "获取模型列表" }));
+  await screen.findByLabelText("从模型列表选择");
+  expect(catalog.mock.calls[0][0]).toEqual({
+    provider_kind: "anthropic",
+    base_url: "https://models.example.invalid",
+    profile_id: "profile-1",
+    expected_profile_revision: 4,
+  });
+});
+
+it("does not request a catalog until an endpoint and credential are available", () => {
+  const controls = createRef<ModelCatalogActions>();
+  render(<ModelCatalogPicker {...props()} apiKey="" controlsRef={controls} />);
+  expect(screen.getByRole("button", { name: "获取模型列表" })).toHaveProperty(
+    "disabled",
+    true,
+  );
+  act(() => controls.current?.loadIfNeeded());
+  expect(catalog).not.toHaveBeenCalled();
+});
+
+it("keeps partial-list and request-error feedback free of provider diagnostic content", async () => {
+  catalog.mockResolvedValueOnce({ ...result(), has_more: true });
+  render(<ModelCatalogPicker {...props()} />);
+  fireEvent.click(screen.getByRole("button", { name: "获取模型列表" }));
+  expect(await screen.findByText(/列表尚未完整返回/)).toBeTruthy();
+  catalog.mockRejectedValueOnce(new Error("private-provider-diagnostics"));
+  fireEvent.click(screen.getByRole("button", { name: "刷新模型列表" }));
+  expect(await screen.findByText(/暂时无法获取模型列表/)).toBeTruthy();
+  expect(screen.queryByText(/private-provider-diagnostics/)).toBeNull();
+});
