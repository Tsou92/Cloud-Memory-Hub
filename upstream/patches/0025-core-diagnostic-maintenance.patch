+def core_diagnostic_maintenance(*, roots: tuple[Path, ...], detached_handlers=(), timeout: float = SHUTDOWN_DRAIN_SECONDS):
+    """Pause/join Core writers, then reuse the synchronous SDK file-handler gate.
