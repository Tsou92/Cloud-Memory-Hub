+            or any(not isinstance(root, Path) or not root.is_absolute() for root in roots)
+            or type(timeout) not in (int, float) or not 0 <= timeout <= 3600):
+        raise DiagnosticMaintenanceError("diagnostic_core_maintenance_invalid")
+    roots = tuple(Path(os.path.abspath(root)) for root in roots)
+    # Resource construction canonicalizes data_dir. Include aliases when pausing;
+    # the native gate/file inventory still validate the caller's original paths.
+    matching_roots = tuple(root.resolve() for root in roots)
+    if _configuration_lock._is_owned() or not _configuration_lock.acquire(False):
