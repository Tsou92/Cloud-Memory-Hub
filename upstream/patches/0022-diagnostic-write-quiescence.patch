+            async with quiesce_pipeline_logs([cache], timeout=0.02):
+                pytest.fail("SQLite's actual executor callable has not returned")
+        release.set()
+        async with quiesce_pipeline_logs([cache], timeout=2):
+            assert cache._conn.execute("SELECT count(*) FROM pipeline_logs_v2").fetchone()[0] == 1
+            cache._conn.execute("DELETE FROM pipeline_logs_v2 WHERE request_id='sql-target'")
+            cache._conn.commit()
+        await asyncio.sleep(0.03)
+        assert cache._conn.execute("SELECT count(*) FROM pipeline_logs_v2").fetchone()[0] == 0
+    finally:
+        release.set()
+        await until(lambda: cache._pipeline_log_work_group.snapshot()["pending"] == 0)
+        await cache.close()
+        pool.shutdown()
+
