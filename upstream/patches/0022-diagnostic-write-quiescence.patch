+"""Real final-I/O barriers, cancellation, cross-loop dispatch and close retry."""
+
+import asyncio
+import gc
+import threading
+from concurrent.futures import ThreadPoolExecutor
+from types import SimpleNamespace
+
+import pytest
+from hy_memory import HyMemoryClient, MemoryConfig, SharedRuntime
+from hy_memory.data import cache_sqlite
+from hy_memory.data.cache_sqlite import SqliteCache
+from hy_memory.metrics import MetricsCollector
+from hy_memory.utils import pipeline_observability as observability
+from hy_memory.utils.pipeline_log_lifecycle import (
+    PipelineLogDrainTimeout,
+    PipelineLogDrainUnavailable,
+    PipelineLogQuiescenceUnsupported,
+    PipelineLogWorkGroup,
+    quiesce_pipeline_logs,
+)
+from hy_memory.utils.pipeline_log_writer import PipelineLogWriter
+
+
+async def until(predicate):
+    async with asyncio.timeout(3):
+        while not predicate():
+            await asyncio.sleep(0.005)
+
+
+def config(tmp_path):
+    return MemoryConfig.from_dict({
+        "cache": {"backend": "sqlite", "sqlite_path": str(tmp_path / "cache.db")},
+        "history": {"enable": False},
+    })
+
+
+@pytest.fixture(autouse=True)
+def isolated_environment(monkeypatch, tmp_path):
+    monkeypatch.setenv("MEMORY_DATA_DIR", str(tmp_path))
+    monkeypatch.setenv("MEMORY_LOG_DIR", str(tmp_path / "logs"))
+    monkeypatch.setenv("MEMORY_LOG_LLM_CONTENT", "true")
+    monkeypatch.setenv("MEMORY_PIPELINE_TRACE_ENABLED", "true")
+    monkeypatch.setenv("MEMORY_PIPELINE_TRACE_TIMEOUT_SECONDS", "0.05")
+    MetricsCollector.reset()
+    yield
+    MetricsCollector.reset()
+
+
+async def cache_for(tmp_path):
+    cache = SqliteCache(config(tmp_path))
+    await cache.initialize()
+    observability.install_pipeline_observability(cache)
+    return cache
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("raise_after", [False, True])
+async def test_cancelled_jsonl_waits_for_real_thread_and_consumes_late_failure(
+    tmp_path, monkeypatch, raise_after,
+):
+    entered, release = threading.Event(), threading.Event()
+    native = PipelineLogWriter.write_step
+
+    def blocked(self, **kwargs):
+        entered.set()
+        assert release.wait(3)
+        native(self, **kwargs)
+        if raise_after:
+            raise RuntimeError("synthetic-thread-error-must-not-log-late")
+
+    monkeypatch.setattr(PipelineLogWriter, "write_step", blocked)
+    cache = await cache_for(tmp_path)
+    loop = asyncio.get_running_loop()
+    errors = []
+    old_handler = loop.get_exception_handler()
+    loop.set_exception_handler(lambda _loop, context: errors.append(context))
+    try:
+        assert await cache.store_pipeline_log(request_id="jsonl-target", prompt="synthetic-body")
+        await until(entered.is_set)
+        tasks = [t for t in observability._pending_log_tasks if t.get_coro().__name__ == "_persist_jsonl"]
+        for task in tasks:
+            task.cancel()
+            task.cancel()
+        await asyncio.gather(*tasks, return_exceptions=True)
+        with pytest.raises(PipelineLogDrainTimeout, match="^pipeline_log_drain_timeout$"):
+            async with quiesce_pipeline_logs([cache], timeout=0.02):
+                pytest.fail("real I/O is still blocked")
+        assert cache._pipeline_log_work_group.snapshot()["pending"] > 0
+        assert not cache._pipeline_log_work_group.snapshot()["paused"]
+        release.set()
+        async with quiesce_pipeline_logs([cache], timeout=2):
+            assert cache._pipeline_log_work_group.snapshot()["pending"] == 0
+            assert not await cache.store_pipeline_log(request_id="suppressed", prompt="must-not-buffer")
+            files = list((tmp_path / "logs").rglob("*.log"))
+            assert any("synthetic-body" in path.read_text() for path in files)
+            for path in files:
+                assert "must-not-buffer" not in path.read_text()
+                path.write_text("")
+        del tasks
+        gc.collect()
+        await asyncio.sleep(0.03)
+        assert not errors
+        assert all(not path.read_text() for path in files)
+    finally:
+        release.set()
+        await until(lambda: cache._pipeline_log_work_group.snapshot()["pending"] == 0)
+        await cache.close()
+        loop.set_exception_handler(old_handler)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("cancel", [False, True])
+async def test_native_sqlite_thread_outlives_trace_timeout_or_cancel(tmp_path, monkeypatch, cancel):
+    cache = await cache_for(tmp_path)
+    entered, release = threading.Event(), threading.Event()
+    pool = ThreadPoolExecutor(max_workers=1)
+
+    class BlockInsert:
+        def submit(self, function):
+            def execute():
+                if getattr(function, "__name__", "") == "_insert":
+                    entered.set()
+                    assert release.wait(3)
+                return function()
+            return pool.submit(execute)
+
+    monkeypatch.setattr(cache_sqlite, "_sqlite_executor", BlockInsert())
+    try:
+        await cache.store_pipeline_log(request_id="sql-target", prompt="synthetic-sql-body")
+        await until(entered.is_set)
+        if cancel:
+            tasks = [t for t in observability._pending_log_tasks if t.get_coro().__name__ == "_persist_trace"]
+            for task in tasks:
+                task.cancel()
+            await asyncio.gather(*tasks, return_exceptions=True)
+        else:
+            await asyncio.sleep(0.08)  # Real wrapper's 50ms wait_for has expired.
