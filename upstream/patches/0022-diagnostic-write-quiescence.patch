+async def test_pause_leases_nest_rollback_and_do_not_accept_missing_wrappers(monkeypatch):
+    first, second = PipelineLogWorkGroup(), PipelineLogWorkGroup()
+    a, b = cache_with_group(first), cache_with_group(second)
+    async with quiesce_pipeline_logs([a, a]):
