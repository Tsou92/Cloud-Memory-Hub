+            assert not await a.store_pipeline_log()
+        assert first.snapshot()["paused"]
+    assert await a.store_pipeline_log()
+    with pytest.raises(PipelineLogQuiescenceUnsupported):
+        async with quiesce_pipeline_logs([a, SimpleNamespace()]):
+            pass
+    assert not first.snapshot()["paused"]
