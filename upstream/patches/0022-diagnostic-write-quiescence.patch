+@pytest.mark.asyncio
+async def test_cross_loop_trace_is_part_of_quiescence(tmp_path, monkeypatch):
+    monkeypatch.setenv("MEMORY_PIPELINE_TRACE_TIMEOUT_SECONDS", "2")
+    owner = asyncio.new_event_loop()
+    thread = threading.Thread(target=owner.run_forever)
+    thread.start()
+    entered, release = threading.Event(), threading.Event()
+    rows = []
+
+    async def store(**kwargs):
+        entered.set()
+        while not release.is_set():
+            await asyncio.sleep(0.005)
+        rows.append(kwargs["request_id"])
+
+    wrapped = observability.wrap_store_pipeline_log(
+        store, log_writer=PipelineLogWriter(str(tmp_path / "logs")),
+        trace_enabled=True, owner_loop=owner,
+    )
+    cache = SimpleNamespace(store_pipeline_log=wrapped, _pipeline_log_work_group=wrapped.work_group)
+    try:
+        await wrapped(request_id="cross-loop")
+        await until(entered.is_set)
+        with pytest.raises(PipelineLogDrainTimeout):
+            async with quiesce_pipeline_logs([cache], timeout=0.02):
+                pytest.fail("owner-loop task is not finished")
+        release.set()
+        async with quiesce_pipeline_logs([cache], timeout=2):
+            assert rows == ["cross-loop"]
+    finally:
+        release.set()
+        await until(lambda: wrapped.work_group.snapshot()["pending"] == 0)
+        owner.call_soon_threadsafe(owner.stop)
+        thread.join(3)
+        owner.close()
+
+
+def cache_with_group(group):
+    async def store(**kwargs):
+        return True
+    wrapper = group.admitted(store)
+    wrapper.work_group = group
+    return SimpleNamespace(store_pipeline_log=wrapper, _pipeline_log_work_group=group)
