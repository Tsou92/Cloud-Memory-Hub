+@pytest.mark.asyncio
+async def test_enqueue_pause_race_never_loses_admitted_work():
+    for _ in range(20):
+        group = PipelineLogWorkGroup()
+        barrier = threading.Barrier(2)
+        release = threading.Event()
+        entered = threading.Event()
+        results = []
+
+        @group.admitted
+        async def call(entered=entered, release=release):
+            entered.set()
+            while not release.is_set():
+                await asyncio.sleep(0.001)
+            return True
+
+        def producer(barrier=barrier, results=results, call=call):
+            barrier.wait()
+            results.append(asyncio.run(call()))
+
+        thread = threading.Thread(target=producer)
+        thread.start()
+        barrier.wait()
+        lease = group.pause()
+        # An admitted request remains counted; a rejected request never runs.
+        await until(lambda entered=entered, results=results: entered.is_set() or bool(results))
+        assert group.snapshot()["pending"] == (1 if entered.is_set() else 0)
+        assert not await call()
+        release.set()
+        await asyncio.to_thread(thread.join, 2)
+        assert not thread.is_alive()
+        assert group.snapshot()["pending"] == 0
+        group.resume(lease)
