--- /dev/null
+++ b/hy_memory/utils/pipeline_log_lifecycle.py
@@ -0,0 +1,262 @@
+"""Quiescence of diagnostic work, independent of request outcome evidence.
+
+Groups own scheduling tickets and actual executor completions.  They do not
+record log contents and do not prove that an attempted log was persisted.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import concurrent.futures
+import functools
+import math
+import threading
+import time
+from contextlib import asynccontextmanager
+from contextvars import ContextVar
+
+
+class PipelineLogDrainTimeout(RuntimeError):
+    def __init__(self):
+        super().__init__("pipeline_log_drain_timeout")
+
+
+class PipelineLogDrainUnavailable(RuntimeError):
+    def __init__(self):
+        super().__init__("pipeline_log_drain_unavailable")
+
+
+class PipelineLogQuiescenceUnsupported(RuntimeError):
+    def __init__(self):
+        super().__init__("pipeline_log_quiescence_unsupported")
+
+
+_CURRENT: ContextVar[PipelineLogWorkGroup | None] = ContextVar(
+    "pipeline_log_work_group", default=None,
+)
+
+
+def current_work_group():
+    return _CURRENT.get()
+
+
+class _Ticket:
+    def __init__(self, group, loop):
+        self.group = group
+        self.loop = loop
+
+    def finish(self, _future=None):
+        with self.group._lock:
+            self.group._pending.discard(self)
+
+
+class PipelineLogWorkGroup:
+    def __init__(self):
+        self._lock = threading.RLock()
+        self._pending = set()
+        self._leases = set()
+        self._sealed = False
+        self._suppressed = 0
+
+    def reserve(self, *, loop=None):
+        """Register already-admitted descendants even while admission is paused."""
+        with self._lock:
+            ticket = _Ticket(self, loop)
+            self._pending.add(ticket)
+            return ticket
+
+    def _admit(self):
+        with self._lock:
+            if self._sealed or self._leases:
+                self._suppressed += 1
+                return None
+            return self.reserve(loop=asyncio.get_running_loop())
+
+    def admitted(self, method):
+        @functools.wraps(method)
+        async def wrapped(*args, **kwargs):
+            ticket = self._admit()
+            if ticket is None:
+                return False
+            token = _CURRENT.set(self)
+            try:
+                return await method(*args, **kwargs)
+            finally:
+                _CURRENT.reset(token)
+                ticket.finish()
+        return wrapped
+
+    def pause(self):
+        with self._lock:
+            lease = object()
+            self._leases.add(lease)
+            return lease
+
+    def resume(self, lease):
+        with self._lock:
+            self._leases.discard(lease)
+
+    def seal(self):
+        """Permanently reject new enqueues once resource shutdown has begun."""
+        with self._lock:
+            self._sealed = True
+
+    def snapshot(self):
+        with self._lock:
+            return {
+                "pending": len(self._pending),
+                "paused": bool(self._leases),
+                "sealed": self._sealed,
+                "suppressed": self._suppressed,
+            }
+
+    def pending(self):
+        with self._lock:
+            for ticket in self._pending:
+                if ticket.loop is not None and (
+                    ticket.loop.is_closed() or not ticket.loop.is_running()
+                ):
+                    raise PipelineLogDrainUnavailable()
+            return bool(self._pending)
+
+    def uses_loop(self, loop):
+        with self._lock:
+            return any(ticket.loop is loop for ticket in self._pending)
+
+    def dispatch(self, coroutine, loop, *, track_task, on_done=lambda: None):
+        """Register before dispatch; only the owner Task can finish its ticket."""
+        ticket = self.reserve(loop=loop)
+
+        def finish(_task=None):
+            try:
+                on_done()
+            finally:
+                ticket.finish()
+
+        def start():
+            try:
+                task = loop.create_task(coroutine)
+            except BaseException:  # noqa: BLE001 -- task creation failed before any work ran
+                coroutine.close()
+                finish()
+                return
+            # The existing exception-consuming callback may emit a text log.
+            # Its callback runs first, before the quiescence ticket is released.
+            track_task(task)
+            task.add_done_callback(finish)
+
+        try:
+            if loop is asyncio.get_running_loop():
+                start()
+            else:
+                loop.call_soon_threadsafe(start)
+        except BaseException:
+            coroutine.close()
+            finish()
+            raise
+
+
+def work_groups(caches):
+    groups = []
+    for cache in caches:
+        group = getattr(cache, "_pipeline_log_work_group", None)
+        wrapper_group = getattr(getattr(cache, "store_pipeline_log", None), "work_group", None)
+        if not isinstance(group, PipelineLogWorkGroup) or wrapper_group is not group:
+            raise PipelineLogQuiescenceUnsupported()
+        if group not in groups:
+            groups.append(group)
+    return groups
+
+
+def require_sync_drain_safe(caches):
+    """A synchronous caller cannot block the loop needed to finish its logs."""
+    try:
+        loop = asyncio.get_running_loop()
+    except RuntimeError:
+        return
+    if any(group.uses_loop(loop) for group in work_groups(caches)):
+        raise RuntimeError("pipeline_log_sync_drain_requires_async")
+
+
+async def _drain(groups, timeout):
+    if timeout is not None and (not math.isfinite(timeout) or timeout < 0):
+        raise ValueError("invalid_pipeline_log_drain_timeout")
+    deadline = None if timeout is None else time.monotonic() + timeout
+    while any(group.pending() for group in groups):
+        if deadline is not None and time.monotonic() >= deadline:
+            raise PipelineLogDrainTimeout()
+        await asyncio.sleep(0.01)
+
+
+async def run_on_loop_joined(coroutine, loop):
+    """Cancel on the owner loop, but await its actual Task's termination."""
+    if loop is asyncio.get_running_loop():
+        return await coroutine
+    completed = concurrent.futures.Future()
+    cancellation = threading.Event()
+    task_ref = []
+
+    def finished(task):
+        try:
+            completed.set_result(task.result())
+        except BaseException as error:  # noqa: BLE001 -- forward the exact task termination
+            completed.set_exception(error)
+
+    def start():
+        try:
+            task = loop.create_task(coroutine)
+        except BaseException as error:  # noqa: BLE001 -- forward dispatch failure to the waiter
+            coroutine.close()
+            completed.set_exception(error)
+            return
+        task_ref.append(task)
+        task.add_done_callback(finished)
+        if cancellation.is_set():
+            task.cancel()
+
+    def cancel():
+        if task_ref:
+            task_ref[0].cancel()
+
+    try:
+        loop.call_soon_threadsafe(start)
+    except BaseException:
+        coroutine.close()
+        raise
+    wrapped = asyncio.wrap_future(completed)
+    interrupted = None
+    while not wrapped.done():
+        try:
+            await asyncio.wait((wrapped,), timeout=0.05)
+            if not wrapped.done() and (loop.is_closed() or not loop.is_running()):
+                raise PipelineLogDrainUnavailable() from None
+        except asyncio.CancelledError as error:
+            if interrupted is None:
+                interrupted = error
+                cancellation.set()
+                loop.call_soon_threadsafe(cancel)
+    if interrupted is not None:
+        if wrapped.done() and not wrapped.cancelled():
+            wrapped.exception()
+        raise interrupted
+    return wrapped.result()
+
+
+@asynccontextmanager
+async def quiesce_pipeline_logs(caches, *, timeout=None):
+    """Pause every cache before waiting; retain all work on failure/cancellation.
+
+    The caller must first exclude foreground SDK reads/writes and cache creation.
+    No registry, native-store or logging-handler lock may be held while awaiting.
+    """
+    groups = work_groups(caches)
+    leases = []
+    try:
+        for group in groups:
+            leases.append((group, group.pause()))
+        await _drain(groups, timeout)
+        yield
+        await _drain(groups, timeout)
+    finally:
+        for group, lease in reversed(leases):
+            group.resume(lease)
