+++ b/memhub/apps/web/src/HubBackups.tsx
@@ -0,0 +1,401 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import {
+  BackupControlError,
+  type BackupSchedule,
+  type BackupStatus,
+  type BackupVersion,
+  backupErrorMessage,
+  getBackupStatus,
+  getBackupVersions,
+  requestBackup,
+  saveBackupSchedule,
+} from "./hub-backups";
+import { R6Button, R6Field, R6Switch } from "./R6Controls";
+
+const stateLabels = {
+  not_run: "尚未运行",
+  running: "正在备份",
+  completed: "最近一次备份生成完成",
+  failed: "最近一次备份失败",
+  interrupted: "最近一次备份中断",
+};
+function date(value?: string | null) {
+  return value ? new Date(value).toLocaleString() : "暂无记录";
+}
+function formFor(plan: BackupSchedule) {
+  return {
+    enabled: plan.enabled,
+    interval: String(plan.interval_minutes ?? 1440),
+    keep: String(plan.keep ?? 7),
+  };
+}
+
+export function HubBackups({ active = true }: { active?: boolean }) {
+  const [status, setStatus] = useState<BackupStatus | null>(null);
+  const [versions, setVersions] = useState<BackupVersion[] | null>(null);
+  const [statusError, setStatusError] = useState("");
+  const [versionsError, setVersionsError] = useState("");
+  const [statusLoading, setStatusLoading] = useState(false);
+  const [versionsLoading, setVersionsLoading] = useState(false);
+  const [form, setForm] = useState(() =>
+    formFor({ schema_version: 1, enabled: false }),
+  );
+  const [dirty, setDirty] = useState(false);
+  const [writing, setWriting] = useState<"schedule" | "request" | null>(null);
+  const [unknown, setUnknown] = useState<"schedule" | "request" | null>(null);
+  const [message, setMessage] = useState("");
+  const [actionError, setActionError] = useState("");
+  const dirtyRef = useRef(false);
+  const writeBusy = useRef(false);
+  const statusBusy = useRef(false);
+  const versionsBusy = useRef(false);
+  const statusEpoch = useRef(0);
+  const statusAbort = useRef<AbortController | null>(null);
+  const versionsAbort = useRef<AbortController | null>(null);
+  const completedSeen = useRef<string | null>(null);
+  const pendingVersionRefresh = useRef(false);
+  const activeRef = useRef(active);
+
+  const refreshVersions = useCallback(async () => {
+    if (versionsBusy.current) {
+      pendingVersionRefresh.current = true;
+      return;
+    }
+    versionsBusy.current = true;
+    setVersionsLoading(true);
+    try {
+      do {
+        pendingVersionRefresh.current = false;
+        const controller = new AbortController();
+        versionsAbort.current = controller;
+        try {
+          const next = await getBackupVersions(controller.signal);
+          if (!controller.signal.aborted) {
+            setVersions(next);
+            setVersionsError("");
+          }
+        } catch (error) {
+          if (!controller.signal.aborted)
+            setVersionsError(backupErrorMessage(error));
+        }
+      } while (pendingVersionRefresh.current && activeRef.current);
+    } finally {
+      versionsBusy.current = false;
+      setVersionsLoading(false);
+    }
+  }, []);
+
+  const refreshStatus = useCallback(
+    async (manual = false) => {
+      if (statusBusy.current || writeBusy.current) return;
+      statusBusy.current = true;
+      setStatusLoading(true);
+      const epoch = ++statusEpoch.current;
+      const controller = new AbortController();
+      statusAbort.current = controller;
+      try {
+        const next = await getBackupStatus(controller.signal);
+        if (controller.signal.aborted || epoch !== statusEpoch.current) return;
+        setStatus(next);
+        setStatusError("");
+        if (!dirtyRef.current) setForm(formFor(next.schedule));
+        if (manual) {
+          setUnknown(null);
+          setActionError("");
+        }
+        if (
+          next.execution.state === "completed" &&
+          next.execution.last_backup_id &&
+          completedSeen.current !== next.execution.last_backup_id
+        ) {
+          completedSeen.current = next.execution.last_backup_id;
+          void refreshVersions();
+        }
+      } catch (error) {
+        if (!controller.signal.aborted && epoch === statusEpoch.current)
+          setStatusError(backupErrorMessage(error));
+      } finally {
+        statusBusy.current = false;
+        setStatusLoading(false);
+      }
+    },
+    [refreshVersions],
+  );
+
+  useEffect(() => {
+    activeRef.current = active;
+    if (!active) return;
+    void refreshStatus();
+    const timer = window.setInterval(() => {
+      void refreshStatus();
+    }, 10000);
+    return () => {
+      activeRef.current = false;
+      window.clearInterval(timer);
+      statusAbort.current?.abort();
+      versionsAbort.current?.abort();
+    };
+  }, [active, refreshStatus]);
+
+  function edit(changes: Partial<typeof form>) {
+    dirtyRef.current = true;
+    setDirty(true);
+    setForm((current) => ({ ...current, ...changes }));
+  }
+  function begin(kind: "schedule" | "request") {
+    if (writeBusy.current || unknown || !status || statusError) return false;
+    writeBusy.current = true;
+    statusEpoch.current++;
+    setWriting(kind);
+    setMessage("");
+    setActionError("");
+    return true;
+  }
+  function failed(error: unknown, kind: "schedule" | "request") {
+    setActionError(backupErrorMessage(error));
+    if (!(error instanceof BackupControlError) || error.outcomeUnknown)
+      setUnknown(kind);
+  }
+  async function save() {
+    const interval = Number(form.interval),
+      keep = Number(form.keep);
+    if (
+      !Number.isInteger(interval) ||
+      interval < 1 ||
+      interval > 525600 ||
+      !Number.isInteger(keep) ||
+      keep < 1 ||
+      keep > 365
+    ) {
+      setActionError("周期须为 1–525600 分钟，保留数量须为 1–365 个整数。");
+      return;
+    }
+    if (!begin("schedule")) return;
+    try {
+      const plan = await saveBackupSchedule({
+        enabled: form.enabled,
+        interval_minutes: interval,
+        keep,
+      });
+      dirtyRef.current = false;
+      setDirty(false);
+      setForm(formFor(plan));
+      setStatus((current) =>
+        current ? { ...current, schedule: plan, next_due_at: null } : current,
+      );
+      setMessage("备份计划已保存。调度器是否正在运行仍需由服务实际执行确认。");
+    } catch (error) {
+      failed(error, "schedule");
+    } finally {
+      writeBusy.current = false;
+      setWriting(null);
+    }
+  }
+  async function request() {
+    if (!begin("request")) return;
+    try {
+      const queued = await requestBackup();
+      setStatus((current) =>
+        current ? { ...current, pending_request: queued.request_id } : current,
+      );
+      setMessage("备份请求已排队，尚未确认开始或完成。请等待状态更新。");
+    } catch (error) {
+      failed(error, "request");
+    } finally {
+      writeBusy.current = false;
+      setWriting(null);
+    }
+  }
+  const disabled =
+    !status || Boolean(statusError) || writing !== null || unknown !== null;
+
+  return (
+    <div>
+      <p>
+        备份时记忆服务会短暂停止，客户端待传内容会保留并稍后补传。备份包含原文、模型密钥和设备配置，请私有保存；独立备份卷不等于异机备份。
+      </p>
+      <div className="r6-setting-row">
+        <div>
+          <h3>备份状态</h3>
+          <p>
+            {status ? stateLabels[status.execution.state] : "尚未读到备份状态"}
+            {statusError && status ? "（上次确认，可能已过时）" : ""}
+          </p>
+          {status && (
+            <>
+              <p>最近成功：{date(status.execution.last_success_at)}</p>
+              <p>
+                下次计划：
+                {status.schedule.enabled
+                  ? status.next_due_at
+                    ? date(status.next_due_at)
+                    : "等待刷新确认"
+                  : "定期备份未启用"}
+              </p>
+              {status.pending_request && (
+                <p>有备份请求等待处理；排队不代表已开始或完成。</p>
+              )}
+              {status.execution.error && (
+                <p>最近执行未能完成，请核对 NAS 服务和备份存储后重新请求。</p>
+              )}
+              {status.execution.retention_error && (
+                <p>备份已保留，但旧版本清理未完成，请检查存储状态。</p>
+              )}
+              <p>调度器在线状态尚未核实。</p>
+            </>
+          )}
+          {statusError && (
+            <p role="alert" className="r6-settings-error">
+              {statusError}
+            </p>
+          )}
+        </div>
+        <R6Button
+          pending={statusLoading}
+          disabled={writing !== null}
+          onClick={() => void refreshStatus(true)}
+        >
+          刷新备份状态
+        </R6Button>
+      </div>
+      <form
+        onSubmit={(event) => {
+          event.preventDefault();
+          void save();
+        }}
+      >
+        <div className="r6-setting-row">
+          <div>
+            <h3>定期备份</h3>
+            <p>按设定周期生成完整版本，仅清理经过校验的旧版本。</p>
+          </div>
+          <R6Switch
+            label="启用定期备份"
+            checked={form.enabled}
+            disabled={disabled}
+            onCheckedChange={(enabled) => edit({ enabled })}
+          />
+        </div>
+        <div className="r6-model-actions">
+          <R6Field
+            label="备份周期（分钟）"
+            type="number"
+            min={1}
+            max={525600}
+            step={1}
+            required
+            value={form.interval}
+            disabled={disabled}
+            onChange={(event) => edit({ interval: event.target.value })}
+          />
+          <R6Field
+            label="保留版本数量"
+            type="number"
+            min={1}
+            max={365}
+            step={1}
+            required
+            value={form.keep}
+            disabled={disabled}
+            onChange={(event) => edit({ keep: event.target.value })}
+          />
+        </div>
+        <p>
+          {dirty
+            ? "有尚未保存的修改，刷新不会覆盖当前表单。"
+            : "表单显示最近确认的计划。"}
+        </p>
+        <R6Button
+          type="submit"
+          variant="primary"
+          disabled={disabled || !dirty}
+          pending={writing === "schedule"}
+        >
+          保存备份计划
+        </R6Button>
+      </form>
+      <div className="r6-setting-row">
+        <div>
+          <h3>手动备份</h3>
+          <p>提交一次备份请求，由后台调度器处理；执行期间服务会短暂停止。</p>
+        </div>
+        <R6Button
+          disabled={
+            disabled ||
+            Boolean(status?.pending_request) ||
+            status?.execution.state === "running"
+          }
+          pending={writing === "request"}
+          onClick={() => void request()}
+        >
+          请求一次备份
+        </R6Button>
+      </div>
+      {message && <p role="status">{message}</p>}
+      {actionError && (
+        <p role="alert" className="r6-settings-error">
+          {actionError}
+        </p>
+      )}
+      {unknown && (
+        <p role="alert">
+          {unknown === "request" ? "备份请求" : "计划保存"}
+          结果未知，可能已写入。请先点击“刷新备份状态”核对；刷新成功后才能显式重新提交，不会自动重发。
+        </p>
+      )}
+      <div className="r6-setting-row">
+        <div>
+          <h3>历史版本</h3>
+          <p>
+            列表只读取有界清单摘要，未经重新校验，不代表当前文件完整或可恢复。恢复前仍须完整校验；不会自动下载敏感备份。
+          </p>
+        </div>
+        <R6Button
+          pending={versionsLoading}
+          onClick={() => void refreshVersions()}
+        >
+          刷新版本列表
+        </R6Button>
+      </div>
+      {versionsError && (
+        <p role="alert" className="r6-settings-error">
+          {versionsError}
+          {versions !== null
+            ? " 列表为上次确认结果，可能已过时。"
+            : " 尚未取得版本列表。"}
+        </p>
+      )}
+      {versions === null ? (
+        <p>尚未加载版本列表。</p>
+      ) : versions.length === 0 ? (
+        <p>
+          {versionsError ? "上次读取时未发现备份清单。" : "尚未发现备份清单。"}
+        </p>
+      ) : (
+        <ul aria-label="备份历史版本">
+          {versions.map((version) => (
+            <li key={version.backup_id}>
+              <p>
+                <strong>已生成，恢复前完整校验</strong> ·{" "}
+                {date(version.created_at)}
+              </p>
+              <p>
+                版本 {version.backup_id} · 清单声明 {version.file_count} 个文件
+                · {(version.total_bytes / 1024 / 1024).toFixed(1)} MiB · 构建{" "}
+                {version.revision}
+              </p>
+            </li>
+          ))}
+        </ul>
+      )}
+      <div className="r6-setting-row">
+        <div>
+          <h3>恢复与完整导出</h3>
+          <p>
+            网页恢复和完整导出入口尚未完成。此页面只管理备份计划、排队请求和查看版本，不提供恢复操作。
+          </p>
+        </div>
+      </div>
+    </div>
+  );
+}
