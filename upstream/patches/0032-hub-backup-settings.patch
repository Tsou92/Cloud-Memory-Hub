@@ -0,0 +1,320 @@
+// @vitest-environment jsdom
+import {
+  act,
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { HubBackups } from "./HubBackups";
+import type { BackupStatus } from "./hub-backups";
+
+const id = "11111111-1111-4111-8111-111111111111";
+const versionId =
+  "cmh-backup-20261110T120000000000Z-11111111111111111111111111111111";
+const timestamp = "2026-11-10T12:00:00+00:00";
+let state: BackupStatus;
+let versions: unknown[];
+let fetcher: ReturnType<typeof vi.fn>;
+let requestFailure: "none" | "lost" | "forbidden";
+let statusFailure: boolean;
+let versionFailure: boolean;
+const requests = (path: string, method?: string) =>
+  fetcher.mock.calls.filter(
+    ([url, init]) =>
+      String(url).endsWith(path) && (!method || init.method === method),
+  );
+
+beforeEach(() => {
+  state = {
+    schedule: {
+      schema_version: 1,
+      enabled: true,
+      interval_minutes: 1440,
+      keep: 7,
+      configured_at: timestamp,
+    },
+    execution: { schema_version: 1, state: "not_run" },
+    next_due_at: timestamp,
+    pending_request: null,
+    supervisor_running: "not_checked",
+  };
+  versions = [];
+  requestFailure = "none";
+  statusFailure = false;
+  versionFailure = false;
+  fetcher = vi
+    .fn()
+    .mockImplementation(async (url: string, init: RequestInit) => {
+      if (url.endsWith("status"))
+        return Response.json(
+          statusFailure ? { detail: "backup_control_unavailable" } : state,
+          { status: statusFailure ? 503 : 200 },
+        );
+      if (url.endsWith("versions"))
+        return Response.json(
+          versionFailure ? { detail: "backup_storage_in_use" } : { versions },
+          { status: versionFailure ? 503 : 200 },
+        );
+      if (url.endsWith("schedule")) {
+        state = {
+          ...state,
+          schedule: {
+            schema_version: 1,
+            ...JSON.parse(String(init.body)),
+            configured_at: timestamp,
+          },
+        };
+        if (requestFailure === "lost")
+          throw new TypeError("synthetic lost write");
+        return Response.json(state.schedule);
+      }
+      if (url.endsWith("request")) {
+        if (requestFailure === "forbidden")
+          return Response.json(
+            { detail: "administrator_required" },
+            { status: 403 },
+          );
+        if (requestFailure === "lost")
+          throw new TypeError("synthetic lost request");
+        state = { ...state, pending_request: id };
+        return Response.json(
+          {
+            status: "queued",
+            schema_version: 1,
+            request_id: id,
+            requested_at: timestamp,
+          },
+          { status: 202 },
+        );
+      }
+      throw new Error("unexpected synthetic route");
+    });
+  vi.stubGlobal("fetch", fetcher);
+});
+afterEach(() => {
+  cleanup();
+  vi.useRealTimers();
+  vi.unstubAllGlobals();
+});
+
+async function ready() {
+  await waitFor(() =>
+    expect(
+      (
+        screen.getByRole("button", {
+          name: "请求一次备份",
+        }) as HTMLButtonElement
+      ).disabled,
+    ).toBe(false),
+  );
+}
+
+it("saves actual plan edits and sends exactly one queued-only request", async () => {
+  const user = userEvent.setup();
+  render(<HubBackups />);
+  await ready();
+  expect(screen.getByText(/备份时记忆服务会短暂停止/)).toBeTruthy();
+  expect(screen.getByText(/网页恢复和完整导出入口尚未完成/)).toBeTruthy();
+  expect(screen.queryByRole("button", { name: "恢复" })).toBeNull();
+  await user.clear(screen.getByLabelText("备份周期（分钟）"));
+  await user.type(screen.getByLabelText("备份周期（分钟）"), "60");
+  await user.click(screen.getByRole("switch", { name: "启用定期备份" }));
+  await user.click(screen.getByRole("button", { name: "保存备份计划" }));
+  expect(await screen.findByText(/备份计划已保存/)).toBeTruthy();
+  expect(JSON.parse(requests("schedule", "PUT")[0][1].body)).toEqual({
+    enabled: false,
+    interval_minutes: 60,
+    keep: 7,
+  });
+  await user.click(screen.getByRole("button", { name: "请求一次备份" }));
+  expect(
+    await screen.findByText(/备份请求已排队，尚未确认开始或完成/),
+  ).toBeTruthy();
+  expect(requests("request", "POST")).toHaveLength(1);
+  expect(
+    (screen.getByRole("button", { name: "请求一次备份" }) as HTMLButtonElement)
+      .disabled,
+  ).toBe(true);
+  expect(screen.queryByText("最近一次备份生成完成")).toBeNull();
+  expect(localStorage.length).toBe(0);
+});
+
+it("does not overwrite unsaved fields on status refresh", async () => {
+  const user = userEvent.setup();
+  render(<HubBackups />);
+  await ready();
+  await user.clear(screen.getByLabelText("保留版本数量"));
+  await user.type(screen.getByLabelText("保留版本数量"), "12");
+  state = { ...state, schedule: { ...state.schedule, keep: 2 } };
+  await user.click(screen.getByRole("button", { name: "刷新备份状态" }));
+  await waitFor(() => expect(requests("status")).toHaveLength(2));
+  expect(
+    (screen.getByLabelText("保留版本数量") as HTMLInputElement).value,
+  ).toBe("12");
+  expect(screen.getByText(/有尚未保存的修改/)).toBeTruthy();
+});
+
+it("keeps confirmed status and versions marked stale after a 503", async () => {
+  versions = [
+    {
+      backup_id: versionId,
+      state: "unverified",
+      created_at: timestamp,
+      revision: "synthetic-1",
+      file_count: 10,
+      total_bytes: 100,
+    },
+  ];
+  const user = userEvent.setup();
+  render(<HubBackups />);
+  await ready();
+  await user.click(screen.getByRole("button", { name: "刷新版本列表" }));
+  expect(await screen.findByText("已生成，恢复前完整校验")).toBeTruthy();
+  expect(
+    screen.getByText(/未经重新校验，不代表当前文件完整或可恢复/),
+  ).toBeTruthy();
+  expect(screen.queryByText("已校验")).toBeNull();
+  statusFailure = true;
+  versionFailure = true;
+  await user.click(screen.getByRole("button", { name: "刷新备份状态" }));
+  await user.click(screen.getByRole("button", { name: "刷新版本列表" }));
+  expect(await screen.findByText(/上次确认，可能已过时/)).toBeTruthy();
+  expect(
+    await screen.findByText(/列表为上次确认结果，可能已过时/),
+  ).toBeTruthy();
+  expect(screen.getByText("已生成，恢复前完整校验")).toBeTruthy();
+  expect(screen.queryByText("尚未发现备份清单。")).toBeNull();
+  expect(
+    (screen.getByRole("button", { name: "请求一次备份" }) as HTMLButtonElement)
+      .disabled,
+  ).toBe(true);
+});
+
+it("does not turn an initial unavailable version list into no backups", async () => {
+  versionFailure = true;
+  render(<HubBackups />);
+  await ready();
+  await userEvent.click(screen.getByRole("button", { name: "刷新版本列表" }));
+  expect(await screen.findByText(/尚未取得版本列表/)).toBeTruthy();
+  expect(screen.queryByText("尚未发现备份清单。")).toBeNull();
+});
+
+it("requires explicit status refresh and a new click after an unknown request", async () => {
+  const user = userEvent.setup();
+  render(<HubBackups />);
+  await ready();
+  requestFailure = "lost";
+  await user.click(screen.getByRole("button", { name: "请求一次备份" }));
+  expect(await screen.findByText(/备份请求结果未知/)).toBeTruthy();
+  expect(requests("request", "POST")).toHaveLength(1);
+  expect(
+    (screen.getByRole("button", { name: "请求一次备份" }) as HTMLButtonElement)
+      .disabled,
+  ).toBe(true);
+  requestFailure = "none";
+  await user.click(screen.getByRole("button", { name: "刷新备份状态" }));
+  await ready();
+  expect(requests("request", "POST")).toHaveLength(1);
+  await user.click(screen.getByRole("button", { name: "请求一次备份" }));
+  expect(await screen.findByText(/备份请求已排队/)).toBeTruthy();
+  expect(requests("request", "POST")).toHaveLength(2);
+});
+
+it("keeps unsaved schedule fields after an unknown save and never repeats PUT", async () => {
+  render(<HubBackups />);
+  await ready();
+  fireEvent.change(screen.getByLabelText("保留版本数量"), {
+    target: { value: "12" },
+  });
+  requestFailure = "lost";
+  await userEvent.click(screen.getByRole("button", { name: "保存备份计划" }));
+  expect(await screen.findByText(/计划保存结果未知/)).toBeTruthy();
+  expect(
+    (screen.getByLabelText("保留版本数量") as HTMLInputElement).value,
+  ).toBe("12");
+  await userEvent.click(screen.getByRole("button", { name: "刷新备份状态" }));
+  await ready();
+  expect(requests("schedule", "PUT")).toHaveLength(1);
+  expect(screen.getByText(/有尚未保存的修改/)).toBeTruthy();
+});
+
+it("offers relogin on forbidden mutation and never claims it queued", async () => {
+  render(<HubBackups />);
+  await ready();
+  requestFailure = "forbidden";
+  await userEvent.click(screen.getByRole("button", { name: "请求一次备份" }));
+  expect(
+    await screen.findByText("管理员登录已失效，请重新登录。"),
+  ).toBeTruthy();
+  expect(screen.queryByText(/备份请求已排队/)).toBeNull();
+});
+
+it("polls only status and checks versions once per newly completed backup", async () => {
+  vi.useFakeTimers();
+  const view = render(<HubBackups />);
+  await act(async () => {
+    await vi.advanceTimersByTimeAsync(0);
+  });
+  expect(requests("status")).toHaveLength(1);
+  expect(requests("versions")).toHaveLength(0);
+  fireEvent.change(screen.getByLabelText("保留版本数量"), {
+    target: { value: "12" },
+  });
+  await act(async () => {
+    await vi.advanceTimersByTimeAsync(10000);
+  });
+  expect(requests("status")).toHaveLength(2);
+  expect(requests("versions")).toHaveLength(0);
+  state = {
+    ...state,
+    execution: {
+      schema_version: 1,
+      state: "completed",
+      last_backup_id: versionId,
+      last_success_at: timestamp,
+    },
+  };
+  await act(async () => {
+    await vi.advanceTimersByTimeAsync(10000);
+  });
+  expect(requests("versions")).toHaveLength(1);
+  await act(async () => {
+    await vi.advanceTimersByTimeAsync(30000);
+  });
+  expect(requests("versions")).toHaveLength(1);
+  expect(
+    (screen.getByLabelText("保留版本数量") as HTMLInputElement).value,
+  ).toBe("12");
+  view.rerender(<HubBackups active={false} />);
+  const count = requests("status").length;
+  await act(async () => {
+    await vi.advanceTimersByTimeAsync(30000);
+  });
+  expect(requests("status")).toHaveLength(count);
+});
+
+it("does not unlock an unknown POST through automatic polling", async () => {
+  vi.useFakeTimers();
+  render(<HubBackups />);
+  await act(async () => {
+    await vi.advanceTimersByTimeAsync(0);
+  });
+  requestFailure = "lost";
+  await act(async () => {
+    fireEvent.click(screen.getByRole("button", { name: "请求一次备份" }));
+    await vi.advanceTimersByTimeAsync(0);
+  });
+  await act(async () => {
+    await vi.advanceTimersByTimeAsync(30000);
+  });
+  expect(requests("request", "POST")).toHaveLength(1);
+  expect(screen.getByText(/备份请求结果未知/)).toBeTruthy();
+  expect(
+    (screen.getByRole("button", { name: "请求一次备份" }) as HTMLButtonElement)
+      .disabled,
+  ).toBe(true);
+});
diff --git a/memhub/apps/web/src/HubBackups.tsx b/memhub/apps/web/src/HubBackups.tsx
