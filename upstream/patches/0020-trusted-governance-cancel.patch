+def _governance_seed(tmp_path, state=PENDING, invoked=0):
+    queue = DurableWriteQueue(tmp_path / "synthetic.sqlite3")
+    job = queue.submit(_governance_request())
+    with sqlite3.connect(queue.database_path) as db:
+        db.execute(
+            "UPDATE memory_write_jobs SET state=?,hy_invoked=?,updated_at=?,"
+            "lease_owner=?,lease_expires_at=?,last_error=?,"
+            "sdk_raw_ids_json=?,sdk_memory_ids_json=? WHERE job_id=?",
+            (
+                state,
+                invoked,
+                "2020-01-01T00:00:00+00:00",
+                "synthetic-owner",
+                "2099-01-01T00:00:00+00:00",
+                "synthetic-old-error",
+                '["synthetic-raw"]',
+                '["synthetic-memory"]',
+                job.job_id,
+            ),
+        )
+    return queue, job.job_id
+
+
+def _governance_digest(payload):
+    return sha256(payload.encode("utf-8")).hexdigest()
+
+
+def _governance_snapshot(row):
+    return {
+        "expected_request_id": row["idempotency_key"],
+        "expected_payload_digest": _governance_digest(row["payload_json"]),
+        "expected_updated_at": row["updated_at"],
+        "expected_state": row["state"],
+        "expected_hy_invoked": row["hy_invoked"],
+    }
+
+
+def _governance_reap_snapshot(row):
