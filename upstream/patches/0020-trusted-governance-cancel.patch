+def _governance_rows(queue):
+    with sqlite3.connect(queue.database_path) as db:
+        db.row_factory = sqlite3.Row
+        return {
+            row["job_id"]: dict(row)
+            for row in db.execute("SELECT * FROM memory_write_jobs ORDER BY job_id")
+        }
+
