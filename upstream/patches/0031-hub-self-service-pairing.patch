+        if (progress?.device_id === result.device_id) {
+          credential.current = null;
+          pairing.current = null;
+          setReady(false);
+        }
+      } else {
+        const result = await revokeSource(selected.value, signal);
+        if (signal.aborted || !alive.current) return;
+        setSources((rows) =>
+          rows.map((row) =>
+            row.source_id === result.source_id ? result : row,
+          ),
+        );
+        if (progress?.source_id === result.source_id) {
+          pairing.current = null;
+          setReady(false);
+        }
+      }
+      setNotice(
+        selected.kind === "device"
+          ? "已撤销此设备在全部项目的访问，已有记忆保留。"
+          : "已停止此来源的上传与后续处理，已有记忆保留。",
+      );
+    });
+  }
+  const projectDevices = devices.filter(
+    (device) =>
+      device.grants.some((grant) => grant.scope_id === scope) ||
+      sources.some(
+        (source) =>
+          source.scope_id === scope && source.device_id === device.device_id,
+      ),
+  );
+  const sourceNeedsChoice =
+    progress &&
+    (progress.source_creation_unknown ||
+      ["source_unknown", "choose_source"].includes(progress.phase));
+  return (
+    <>
+      <section className="hub-card hub-pairing" aria-label="设备配对">
+        <h2>为「{project.display_name}」接入设备</h2>
+        <p>
+          每台设备使用独立身份。新设备会获得本项目的记忆读取、历史读取和上传权限。
+        </p>
+        {storageError && (
+          <p role="alert">
+            无法读取或保留配对阶段，暂不继续写入。请恢复当前站点的会话存储后核对设备列表。
+          </p>
+        )}
+        {!progress ? (
+          <form
+            onSubmit={(event) => {
+              event.preventDefault();
+              void create();
+            }}
+          >
+            <label>
+              设备名称{" "}
+              <input
+                value={name}
+                maxLength={80}
+                onChange={(event) => setName(event.target.value)}
+                disabled={busy || storageError}
+              />
+            </label>
+            <R6Button
+              type="submit"
+              pending={busy}
+              disabled={!name.trim() || storageError || !loaded}
+            >
+              创建独立设备并配对
+            </R6Button>
+          </form>
+        ) : (
+          <>
+            <p role="status">当前阶段：{phaseNames[progress.phase]}</p>
+            {progress.device_id && (
+              <p>
+                设备编号：<code>{progress.device_id}</code>
+              </p>
+            )}
+            {progress.source_id && (
+              <p>
+                来源编号：<code>{progress.source_id}</code>
+              </p>
+            )}
+            {progress.phase === "create_unknown" && (
+              <p>
+                设备创建响应未确认。先刷新列表，再明确选择已创建的设备；不会自动重新创建。
+              </p>
+            )}
+            {currentDevice &&
+              !credential.current &&
+              currentDevice.status === "active" && (
+                <>
+                  <p>
+                    此页已没有该设备凭据。重新签发会立即使该设备在所有项目的旧安装失效；需要重新导入配对文件。
+                  </p>
+                  <label>
+                    <input
+                      type="checkbox"
+                      checked={rotateConfirmed}
+                      disabled={busy}
+                      onChange={(event) =>
+                        setRotateConfirmed(event.target.checked)
+                      }
+                    />
+                    我确认重新签发此设备凭据，并使旧连接失效。
+                  </label>
+                  <R6Button
+                    disabled={!rotateConfirmed || busy || storageError}
+                    onClick={() => void rotate()}
+                  >
+                    重新签发并继续配对
+                  </R6Button>
+                </>
+              )}
+            {currentDevice?.status === "revoked" && (
+              <p role="alert">
+                此设备已撤销，不能继续配对。请在下方选择其他活动设备。
+              </p>
+            )}
+            {sourceNeedsChoice && (
+              <>
+                <p>
+                  请核对本设备在当前项目已登记的来源。没有找到时稍后刷新，不自动再次登记。
+                </p>
+                <label>
+                  已登记来源{" "}
+                  <select
+                    value={chosenSource}
+                    disabled={busy}
+                    onChange={(event) => setChosenSource(event.target.value)}
+                  >
+                    <option value="">请选择</option>
+                    {candidates.map((row) => (
+                      <option key={row.source_id} value={row.source_id}>
+                        {row.display_name} · {row.source_id.slice(-8)}
+                      </option>
+                    ))}
+                  </select>
+                </label>
+              </>
+            )}
+            {(progress.phase === "create_unknown" ||
+              progress.source_creation_unknown) && (
+              <>
+                <p>
+                  刷新仍找不到时，可人工结束这次未知尝试。旧请求仍可能完成；再次操作前请核对列表，并停用重复来源或撤销重复设备。
+                </p>
+                <label>
+                  <input
+                    type="checkbox"
+                    checked={endConfirmed}
+                    disabled={busy || loading}
+                    onChange={(event) => setEndConfirmed(event.target.checked)}
+                  />
+                  我已刷新并核对列表，决定结束这次未知尝试。
+                </label>
+                <R6Button
+                  disabled={busy || loading || !endConfirmed}
+                  onClick={endUnknownAttempt}
+                >
+                  结束本次未知尝试
+                </R6Button>
+              </>
+            )}
+            {credential.current &&
+              !ready &&
+              progress.phase !== "create_unknown" && (
+                <R6Button
+                  disabled={
+                    busy ||
+                    storageError ||
+                    progress.phase === "grants_unknown" ||
+                    Boolean(sourceNeedsChoice && !chosenSource)
+                  }
+                  onClick={continuePairing}
+                >
+                  核对后继续配对
+                </R6Button>
+              )}
+            {ready && (
+              <>
+                <p>
+                  这是长期设备凭据，不是一次性配对码。离开此页会清除页面内存中的凭据；你主动下载的文件仍保留凭据，请勿分享文件。
+                </p>
+                <R6Button
+                  variant="primary"
+                  disabled={busy}
+                  onClick={() =>
+                    void run(async (signal) => {
+                      const issued = credential.current;
+                      const selected = sources.find(
+                        (row) => row.source_id === pairing.current?.source_id,
+                      );
+                      if (!issued || !selected) {
+                        setReady(false);
+                        return;
+                      }
+                      const checked = await checkPairing(
+                        instance,
+                        scope,
+                        issued,
+                        selected,
+                        signal,
+                      );
+                      if (!signal.aborted && alive.current)
+                        downloadPairing(checked);
+                    })
+                  }
+                >
+                  下载配对文件
+                </R6Button>
+                <p>在目标 Mac 安装连接组件后运行：</p>
+                <pre>
+                  <code>
+                    cloud-memory-setup import --pairing-file '&lt;下载文件&gt;'
+                  </code>
+                </pre>
+              </>
+            )}
+            {progress.phase === "ready" && (
+              <R6Button
+                variant="quiet"
+                disabled={busy}
+                onClick={clearCompleted}
+              >
+                我已保存文件，清除此页凭据
+              </R6Button>
+            )}
+          </>
+        )}
+        <details>
+          <summary>恢复未完成配对或选择已有设备</summary>
+          <p>
+            按设备名称与编号核对，不会自动采用同名设备。选择后须明确重新签发凭据。
+          </p>
+          <label>
+            已有设备{" "}
+            <select
+              value={chosenDevice}
+              disabled={busy || loading}
+              onChange={(event) => setChosenDevice(event.target.value)}
+            >
+              <option value="">请选择活动设备</option>
+              {devices
+                .filter((row) => row.status === "active")
+                .map((row) => (
+                  <option key={row.device_id} value={row.device_id}>
+                    {row.display_name} · {row.device_id.slice(-8)}
+                  </option>
+                ))}
+            </select>
+          </label>
+          <R6Button
+            disabled={!chosenDevice || busy || storageError}
+            onClick={chooseExisting}
+          >
+            使用所选设备继续配对
+          </R6Button>
+        </details>
+        <R6Button
+          variant="quiet"
+          disabled={busy || loading}
+          onClick={() => void refresh()}
+        >
+          刷新设备与来源并核对
+        </R6Button>
+        {loading && <p role="status">正在读取设备与来源…</p>}
+        {error && <p role="alert">{error}</p>}
+        {notice && <p role="status">{notice}</p>}
+      </section>
+      <section className="hub-card" aria-label="项目设备授权">
+        <h2>本项目的设备与来源</h2>
+        <p>
+          下列是登记和授权状态，不代表设备在线、已安装客户端或本地队列已上传。
+        </p>
+        {!loaded ? (
+          <p>设备列表尚未读取成功。</p>
+        ) : !projectDevices.length ? (
+          <p>当前项目尚未接入设备。</p>
+        ) : (
+          <ul>
+            {projectDevices.map((device) => (
+              <li key={device.device_id}>
+                <strong>{device.display_name}</strong> ·{" "}
+                {device.device_id.slice(-8)} ·{" "}
+                {device.status === "revoked"
+                  ? "设备已撤销"
+                  : hasPermissions(device, scope)
+                    ? "本项目授权有效"
+                    : "本项目授权不完整"}
+                <ul>
+                  {sources
+                    .filter(
+                      (source) =>
+                        source.device_id === device.device_id &&
+                        source.scope_id === scope,
+                    )
+                    .map((source) => (
+                      <li key={source.source_id}>
+                        {source.display_name} · {source.source_id.slice(-8)} ·{" "}
+                        {source.status === "active"
+                          ? "来源已登记"
+                          : "来源已停用"}
+                        {source.status === "active" && (
+                          <R6Button
+                            variant="quiet"
+                            disabled={busy}
+                            onClick={() =>
+                              setConfirmation({ kind: "source", value: source })
+                            }
+                          >
+                            停止此来源
+                          </R6Button>
+                        )}
+                      </li>
+                    ))}
+                </ul>
+                {device.status === "active" && (
+                  <R6Button
+                    variant="quiet"
+                    disabled={busy}
+                    onClick={() =>
+                      setConfirmation({ kind: "device", value: device })
+                    }
+                  >
+                    撤销此设备
+                  </R6Button>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+      {confirmation && (
+        <SourceDisconnectDialog
+          name={confirmation.value.display_name}
+          title={
+            confirmation.kind === "device"
+              ? "撤销此设备在全部项目的授权？"
+              : "停止此来源？"
+          }
+          description={
+            confirmation.kind === "device"
+              ? "此设备在全部项目的旧连接将立即失效，不仅是当前项目。已接纳的记忆和历史仍保留在 NAS，其他设备不受影响。"
+              : "停止此来源的上传与后续处理，同设备其他来源的授权不变。已接纳的记忆和历史仍保留在 NAS。"
+          }
+          onCancel={() => setConfirmation(null)}
+          onConfirm={() => void revoke()}
+        />
+      )}
+    </>
+  );
+}
