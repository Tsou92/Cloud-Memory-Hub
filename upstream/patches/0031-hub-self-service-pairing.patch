+it("creates an independent scoped identity, verifies access and downloads only the pairing contract", async () => {
+  render(<HubConnections {...props} />);
+  await start();
+  await userEvent.click(
+    await screen.findByRole("button", { name: "下载配对文件" }),
+  );
+  await waitFor(() => expect(click).toHaveBeenCalledOnce());
+  const file = JSON.parse(await blobText(downloaded as unknown as Blob));
+  expect(file).toEqual({
+    schema_version: 1,
+    kind: "cloud-memory-hub-pairing",
+    origin: window.location.origin,
+    instance_id: instance,
+    device_id: deviceId,
+    scope_id: scopeA,
+    source_id: sourceId,
+    credential: currentCredential,
+  });
+  expect(devices[0].grants).toEqual([
+    { scope_id: scopeA, permissions: requiredPermissions },
+  ]);
+  expect(sources[0].adapter_id).toBe(agentAdapter);
+  expect(JSON.stringify(sessionStorage)).not.toContain(currentCredential);
+  expect(JSON.stringify(localStorage)).not.toContain(currentCredential);
+  expect(document.body.textContent).not.toContain(currentCredential);
+  expect(postCount("/devices")).toBe(1);
+  expect(postCount("/sources")).toBe(1);
+  expect(
+    fetcher.mock.calls.filter(([url]) => String(url).endsWith("/access")),
+  ).toHaveLength(2);
+  await userEvent.click(
+    screen.getByRole("button", { name: "我已保存文件，清除此页凭据" }),
+  );
+  expect(screen.queryByRole("button", { name: "下载配对文件" })).toBeNull();
+  expect(sessionStorage.getItem(progressKey(instance, scopeA))).toBeNull();
+});
