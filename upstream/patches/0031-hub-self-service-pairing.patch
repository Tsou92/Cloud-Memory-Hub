+it("cancels an abandoned project flow and retains only identifiers for later review", async () => {
+  let finish: ((value: Response) => void) | undefined;
+  let signal: AbortSignal | null | undefined;
+  fetcher.mockImplementation((url: string, init: RequestInit) => {
+    if (url.endsWith("/devices") && init.method === "POST") {
+      devices.push(device());
+      signal = init.signal;
+      return new Promise<Response>((resolve) => {
+        finish = resolve;
+      });
+    }
+    return handler(url, init);
+  });
+  const view = render(<HubConnections key="a" {...props} />);
+  await start();
+  await waitFor(() => expect(finish).toBeTruthy());
+  view.rerender(
+    <HubConnections
+      key="b"
+      {...props}
+      project={{ scope_id: scopeB, display_name: "合成项目 B" }}
+    />,
+  );
+  expect(signal?.aborted).toBe(true);
+  await act(async () =>
+    finish?.(
+      response({ device: devices[0], credential: currentCredential }, 201),
+    ),
+  );
+  expect(
+    fetcher.mock.calls.some(([url]) => String(url).endsWith("/grants")),
+  ).toBe(false);
+  expect(
+    JSON.parse(sessionStorage.getItem(progressKey(instance, scopeA)) ?? "null")
+      .phase,
+  ).toBe("create_unknown");
+  expect(sessionStorage.getItem(progressKey(instance, scopeB))).toBeNull();
+});
