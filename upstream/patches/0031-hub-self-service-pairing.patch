+// @vitest-environment jsdom
+import {
+  act,
+  cleanup,
+  render,
+  screen,
+  waitFor,
+  within,
+} from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { HubConnections } from "./HubConnections";
+import {
+  agentAdapter,
+  type PairDevice,
+  type PairSource,
+  progressKey,
+  requiredPermissions,
+} from "./hub-pairing";
+
+const instance = "11111111-1111-4111-8111-111111111111";
+const scopeA = "33333333-3333-4333-8333-333333333333";
+const scopeB = "44444444-4444-4444-8444-444444444444";
+const deviceId = "22222222-2222-4222-8222-222222222222";
+const sourceId = "55555555-5555-4555-8555-555555555555";
+const project = { scope_id: scopeA, display_name: "合成项目 A" };
+const props = {
+  instance,
+  project,
+  onCreated: vi.fn(),
+  onRefreshProjects: vi.fn(),
+};
+const credentialFor = (letter = "a") =>
+  `cmhdev_v1_${deviceId}_${letter.repeat(43)}`;
+const device = (grants: PairDevice["grants"] = []): PairDevice => ({
+  device_id: deviceId,
+  display_name: "合成 Mac",
+  revision: 1,
+  status: "active",
+  created_at: "2026-11-10T00:00:00Z",
+  grants,
+});
+const source = (): PairSource => ({
+  source_id: sourceId,
+  scope_id: scopeA,
+  device_id: deviceId,
+  display_name: "合成 Agent",
+  adapter_id: agentAdapter,
+  revision: 1,
+  status: "active",
+});
+let devices: PairDevice[];
+let sources: PairSource[];
+let currentCredential: string;
+let fetcher: ReturnType<typeof vi.fn>;
+let downloaded: Blob | null;
+let click: ReturnType<typeof vi.spyOn>;
+let dropDevice: boolean;
+let dropSource: boolean;
+let conflictGrant: boolean;
+let wrongInstance: boolean;
+function response(value: unknown, status = 200) {
+  return Response.json(value, { status });
+}
+async function handler(url: string, init: RequestInit = {}): Promise<Response> {
+  const method = init.method ?? "GET",
+    body = init.body ? JSON.parse(String(init.body)) : null;
+  if (url.endsWith("/devices") && method === "GET")
+    return response({ devices });
+  if (url.endsWith("/sources") && method === "GET")
+    return response({ sources });
+  if (url.endsWith("/projects"))
+    return response(
+      {
+        project_id: scopeB,
+        display_name: body.display_name,
+        created_at: "2026-11-10T00:00:00Z",
+      },
+      201,
+    );
+  if (url.endsWith("/devices") && method === "POST") {
+    devices.push({ ...device(), display_name: body.display_name });
+    if (dropDevice) throw new TypeError("synthetic_lost_device_response");
+    return response({ device: devices[0], credential: currentCredential }, 201);
+  }
+  const current = devices.find((row) => row.device_id === deviceId);
+  if (url.endsWith("/grants") && current) {
+    if (conflictGrant) {
+      conflictGrant = false;
+      current.revision++;
+      current.grants = [{ scope_id: scopeB, permissions: ["memory:read"] }];
+      return response({ detail: "revision_conflict" }, 409);
+    }
+    if (body.expected_revision !== current.revision)
+      return response({ detail: "revision_conflict" }, 409);
+    current.grants = body.grants;
+    current.revision++;
+    return response(current);
+  }
+  if (url.endsWith("/rotate") && current) {
+    if (body.expected_revision !== current.revision)
+      return response({ detail: "revision_conflict" }, 409);
+    current.revision++;
+    currentCredential = credentialFor("b");
+    return response({ device: current, credential: currentCredential });
+  }
+  if (url.endsWith("/sources") && method === "POST") {
+    if (dropSource) throw new TypeError("synthetic_source_write_unknown");
+    const added = { ...source(), ...body };
+    sources.push(added);
+    return response(added, 201);
+  }
+  if (url.endsWith("/access") && current) {
+    expect((init.headers as Record<string, string>).Authorization).toBe(
+      `Bearer ${currentCredential}`,
+    );
+    return response({
+      protocol_version: 1,
+      instance_id: wrongInstance ? scopeB : instance,
+      device_id: deviceId,
+      device_revision: current.revision,
+      source_id: sourceId,
+      source_revision: sources[0].revision,
+      scope_id: scopeA,
+      allowed: true,
+    });
+  }
+  if (url.endsWith(`/devices/${deviceId}/revoke`) && current) {
+    current.revision++;
+    current.status = "revoked";
+    current.grants = [];
+    return response(current);
+  }
+  if (url.endsWith(`/sources/${sourceId}/revoke`)) {
+    sources[0].revision++;
+    sources[0].status = "revoked";
+    return response(sources[0]);
+  }
+  throw new Error("unexpected_test_route");
+}
+beforeEach(() => {
+  devices = [];
+  sources = [];
+  currentCredential = credentialFor();
+  downloaded = null;
+  dropDevice = false;
+  dropSource = false;
+  conflictGrant = false;
+  wrongInstance = false;
+  sessionStorage.clear();
+  localStorage.clear();
+  props.onCreated.mockClear();
+  props.onRefreshProjects.mockClear();
+  fetcher = vi.fn(handler);
+  vi.stubGlobal("fetch", fetcher);
+  const RealURL = URL;
+  vi.stubGlobal(
+    "URL",
+    class extends RealURL {
+      static createObjectURL(blob: Blob) {
+        downloaded = blob;
+        return "blob:synthetic-pairing";
+      }
+      static revokeObjectURL() {}
+    },
+  );
+  click = vi
+    .spyOn(HTMLAnchorElement.prototype, "click")
+    .mockImplementation(() => {});
+});
+afterEach(() => {
+  cleanup();
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+async function start() {
+  await waitFor(() =>
+    expect(
+      fetcher.mock.calls.filter(([url]) => String(url).endsWith("/devices"))
+        .length,
+    ).toBeGreaterThan(0),
+  );
+  await userEvent.type(
+    screen.getByRole("textbox", { name: "设备名称" }),
+    "合成 Mac",
+  );
+  await userEvent.click(
+    screen.getByRole("button", { name: "创建独立设备并配对" }),
+  );
+}
+async function blobText(blob: Blob): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(String(reader.result));
+    reader.onerror = reject;
+    reader.readAsText(blob);
+  });
+}
+function postCount(suffix: string) {
+  return fetcher.mock.calls.filter(
+    ([url, init]) => String(url).endsWith(suffix) && init.method === "POST",
+  ).length;
+}
