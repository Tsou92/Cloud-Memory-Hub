+def project_core_diagnostic(value: dict) -> dict:
+    """The structured Core sink is separate from Python logging handlers."""
+    result = {
+        "schema_version": 1, "diagnostic_policy": POLICY_VERSION,
+        "content_omitted": True, "timestamp": _timestamp(value.get("timestamp")),
+        "level": _enum(value.get("level"), frozenset(("info", "warn", "error")), "info"),
+        "service": "core",
+        "component": _enum(value.get("component"), _CORE_COMPONENTS),
+        "event": _enum(value.get("event"), _CORE_EVENTS),
+        "outcome": _enum(value.get("outcome"), _ENUMS["outcome"]),
+    }
+    for key in ("session_id", "trace_id", "incident_id", "instance_id", "operation_id", "request_id", "job_id", "task_id"):
+        identity = safe_identifier(value.get(key), request=key == "request_id")
+        if identity:
+            result[key] = identity
+    if "duration_ms" in value:
+        result["duration_ms"] = int(_number(value["duration_ms"]))
+    if "error_type" in value:
+        result["error_type"] = _enum(value["error_type"], _ERROR_TYPES, "Error")
+    frames = _safe_stack(value.get("safe_stack"))
+    if frames:
+        result["safe_stack"] = frames
+    details = _metadata(value.get("details"))
+    if details:
+        result["details"] = details
+    return result
