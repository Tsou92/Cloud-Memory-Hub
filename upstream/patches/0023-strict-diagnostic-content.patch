+        assert BODY not in json.dumps(lines, ensure_ascii=False)
+        assert not any(BODY in str(f) for f in (tmp_path / 'logs').rglob('*'))
+        await cache.store_memory_operation(values['request_id'], BODY, BODY, 'ADD', str(uuid4()), BODY, reason=BODY)
+        operations = await cache.get_memory_operations(request_id=values['request_id'])
+        assert len(operations) == 1 and operations[0]['content'] == operations[0]['reason'] == ''
+        # Authority/recovery state is explicitly outside the diagnostic projection.
+        await cache.claim_write_outcome(values['request_id'], BODY, BODY, BODY, 'add')
+        assert await cache.finish_write_outcome(values['request_id'], 'succeeded', {'content': BODY})
+        outcome = await cache.get_write_outcome(values['request_id'])
+        assert outcome['result']['content'] == BODY
+    finally:
