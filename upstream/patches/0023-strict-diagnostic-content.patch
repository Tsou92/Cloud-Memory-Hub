+def test_activation_refuses_an_existing_handlers_actual_emit_until_retry(tmp_path):
+    log_setup.setup_logging(level=logging.INFO)
+    logger = logging.getLogger('hy_memory')
+    handler = next(h for h in logger.handlers if isinstance(h, logging.FileHandler))
+    original = handler.stream
+    entered, release = threading.Event(), threading.Event()
+    class BlockedStream:
+        def write(self, value):
+            entered.set()
+            assert release.wait(3)
+            return original.write(value)
+        def flush(self):
+            original.flush()
+        def close(self):
+            original.close()
+    handler.stream = BlockedStream()
+    emitter = threading.Thread(target=lambda: logger.info(BODY))
+    emitter.start()
+    assert entered.wait(2)
+    previous = [h.formatter for h in logger.handlers]
+    try:
+        with pytest.raises(policy.DiagnosticPolicyError, match='^diagnostic_policy_logging_active$'):
+            policy.enable_strict_diagnostics()
+        assert not policy.strict_diagnostics_enabled()
+        assert [h.formatter for h in logger.handlers] == previous
+    finally:
+        release.set()
+        emitter.join(2)
+    policy.enable_strict_diagnostics()
+    old = (tmp_path / 'logs/hy_memory.log').read_text()
+    assert BODY in old  # Previously written content is a separate cleanup task.
+    logger.info(BODY)
+    handler.flush()
+    after = (tmp_path / 'logs/hy_memory.log').read_text()
+    assert BODY not in after[len(old):]
+
