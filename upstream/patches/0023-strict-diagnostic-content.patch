+def test_sdk_handler_attach_and_activation_are_atomic(tmp_path, monkeypatch):
+    logger = logging.getLogger('hy_memory')
+    original = logger.addHandler
+    entered, release, activated = threading.Event(), threading.Event(), threading.Event()
+    def blocked_attach(handler):
+        if isinstance(handler, logging.FileHandler):
+            entered.set()
+            assert release.wait(3)
+        original(handler)
+    monkeypatch.setattr(logger, 'addHandler', blocked_attach)
+    setup = threading.Thread(target=lambda: log_setup.setup_logging(level=logging.INFO))
+    setup.start()
+    assert entered.wait(2)
+    activation = threading.Thread(target=lambda: (policy.enable_strict_diagnostics(), activated.set()))
+    activation.start()
+    try:
+        assert not activated.wait(0.03)
+    finally:
+        release.set()
+        setup.join(2)
+        activation.join(2)
+    assert activated.is_set()
+    logger.info(BODY)
+    for handler in logger.handlers:
+        handler.flush()
+        assert isinstance(handler.formatter, policy.StrictDiagnosticFormatter)
+    assert BODY not in (tmp_path / 'logs/hy_memory.log').read_text()
+
