+def project_metrics(data) -> dict:
+    values = data if type(data) is dict else {}
+    result = {key: _number(values.get(key)) for key in _METRIC_COUNTS}
+    for key, allowed in _METRIC_TIMINGS.items():
+        nested = values.get(key)
+        nested = nested if type(nested) is dict else {}
+        result[key] = {name: _number(nested[name]) for name in allowed if name in nested}
