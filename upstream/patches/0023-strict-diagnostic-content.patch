+    assert policy.safe_identifier('cmh2:'+BODY, request=True) == ''
+    assert policy.safe_identifier('synthetic_private_prose', request=True) == ''
+    assert policy.project_pipeline_diagnostic(step='READ_'+BODY)['step'] == 'unknown'
+    assert policy.safe_identifier(ids[0].upper()) == ''
