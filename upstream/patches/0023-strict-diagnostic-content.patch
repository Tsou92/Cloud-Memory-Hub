+async def test_legacy_sql_callback_delayed_across_close_reopen_gets_final_projection(tmp_path, monkeypatch):
+    import asyncio
+    from hy_memory.data import cache_sqlite
+    original = cache_sqlite._run_in_sqlite_pool
+    ready, release = asyncio.Event(), asyncio.Event()
+    async def delayed(function, *args, **kwargs):
+        if function.__name__ == '_insert':
+            ready.set()
+            await release.wait()
+        return await original(function, *args, **kwargs)
+    monkeypatch.setattr(cache_sqlite, '_run_in_sqlite_pool', delayed)
+    cache = SqliteCache(config(tmp_path))
+    await cache.initialize()
+    values = payload()
+    task = asyncio.create_task(cache.store_pipeline_log(**values))
+    await asyncio.wait_for(ready.wait(), 2)
+    await cache.close()
+    policy.enable_strict_diagnostics()
+    await cache.initialize()
+    release.set()
+    assert await task
+    rows = await cache.get_pipeline_logs(request_id=values['request_id'])
+    assert len(rows) == 1 and BODY not in json.dumps(rows, ensure_ascii=False)
+    await cache.close()
+
