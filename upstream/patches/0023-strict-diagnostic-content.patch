+async def test_metric_bucket_projection_preserves_native_merge_and_drops_old_free_keys(tmp_path):
+    policy.enable_strict_diagnostics()
+    cache = SqliteCache(config(tmp_path))
+    await cache.initialize()
+    minute = "2026-11-10T15:20"
+    try:
+        # An actual legacy row proves a new UPSERT cannot recopy its free keys.
+        with cache._lock:
+            cache._conn.execute("INSERT INTO system_metrics VALUES (?, ?, ?)",
+                (minute, json.dumps({"sys1_started": 2, "sys1_timing_sums": {"sys1_waiting_ms": 4, BODY: BODY}, BODY: BODY}), minute))
+            cache._conn.commit()
+        await cache.store_metrics_minute(minute, {"sys1_started": 3,
+            "sys1_timing_sums": {"sys1_waiting_ms": 5, "arbitrary": Hostile()}, BODY: Hostile()})
+        rows = await cache.load_metrics_range(minute, minute)
+        assert len(rows) == 1 and rows[0]["sys1_started"] == 5
+        assert rows[0]["sys1_timing_sums"]["sys1_waiting_ms"] == 9
+        assert BODY not in json.dumps(rows, ensure_ascii=False)
+        await cache.store_metrics_minute(BODY, {BODY: Hostile()})
+        with cache._lock:
+            all_rows = [dict(row) for row in cache._conn.execute("SELECT * FROM system_metrics")]
+        assert BODY not in json.dumps(all_rows, ensure_ascii=False)
+    finally:
+        await cache.close()
