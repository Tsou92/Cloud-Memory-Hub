+    activator = threading.Thread(target=lambda: (policy.enable_strict_diagnostics(), activated.set()))
+    activator.start()
+    assert not activated.wait(0.03)
+    release.set()
+    writer.join(2)
+    activator.join(2)
+    assert activated.is_set()
+    with pytest.raises(policy.DiagnosticPolicyError, match='legacy_trace_file_unsupported'):
+        trace._write_to_file({'body': BODY})
