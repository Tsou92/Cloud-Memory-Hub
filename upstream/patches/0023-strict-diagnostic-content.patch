@@ -0,0 +1,580 @@
+"""Opt-in, process-monotone diagnostic metadata policy (not business data).
+
+Enable before any diagnostic resource is created. Live legacy resources must
+be closed first; this module cannot retract bytes already queued or written.
+"""
+from __future__ import annotations
+
+import json
+import importlib.util
+import logging
+import math
+import sys
+import threading
+import types
+import weakref
+from functools import wraps
+from datetime import datetime, timezone
+from pathlib import Path
+from uuid import UUID
+
+POLICY_VERSION = "strict-v1"
+MAX_INPUT_BYTES = 64 * 1024
+MAX_ITEMS = 128
+MAX_DEPTH = 4
+_LOCK = threading.RLock()
+_STRICT = False
+_RESOURCES: weakref.WeakKeyDictionary = weakref.WeakKeyDictionary()
+_KNOWN_SOURCES: dict[str, str] = {}
+
+
+class DiagnosticPolicyError(RuntimeError):
+    """Fixed, content-free policy error."""
+
+
+def strict_diagnostics_enabled() -> bool:
+    return _STRICT
+
+
+def register_diagnostic_resource(resource, *, supported: bool = True) -> None:
+    with _LOCK:
+        if _STRICT and not supported:
+            raise DiagnosticPolicyError("diagnostic_policy_backend_unsupported")
+        _RESOURCES[resource] = _STRICT
+
+
+def release_diagnostic_resource(resource) -> None:
+    with _LOCK:
+        _RESOURCES.pop(resource, None)
+
+
+def _source_inventory() -> dict[str, str]:
+    roots = [Path(__file__).resolve().parents[1]]
+    for package in ("one_memory", "cloud_memory_hub"):
+        spec = importlib.util.find_spec(package)
+        if spec and spec.submodule_search_locations:
+            roots.extend(Path(p) for p in spec.submodule_search_locations)
+    result = {}
+    for root in roots:
+        for source in root.rglob("*.py"):
+            result[str(source.resolve())] = root.name + "/" + source.relative_to(root).as_posix()
+    return result
+
+
+def _owned_handlers():
+    result = []
+    for name in ("hy_memory", ""):
+        for handler in logging.getLogger(name).handlers:
+            if (name == "hy_memory" or getattr(handler, "_one_memory_diagnostic_handler", False)) and handler not in result:
+                result.append(handler)
+    return result
+
+
+def _protected(handler):
+    return isinstance(handler.formatter, StrictDiagnosticFormatter) and getattr(handler.handleError, "__func__", None) is _safe_handle_error
+
+
+def _handler_lock(handler):
+    lock = handler.lock
+    if lock is None or not callable(getattr(lock, "_is_owned", None)):
+        raise DiagnosticPolicyError("diagnostic_policy_handler_unsupported")
+    return lock
+
+
+def enable_strict_diagnostics() -> None:
+    """Irreversibly opt in; busy legacy resources/emitters require a retry."""
+    global _STRICT, _KNOWN_SOURCES
+    # Reject same-thread re-entry BEFORE taking policy lock: another activator
+    # must never wait for the handler lock held by this legacy formatter.
+    for handler in _owned_handlers():
+        if not _protected(handler) and _handler_lock(handler)._is_owned():
+            raise DiagnosticPolicyError("diagnostic_policy_logging_active")
+    with _LOCK:
+        core = sys.modules.get("one_memory.diagnostic_log")
+        core_lock = getattr(core, "_diagnostic_resource_lock", _LOCK)
+        with core_lock:
+            if not _STRICT:
+                core_resources = getattr(core, "_live_diagnostic_logs", ())
+                if any(not mode for mode in _RESOURCES.values()) or any(core_resources):
+                    raise DiagnosticPolicyError("diagnostic_policy_resources_active")
+            locks = []
+            try:
+                targets = [handler for handler in _owned_handlers() if not _protected(handler)]
+                for handler in targets:
+                    lock = _handler_lock(handler)
+                    if lock._is_owned() or not lock.acquire(False):
+                        raise DiagnosticPolicyError("diagnostic_policy_logging_active")
+                    locks.append(lock)
+                sources = _KNOWN_SOURCES if _STRICT else _source_inventory()
+                for handler in targets:
+                    _set_strict_handler(handler)
+                _KNOWN_SOURCES = sources
+                _STRICT = True
+            finally:
+                for lock in reversed(locks):
+                    lock.release()
+
+
+def safe_identifier(value, *, request: bool = False) -> str:
+    if type(value) is not str or len(value) > 160:
+        return ""
+    if request and value.startswith(("cmh:", "cmh2:")):
+        parts = value.split(":")
+        count = 5 if parts[0] == "cmh2" else 4
+        return value if len(parts) == count and all(safe_identifier(v) for v in parts[1:]) else ""
+    if len(value) != 36:
+        return ""
+    try:
+        return value if str(UUID(value)) == value else ""
+    except (ValueError, AttributeError):
+        return ""
+
+
+# This is a closed vocabulary, not a suffix/regular-expression trust rule.
+_STEPS = frozenset("""
+CODING_EXTRACT CODING_JUDGE CODING_RECONCILE DELETE DELETE_ALL_GRAPH
+DELETE_ALL_SUMMARY DELETE_ALL_VDB EPISODE EXTRACT GET GET_BASIC_INFO
+GET_USER_PROFILE INTENTION_UPSERT LIST RECONCILE RECONCILE_APPLY
+RECONCILE_CANDIDATES S1_AGENT_FAILED S1_AGENT_SKIPPED S1_EMBED S1_L1_ROLLBACK
+S1_L1_UPSERT SEARCH_QUERY SUMMARY SWEEPER_BEH_EMBED SWEEPER_COLLISION
+SWEEPER_CORE_CREATE SWEEPER_CORE_MERGE SWEEPER_SUMMARY SYSTEM2_AGENT
+SYSTEM2_AGENT_MESSAGES SYSTEM2_AGENT_TRAJECTORY SYSTEM2_PREPROCESS TOOL_CALLS
+WRITE_SUMMARY WRITE_TIMELINE READ_SUMMARY READ_CODING_RESULT READ_EMBED_QUERY
+READ_CODING_EMBED READ_RECALL_VEC READ_HIDDEN_L0_CONTEXT READ_RECALL_TAG READ_BM25
+READ_TAG_MATCH READ_CODING_VDB READ_KEYWORD_EMBED READ_SCENE_JUDGE
+""".split())
+_NUMERIC_KEYS = frozenset("""
+elapsed_ms embed_ms llm_ms vdb_search_ms step_ms duration_ms total_ms count
+input_count output_count result_count candidate_count memory_count raw_count
+recalled_count selected_count filtered_count query_count top_k limit score
+prompt_tokens completion_tokens total_tokens tokens token_count attempt
+invalid_lines open_file_count memory_bytes thread_count database_error_count
+file_count sqlite_file_count byte_file_count total_bytes copied_bytes
+bytes_per_second stored_count revised_count skipped_count error_count
+pending_count prepared_count queue_depth in_flight_count call_count
+created_count updated_count superseded_count deleted_count lexical_hits
+semantic_hits generation file_size cursor_new cursor_old summed_ms model_ms
+accounted_ms unaccounted_ms embed_request_ms embed_queue_ms embed_batch_size
+batch_size pool_wait_ms request_ms queued_ms retry_count
+""".split())
+_BOOL_KEYS = frozenset("enabled spawned index_complete timed_out truncated success skipped cached found cursor_read_to_end cursor_rewind_branch content_omitted metadata_truncated".split())
+_ENUMS = {
+    "status": frozenset("ok success succeeded failed pending running completed skipped cancelled timeout unknown".split()),
+    "outcome": frozenset("ok success succeeded failed started completed skipped cancelled rejected observed unknown dropped".split()),
+    "mode": frozenset("default explicit llm vector hybrid lexical semantic chat working coding system1 system2".split()),
+    "scene": frozenset(("chat", "working", "coding")),
+    "layer": frozenset(("L0", "L1", "L2", "L3")),
+    "op": frozenset("add update delete merge keep skip create upsert search read write".split()),
+}
+_CONTAINERS = frozenset(("timings", "counts", "provider_meta", "stats"))
+_ERROR_TYPES = frozenset("Exception Error RuntimeError ValueError TypeError KeyError IndexError OSError IOError TimeoutError CancelledError ConnectionError PermissionError FileNotFoundError OperationalError IntegrityError DatabaseError".split())
+
+
+def _number(value, default=0):
+    if type(value) not in (int, float) or not 0 <= value <= 10**15 or not math.isfinite(value):
+        return default
+    return value
+
+
+def _enum(value, choices, default="unknown"):
+    return value if type(value) is str and value in choices else default
+
+
+def _metadata(value, depth=0):
+    if type(value) is not dict or depth >= MAX_DEPTH or len(value) > MAX_ITEMS:
+        return {}
+    result = {}
+    for key, item in value.items():
+        if type(key) is not str:
+            continue
+        if len(key) > 80:
+            continue
+        if key in _NUMERIC_KEYS:
+            number = _number(item, None)
+            if number is not None:
+                result[key] = number
+        elif key in _BOOL_KEYS and type(item) is bool:
+            result[key] = item
+        elif key in _ENUMS and type(item) is str and item in _ENUMS[key]:
+            result[key] = item
+        elif key in _CONTAINERS:
+            nested = _metadata(item, depth + 1)
+            if nested:
+                result[key] = nested
+    return result
+
+
+def project_parsed(value) -> str:
+    parsed = {}
+    if type(value) is str and len(value) <= MAX_INPUT_BYTES:
+        try:
+            if len(value.encode("utf-8")) <= MAX_INPUT_BYTES:
+                parsed = json.loads(value)
+        except (ValueError, UnicodeError, RecursionError):
+            pass
+    elif type(value) is dict:
+        parsed = value
+    result = _metadata(parsed)
+    result.update(diagnostic_policy=POLICY_VERSION, content_omitted=True)
+    encoded = json.dumps(result, ensure_ascii=True, sort_keys=True, separators=(",", ":"))
+    if len(encoded) > MAX_INPUT_BYTES // 2:
+        return '{"content_omitted":true,"diagnostic_policy":"strict-v1","metadata_truncated":true}'
+    return encoded
+
+
+def project_pipeline_diagnostic(**fields) -> dict:
+    """Return fixed keys and bounded metadata; never render arbitrary objects."""
+    ids = fields.get("memory_ids")
+    memory_ids = []
+    if type(ids) in (list, tuple) and len(ids) <= MAX_ITEMS:
+        memory_ids = [safe for item in ids if (safe := safe_identifier(item))]
+    return {
+        "request_id": safe_identifier(fields.get("request_id"), request=True),
+        "user_id": safe_identifier(fields.get("user_id")),
+        "agent_id": safe_identifier(fields.get("agent_id")),
+        "session_id": safe_identifier(fields.get("session_id")),
+        "step": _enum(fields.get("step"), _STEPS),
+        "prompt": "", "response": "",
+        "parsed": project_parsed(fields.get("parsed")),
+        "memory_ids": memory_ids,
+        "elapsed_ms": _number(fields.get("elapsed_ms")),
+        "prompt_tokens": int(_number(fields.get("prompt_tokens"))),
+        "completion_tokens": int(_number(fields.get("completion_tokens"))),
+        "total_tokens": int(_number(fields.get("total_tokens"))),
+        "event_at_ms": int(_number(fields.get("event_at_ms"))) if _number(fields.get("event_at_ms")) <= 253402300799000 else 0,
+    }
+
+
+def safe_error_type(error) -> str:
+    return _enum(type(error).__name__, _ERROR_TYPES, "Error")
+
+
+def safe_exception_details(error) -> dict:
+    """Inspect traceback objects, never format exceptions or load source lines."""
+    result = {"error_type": safe_error_type(error)}
+    frames = []
+    frame = BaseException.__getattribute__(error, "__traceback__")
+    for _ in range(128):
+        if type(frame) is not types.TracebackType:
+            break
+        source = _KNOWN_SOURCES.get(frame.tb_frame.f_code.co_filename)
+        if source:
+            frames.append(source + ":" + str(frame.tb_lineno))
+        frame = frame.tb_next
+    if frames:
+        result["safe_stack"] = tuple(frames[-16:])
+    return result
+
+
+def _safe_stack(value):
+    if type(value) not in (list, tuple) or len(value) > 16:
+        return []
+    sources = frozenset(_KNOWN_SOURCES.values())
+    result = []
+    for entry in value:
+        if type(entry) is not str or len(entry) > 512:
+            continue
+        source, separator, line = entry.rpartition(":")
+        if separator and source in sources and line.isascii() and line.isdecimal() and len(line) <= 8:
+            result.append(source + ":" + str(int(line)))
+    return result
+
+
+def _category(name) -> str:
+    if type(name) is not str:
+        return "unknown"
+    for root in ("hy_memory", "one_memory", "cloud_memory_hub", "uvicorn", "asyncio", "openai", "httpx", "httpcore", "urllib3"):
+        if name == root or name.startswith(root + "."):
+            return root
+    return "unknown"
+
+
+class StrictDiagnosticFormatter(logging.Formatter):
+    """No getMessage, exception formatting, arbitrary extras, or repr fallback."""
+
+    def format(self, record):
+        try:
+            created = _number(record.created)
+            result = {
+                "diagnostic_policy": POLICY_VERSION, "content_omitted": True,
+                "ts": datetime.fromtimestamp(min(created, 253402300799), timezone.utc).isoformat(),
+                "level": _enum(record.levelname, frozenset(("DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL")), "UNKNOWN"),
+                "logger": _category(record.name), "msg": "diagnostic_event",
+                "request_id": safe_identifier(getattr(record, "request_id", ""), request=True),
+                "line": int(_number(record.lineno)),
+            }
+            source = _KNOWN_SOURCES.get(record.pathname) if type(record.pathname) is str else None
+            if source:
+                result["source"] = source
+            exc = record.exc_info
+            if type(exc) is tuple and len(exc) == 3 and isinstance(exc[1], BaseException):
+                result.update(safe_exception_details(exc[1]))
+            return json.dumps(result, ensure_ascii=True, separators=(",", ":"))
+        except Exception:
+            return '{"diagnostic_policy":"strict-v1","content_omitted":true,"msg":"diagnostic_format_failed"}'
+
+
+def _safe_handle_error(self, record):
+    # StreamHandler/FileHandler otherwise prints msg and args to sys.stderr.
+    # Best effort diagnostics must not throw or render a failed record again.
+    return None
+
+
