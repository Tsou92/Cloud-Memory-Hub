+@pytest.fixture(autouse=True)
+def isolated_policy(monkeypatch, tmp_path):
+    # Production exposes no downgrade/reset. Test state is isolated and restored.
+    monkeypatch.setattr(policy, "_STRICT", False)
+    monkeypatch.setattr(policy, "_RESOURCES", weakref.WeakKeyDictionary())
+    monkeypatch.setattr(policy, "_KNOWN_SOURCES", {})
+    monkeypatch.setattr(log_setup, "_logging_configured", False)
+    monkeypatch.setenv("MEMORY_LOG_DIR", str(tmp_path / "logs"))
+    monkeypatch.setenv("MEMORY_PIPELINE_TRACE_ENABLED", "true")
+    logger = logging.getLogger("hy_memory")
+    previous, propagate, level = logger.handlers[:], logger.propagate, logger.level
+    logger.handlers = []
+    yield
+    for handler in logger.handlers:
+        handler.close()
+    logger.handlers, logger.propagate, logger.level = previous, propagate, level
+
+
+def config(tmp_path):
+    return SimpleNamespace(cache=SimpleNamespace(db_path=str(tmp_path / "cache.db")))
+
+
+def payload(**extra):
+    values = dict(request_id=str(uuid4()), user_id=BODY, agent_id=BODY, session_id=BODY,
+                  step="EXTRACT", prompt=BODY, response=BODY,
+                  parsed=json.dumps({BODY: BODY, "reason": BODY, "error": BODY,
+                      "source": BODY, "owner": BODY, "custom_id": BODY,
+                      "custom_ms": BODY, "custom_at": BODY, "count": 7,
+                      "llm_ms": 12.5, "status": "succeeded",
+                      "stats": {"count": 3, "reason": BODY}}),
+                  memory_ids=[BODY, str(uuid4())], elapsed_ms=5.0, total_tokens=9)
+    values.update(extra)
+    return values
+
+
+class Hostile:
+    def __str__(self):
+        raise AssertionError("__str__ must never run")
+
+    def __repr__(self):
+        raise AssertionError("__repr__ must never run")
+
+
+def test_closed_projection_is_idempotent_and_drops_body():
+    values = payload()
+    projected = policy.project_pipeline_diagnostic(**values)
+    assert BODY not in json.dumps(projected, ensure_ascii=False)
+    assert projected["request_id"] == values["request_id"]
+    assert projected["prompt"] == projected["response"] == ""
+    assert projected["user_id"] == projected["agent_id"] == projected["session_id"] == ""
+    parsed = json.loads(projected["parsed"])
+    assert parsed == {"count": 7, "llm_ms": 12.5, "status": "succeeded",
+                      "stats": {"count": 3}, "diagnostic_policy": "strict-v1", "content_omitted": True}
+    assert policy.project_pipeline_diagnostic(**projected) == projected
+
+
