+def test_optional_legacy_trace_write_serializes_with_activation(tmp_path, monkeypatch):
+    from hy_memory.utils import tracer
+    import builtins
+    entered, release, activated = threading.Event(), threading.Event(), threading.Event()
+    original = builtins.open
