+def test_nested_projection_has_a_total_serialized_budget():
+    leaf = {key: 10**14 for key in policy._NUMERIC_KEYS}
+    value = leaf
+    for _ in range(3):
+        value = {**leaf, **{key: value for key in policy._CONTAINERS}}
+    result = policy.project_parsed(value)
+    assert len(result) <= policy.MAX_INPUT_BYTES // 2
+    assert policy.project_parsed(result) == result
+
