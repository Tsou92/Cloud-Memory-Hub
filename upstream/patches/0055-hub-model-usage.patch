+import { useCallback, useEffect, useRef, useState } from "react";
+import { hubErrorMessage } from "./hub-api";
+
+/** Content-free model usage for the administrator console (requirement 9).
+ *
+ * Counts and token totals come from the Core audit store, which already
+ * records every precipitation call. Nothing here estimates money: provider
+ * statements remain authoritative, and the page says so.
+ */
+export interface HubUsageReport {
+  request_count: number;
+  succeeded: number;
+  failed: number;
+  in_flight: number;
+  prompt_tokens: number;
+  completion_tokens: number;
+  total_tokens: number;
+}
+
+function integer(value: unknown): number | null {
+  return Number.isSafeInteger(value) && Number(value) >= 0
+    ? Number(value)
+    : null;
+}
+
+export function parseUsage(value: unknown): HubUsageReport {
+  const row = value as Record<string, unknown>;
+  const report = {
+    request_count: integer(row?.request_count),
+    succeeded: integer(row?.succeeded),
+    failed: integer(row?.failed),
+    in_flight: integer(row?.in_flight),
+    prompt_tokens: integer(row?.prompt_tokens),
+    completion_tokens: integer(row?.completion_tokens),
+    total_tokens: integer(row?.total_tokens),
+  };
+  if (Object.values(report).some((item) => item === null))
+    throw new Error("usage_response_invalid");
+  return report as unknown as HubUsageReport;
+}
+
+export async function getHubUsage(signal?: AbortSignal): Promise<HubUsageReport> {
+  const response = await fetch("/hub/v1/console/usage", {
+    credentials: "same-origin",
+    cache: "no-store",
+    signal,
+  });
+  if (!response.ok) throw new Error("usage_unavailable");
+  return parseUsage(await response.json());
+}
+
+function number(value: number): string {
+  return value.toLocaleString("zh-CN");
+}
+
+export function HubUsage({ active = true }: { active?: boolean }) {
+  const [report, setReport] = useState<HubUsageReport | null>(null);
+  const [error, setError] = useState("");
+  const [loading, setLoading] = useState(false);
+  const alive = useRef(true);
+  const request = useRef<AbortController | null>(null);
+
+  const refresh = useCallback(async () => {
+    request.current?.abort();
+    const controller = new AbortController();
+    request.current = controller;
+    setLoading(true);
+    setError("");
+    try {
+      const next = await getHubUsage(controller.signal);
+      if (alive.current && !controller.signal.aborted) setReport(next);
+    } catch (reason) {
+      if (!alive.current || controller.signal.aborted) return;
+      setError(
+        reason instanceof Error && reason.message === "usage_unavailable"
+          ? "当前服务尚未提供用量统计，请升级 Hub 后重试。"
+          : hubErrorMessage(reason),
+      );
+    } finally {
+      if (alive.current && !controller.signal.aborted) setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    alive.current = true;
+    return () => {
+      alive.current = false;
+      request.current?.abort();
+    };
+  }, []);
+  useEffect(() => {
+    if (active && !report) void refresh();
+  }, [active, report, refresh]);
+
+  return (
+    <div className="r6-settings-body">
+      <div className="r6-setting-row">
+        <div>
+          <h3>模型调用统计</h3>
+          <p>
+            统计 Hub 把内容整理成长期记忆时发起的模型请求与 token。只用于观察用量，不是账单；
+            provider 的账单与计费以对方为准。
+          </p>
+          {report ? (
+            <dl className="hub-usage-list">
+              <div>
+                <dt>模型请求</dt>
+                <dd>{number(report.request_count)} 次</dd>
+              </div>
+              <div>
+                <dt>成功 / 失败</dt>
+                <dd>
+                  {number(report.succeeded)} / {number(report.failed)}
+                </dd>
+              </div>
+              <div>
+                <dt>进行中</dt>
+                <dd>{number(report.in_flight)}</dd>
+              </div>
+              <div>
+                <dt>输入 tokens</dt>
+                <dd>{number(report.prompt_tokens)}</dd>
+              </div>
+              <div>
+                <dt>输出 tokens</dt>
+                <dd>{number(report.completion_tokens)}</dd>
+              </div>
+              <div>
+                <dt>合计 tokens</dt>
+                <dd>{number(report.total_tokens)}</dd>
+              </div>
+            </dl>
+          ) : loading ? (
+            <p role="status">正在读取用量…</p>
+          ) : null}
+          {error ? <p role="alert">{error}</p> : null}
+          <p>
+            网页问答的调用尚未计入这里；历史全量导入与多模态解析也未实现。
+          </p>
+          <button type="button" disabled={loading} onClick={() => void refresh()}>
+            {loading ? "刷新中…" : "刷新用量"}
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
