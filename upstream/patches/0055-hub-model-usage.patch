+// @vitest-environment jsdom
+import { cleanup, render, screen, waitFor } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, expect, it, vi } from "vitest";
+import { HubUsage, parseUsage } from "./HubUsage";
+
+const report = {
+  request_count: 12,
+  succeeded: 10,
+  failed: 1,
+  in_flight: 1,
+  prompt_tokens: 1200,
+  completion_tokens: 340,
+  total_tokens: 1540,
+};
+
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+
+it("shows counts and tokens without inventing a price", async () => {
+  vi.stubGlobal("fetch", vi.fn().mockResolvedValue(Response.json(report)));
+  render(<HubUsage />);
+  expect(await screen.findByText("12 次")).toBeTruthy();
+  expect(screen.getByText("10 / 1")).toBeTruthy();
+  expect(screen.getByText("1,540")).toBeTruthy();
+  expect(screen.getByText(/不是账单/)).toBeTruthy();
+});
+
+it("says the service lacks usage instead of showing zeros", async () => {
+  vi.stubGlobal(
+    "fetch",
+    vi.fn().mockResolvedValue(Response.json({ detail: "x" }, { status: 404 })),
+  );
+  render(<HubUsage />);
+  expect(await screen.findByRole("alert")).toHaveProperty(
+    "textContent",
+    expect.stringContaining("尚未提供用量统计"),
+  );
+});
+
+it("rejects a partial report rather than treating missing fields as zero", () => {
+  expect(() => parseUsage({ request_count: 1 })).toThrow("usage_response_invalid");
+  expect(parseUsage(report)).toEqual(report);
+});
+
+it("refreshes on demand", async () => {
+  const fetcher = vi.fn().mockResolvedValue(Response.json(report));
+  vi.stubGlobal("fetch", fetcher);
+  render(<HubUsage />);
+  await screen.findByText("12 次");
+  await userEvent.click(screen.getByRole("button", { name: "刷新用量" }));
+  await waitFor(() => expect(fetcher).toHaveBeenCalledTimes(2));
+});
