@@ -0,0 +1,303 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { createTraceId } from "./api";
+import {
+  appendPreview,
+  executeForget,
+  type ForgetPreview,
+  type ForgetResult,
+  GovernanceError,
+  type PendingForget,
+  pendingKey,
+  previewForget,
+  readPending,
+} from "./hub-governance";
+import { R6Button } from "./R6Controls";
+
+const reasons: Record<string, string> = {
+  selected: "所选记忆",
+  evolution: "关联版本",
+  source: "来源原文",
+  derived: "由来源产生",
+};
+export function HubGovernance({
+  instance,
+  scope,
+  recordId,
+  onClose,
+  onCompleted,
+}: {
+  instance: string;
+  scope: string;
+  recordId: string | null;
+  onClose(): void;
+  onCompleted(result: ForgetResult): void;
+}) {
+  const [preview, setPreview] = useState<ForgetPreview | null>(null);
+  const [pending, setPending] = useState<PendingForget | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [confirmed, setConfirmed] = useState(false);
+  const [error, setError] = useState("");
+  const [storageError, setStorageError] = useState(false);
+  const [changed, setChanged] = useState(false);
+  const controller = useRef<AbortController | null>(null);
+  const alive = useRef(true);
+  const target = useRef<string | null>(recordId);
+  const load = useCallback(
+    async (previous?: ForgetPreview) => {
+      const selectedId = target.current;
+      if (!selectedId) return;
+      controller.current?.abort();
+      const current = new AbortController();
+      controller.current = current;
+      setBusy(true);
+      setError("");
+      setConfirmed(false);
+      if (!previous) setPreview(null);
+      try {
+        const page = await previewForget(
+          scope,
+          selectedId,
+          previous?.next_offset ?? 0,
+          previous?.view_digest,
+          current.signal,
+        );
+        if (alive.current && !current.signal.aborted)
+          setPreview(previous ? appendPreview(previous, page) : page);
+      } catch (reason) {
+        if (alive.current && !current.signal.aborted) {
+          setError(
+            reason instanceof GovernanceError
+              ? reason.message
+              : "无法读取影响范围，请检查连接后重新预览。",
+          );
+          setPreview(null);
+        }
+      } finally {
+        if (alive.current && !current.signal.aborted) setBusy(false);
+      }
+    },
+    [scope],
+  );
+  useEffect(() => {
+    alive.current = true;
+    try {
+      const stored = readPending(instance, scope);
+      target.current = stored?.request.record_ids[0] ?? recordId;
+      setPending(stored);
+      if (target.current && !stored) void load();
+    } catch {
+      setStorageError(true);
+    }
+    return () => {
+      alive.current = false;
+      controller.current?.abort();
+    };
+  }, [instance, scope, recordId, load]);
+
+  async function execute(existing?: PendingForget) {
+    if (busy || storageError) return;
+    let operation = existing;
+    if (!operation) {
+      if (!preview || !target.current || !confirmed || !eligible) return;
+      operation = {
+        version: 1,
+        instance,
+        request: {
+          scope_id: scope,
+          action: "forget",
+          record_ids: [target.current],
+          expected_view: preview.view_digest,
+          operation_id: createTraceId(),
+        },
+        total: preview.total,
+        memoryCount: preview.memory_count,
+        rawCount: preview.raw_count,
+      };
+      try {
+        sessionStorage.setItem(
+          pendingKey(instance, scope),
+          JSON.stringify(operation),
+        );
+      } catch {
+        setStorageError(true);
+        return;
+      }
+      setPending(operation);
+    }
+    controller.current?.abort();
+    const current = new AbortController();
+    controller.current = current;
+    setBusy(true);
+    setError("");
+    setChanged(false);
+    try {
+      const result = await executeForget(operation, current.signal);
+      if (!alive.current || current.signal.aborted) return;
+      try {
+        sessionStorage.removeItem(pendingKey(instance, scope));
+      } catch {
+        setStorageError(true);
+        return;
+      }
+      setPending(null);
+      setPreview(null);
+      onCompleted(result);
+    } catch (reason) {
+      if (alive.current && !current.signal.aborted) {
+        setError(
+          reason instanceof GovernanceError
+            ? reason.message
+            : "连接中断，执行结果尚未确认。请核对原操作。",
+        );
+        setChanged(
+          reason instanceof GovernanceError &&
+            reason.code === "governance_preview_changed",
+        );
+      }
+    } finally {
+      if (alive.current && !current.signal.aborted) setBusy(false);
+    }
+  }
+  function restart() {
+    if (!changed) return;
+    try {
+      sessionStorage.removeItem(pendingKey(instance, scope));
+    } catch {
+      setStorageError(true);
+      return;
+    }
+    setPending(null);
+    setChanged(false);
+    setConfirmed(false);
+    void load();
+  }
+  const complete =
+    preview &&
+    preview.next_offset === null &&
+    preview.items.length === preview.total &&
+    preview.items.some((item) => item.record_id === target.current);
+  const unsupported = preview?.items.some((item) =>
+    /^(cmhp:|cmht:|cmhc:|cmhv:)/.test(item.record_id),
+  );
+  const eligible =
+    complete && !unsupported && preview?.unresolved_origin_count === 0;
+  if (!recordId && !pending && !storageError && !preview && !busy) return null;
+  return (
+    <section className="hub-card hub-governance" aria-label="忘记记忆">
+      <h2>{pending ? "核对忘记操作" : "忘记的影响范围"}</h2>
+      <p>
+        忘记会停止自动使用和再次自动提炼这些内容；原始历史仍可按 ID
+        主动查阅。已经发送给 Agent 的内容无法撤回。
+      </p>
+      {storageError ? (
+        <p role="alert">
+          浏览器无法保留或读取操作回执。当前未发起新的操作，请先恢复此站点的会话存储，再核对原操作。
+        </p>
+      ) : (
+        <>
+          {pending ? (
+            <>
+              <p>
+                原操作涉及 {pending.memoryCount} 条记忆和 {pending.rawCount}{" "}
+                条原文。结果尚未确认，不会另建请求。
+              </p>
+              <p>
+                操作编号：<code>{pending.request.operation_id}</code>
+              </p>
+              <R6Button pending={busy} onClick={() => void execute(pending)}>
+                核对并继续原操作
+              </R6Button>
+              {changed && (
+                <R6Button disabled={busy} onClick={restart}>
+                  重新预览并确认
+                </R6Button>
+              )}
+            </>
+          ) : (
+            <>
+              {busy && <p role="status">正在读取影响范围…</p>}
+              {preview && (
+                <>
+                  <p>
+                    影响 {preview.memory_count} 条记忆、{preview.raw_count}{" "}
+                    条原文；已展示 {preview.items.length} / {preview.total} 项。
+                  </p>
+                  <ul className="hub-impact-list">
+                    {preview.items.map((item) => (
+                      <li key={item.record_id}>
+                        <strong>
+                          {item.kind === "memory" ? "记忆" : "原文"} ·{" "}
+                          {item.reasons
+                            .map((reason) => reasons[reason])
+                            .join("、")}
+                        </strong>
+                        <p>
+                          {item.content}
+                          {item.content_truncated ? "…（预览已截短）" : ""}
+                        </p>
+                        <small>
+                          {item.proposed_effect === "retain_for_explicit_read"
+                            ? "保留原文供主动查阅"
+                            : "停止自动使用"}
+                        </small>
+                      </li>
+                    ))}
+                  </ul>
+                  {preview.next_offset !== null && (
+                    <R6Button
+                      disabled={busy}
+                      onClick={() => void load(preview)}
+                    >
+                      继续查看影响范围
+                    </R6Button>
+                  )}
+                  {unsupported && (
+                    <p role="alert">
+                      范围内包含暂不支持忘记的工作或编程记录，不能继续执行。
+                    </p>
+                  )}
+                  {preview.unresolved_origin_count > 0 && (
+                    <p role="alert">
+                      有 {preview.unresolved_origin_count}{" "}
+                      条记忆缺少来源证明，暂时不能执行。
+                    </p>
+                  )}
+                  <p>
+                    此预览是当前观察结果。确认后服务会重新校验范围和执行条件；条件不足时会拒绝，不会显示为完成。
+                  </p>
+                  <label>
+                    <input
+                      type="checkbox"
+                      checked={confirmed}
+                      disabled={!eligible || busy}
+                      onChange={(event) => setConfirmed(event.target.checked)}
+                    />
+                    我已查看全部影响范围，同意停止自动使用这些内容。
+                  </label>
+                  <R6Button
+                    variant="primary"
+                    disabled={!eligible || !confirmed || busy}
+                    onClick={() => void execute()}
+                  >
+                    确认忘记
+                  </R6Button>
+                </>
+              )}
+              {!preview && !busy && (
+                <R6Button onClick={() => void load()}>重新预览</R6Button>
+              )}
+              <R6Button variant="quiet" disabled={busy} onClick={onClose}>
+                取消
+              </R6Button>
+            </>
+          )}
+          {error && <p role="alert">{error}</p>}
+        </>
+      )}
+      <p>
+        彻底删除还会清除 Hub
+        内的相关正文。当前预览尚不能证明所有副本可清理，网页暂不提供此操作。
+      </p>
+    </section>
+  );
+}
