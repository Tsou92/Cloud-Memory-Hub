 def _source_writes_on(app: FastAPI, source_id: str) -> bool:
     """Whether this source's conversations may become memories."""
+    # An embedding runtime can own non-filesystem sources without granting
+    # them local import roots. None retains the original source policy.
+    authorizer = getattr(app.state, "source_write_authorizer", None)
+    if authorizer is not None:
+        try:
+            decision = authorizer(source_id)
+        except Exception:
+            return False
+        if decision is not None:
+            return decision is True
