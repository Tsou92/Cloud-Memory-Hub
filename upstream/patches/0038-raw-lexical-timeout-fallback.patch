diff --git a/memhub/apps/core/tests/test_context_search_both_paths.py b/memhub/apps/core/tests/test_context_search_both_paths.py
--- a/memhub/apps/core/tests/test_context_search_both_paths.py
+++ b/memhub/apps/core/tests/test_context_search_both_paths.py
@@ -9,8 +9,11 @@

 from __future__ import annotations

+import asyncio
 import sqlite3
+import threading
 import uuid
+from types import SimpleNamespace

 import pytest
 from httpx import ASGITransport, AsyncClient
@@ -159,3 +162,122 @@
     assert document["paths"]["raw"]["status"] == "not_requested", "raw must not run"
     contents = [item["content"] for item in document["items"]]
     assert memory in contents, "memory path must return the governed memory"
+
+
+@pytest.mark.parametrize(
+    "case", ["lexical", "semantic_only", "changed", "lexical_pending", "semantic_timeout"]
+)
+def test_raw_timeout_preserves_only_ready_and_finally_validated_lexical_hits(
+    tmp_path, monkeypatch, case
+):
+    from one_memory import context_routes
+    from one_memory.background_work import (
+        raw_read_pool,
+        wait_for_interactive_reads,
+        warm_reader,
+    )
+    from one_memory.retrieval import raw_lane
+    from one_memory.retrieval.index_store import PublishedChunk
+    from one_memory.retrieval.raw_candidates import RawCandidateBatch, RawSemanticCandidate
+
+    entered, release = threading.Event(), threading.Event()
+    lexical_reads, finalized, fallback_metadata = [], [], []
+    read = raw_lane.read_raw_context
+    revalidate = context_routes.revalidate_raw_context
+    fuse = context_routes.fuse_raw_lane
+
+    def block():
+        entered.set()
+        assert release.wait(5), "the test must release its worker"
+
+    def observed_read(*args, **kwargs):
+        lexical_reads.append(1)
+        if case == "lexical_pending":
+            block()
+        return read(*args, **kwargs)
+
+    def slow_semantic(*args, **kwargs):
+        if case == "semantic_timeout":
+            entered.set()
+            chunk = PublishedChunk(
+                chunk_id="synthetic-chunk",
+                build_id="synthetic-build",
+                evidence_id="synthetic-candidate",
+                revision=1,
+                start_cp=0,
+                end_cp=1,
+                ordinal=0,
+                source_id="codex",
+                event_time=None,
+            )
+            return RawCandidateBatch(hits=(RawSemanticCandidate(chunk, 0.1),)), False
+        block()
+        return RawCandidateBatch(complete=True, reason="no_eligible_chunks"), False
+
+    def semantic_load_timeout(*args, **kwargs):
+        raise TimeoutError("synthetic semantic hydration deadline")
+
+    def observed_fallback(*args, **kwargs):
+        result = fuse(*args, **kwargs)
+        fallback_metadata.append((result.semantic_status, result.index_complete))
+        return result
+
+    def observed_finalizer(database, items, **kwargs):
+        finalized.append(len(items))
+        return revalidate(database, items, **kwargs)
+
+    async def scenario():
+        app, data_dir, client = _client(tmp_path)
+        async with app.router.lifespan_context(app), client:
+            verbatim, _ = _seed(data_dir)
+            await warm_reader(raw_read_pool())
+            with monkeypatch.context() as patch:
+                patch.setattr(raw_lane, "read_raw_context", observed_read)
+                patch.setattr(context_routes, "revalidate_raw_context", observed_finalizer)
+                patch.setattr(context_routes, "fuse_raw_lane", observed_fallback)
+                if case == "semantic_timeout":
+                    patch.setattr(raw_lane, "load_raw_items_from_candidates", semantic_load_timeout)
+                patch.setattr(
+                    app.state,
+                    "retrieval_runtime",
+                    SimpleNamespace(lookup_raw=slow_semantic),
+                    raising=False,
+                )
+                query = "unmatched-synthetic-query" if case == "semantic_only" else verbatim
+                pending = asyncio.create_task(
+                    client.post("/api/v1/context/search", json={"query": query, "kinds": ["raw"]})
+                )
+                try:
+                    assert await asyncio.to_thread(entered.wait, 2)
+                    if case == "changed":
+                        with sqlite3.connect(data_dir / "one-memory.sqlite3") as db:
+                            db.execute("UPDATE evidence SET revision=revision+1")
+                    # The response must finish while optional native work is blocked.
+                    response = await asyncio.wait_for(pending, 2)
+                    assert not release.is_set()
+                finally:
+                    release.set()
+                    if not pending.done():
+                        pending.cancel()
+                        await asyncio.gather(pending, return_exceptions=True)
+                    await asyncio.wait_for(wait_for_interactive_reads(), 5)
+            response.raise_for_status()
+            body = response.json()
+            texts = [message["text"] for item in body["items"] for message in item["messages"]]
+            assert len(lexical_reads) == 1, "timeout fallback must not repeat the lexical scan"
+            assert fallback_metadata == (
+                [] if case == "lexical_pending" else [("timed_out", False)]
+            )
+            if case in {"lexical", "semantic_timeout"}:
+                assert verbatim in texts
+                assert finalized == [1]
+                assert body["paths"]["raw"]["reason"] == "lexical_only"
+            else:
+                assert texts == []
+                assert finalized == ([1] if case == "changed" else [0])
+                if case == "lexical_pending":
+                    assert body["paths"]["raw"]["reason"] == "timeout_budget"
+                if case == "changed":
+                    assert body["paths"]["raw"]["reason"] == "evidence_changed"
+
+    asyncio.run(scenario())
