--- /dev/null
+++ b/tests/test_file_log_lifecycle.py
@@ -0,0 +1,702 @@
+"""Actual native handler/file maintenance, using synthetic content only."""
+
+from __future__ import annotations
+
+import gc
+import io
+import json
+import logging
+import os
+import threading
+import time
+import weakref
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+import pytest
+
+from hy_memory.utils import diagnostic_policy as policy
+from hy_memory.utils import file_log_lifecycle as lifecycle
+from hy_memory.utils import log_setup
+
+
+@pytest.fixture(autouse=True)
+def isolation(tmp_path, monkeypatch):
+    logger = logging.getLogger("hy_memory")
+    old = logger.handlers[:], logger.level, logger.propagate
+    root_handlers = logging.root.handlers[:]
+    before = {h for ref in logging._handlerList if (h := ref()) is not None}
+    monkeypatch.setattr(log_setup, "_logging_configured", False)
+    monkeypatch.setattr(policy, "_STRICT", False)
+    monkeypatch.setattr(policy, "_RESOURCES", weakref.WeakKeyDictionary())
+    monkeypatch.setattr(policy, "_KNOWN_SOURCES", {})
+    monkeypatch.setenv("MEMORY_LOG_DIR", str(tmp_path / "logs"))
+    logger.handlers = []
+    yield
+    assert policy._FILE_MAINTENANCE_OWNER is None
+    logger.handlers, logger.level, logger.propagate = old
+    logging.root.handlers = root_handlers
+    for ref in logging._handlerList[:]:
+        handler = ref()
+        if handler is not None and handler not in before:
+            handler.close()
+    gc.collect()
+
+
+def native(tmp_path):
+    log_setup.setup_logging(str(tmp_path / "logs"))
+    logger = logging.getLogger("hy_memory")
+    return next(h for h in logger.handlers if isinstance(h, logging.FileHandler))
+
+
+def identity(path):
+    info = path.stat()
+    return info.st_dev, info.st_ino
+
+
+def files(path):
+    return ((path, *identity(path)),)
+
+
+def gate(path, **extra):
+    return lifecycle.diagnostic_file_maintenance(roots=(path.parent,), **extra)
+
+
+def emit(handler, text="synthetic-after"):
+    record = logging.LogRecord(
+        "hy_memory.test", logging.INFO, __file__, 1, text, (), None
+    )
+    handler.handle(record)
+
+
+def streams(path, requests):
+    return {
+        r.token: path.open(r.mode, encoding=r.encoding, errors=r.errors)
+        for r in requests
+    }
+
+
+def replace(lease, path, content=b"retained\n"):
+    requested = lease.suspend(path)
+    stage = path.with_suffix(".stage")
+    stage.write_bytes(content)
+    os.replace(stage, path)
+    lease.adopt(path, streams(path, requested), identity=identity(path))
+    lease.verify_bound(files(path))
+
+
+def test_real_replace_preserves_handler_configuration_and_writes_new_inode(tmp_path):
+    handler = native(tmp_path)
+    path = Path(handler.baseFilename)
+    emit(handler, "synthetic-before")
+    before_identity = identity(path)
+    state = (
+        id(handler),
+        handler.formatter,
+        handler.filters[:],
+        handler.level,
+        handler.rolloverAt,
+        handler.mode,
+        handler.encoding,
+        handler.errors,
+    )
+    with gate(path) as lease:
+        lease.require_bound(files(path))
+        replace(lease, path)
+    assert identity(path) != before_identity
+    assert (
+        id(handler),
+        handler.formatter,
+        handler.filters[:],
+        handler.level,
+        handler.rolloverAt,
+        handler.mode,
+        handler.encoding,
+        handler.errors,
+    ) == state
+    assert identity(path) == (
+        os.fstat(handler.stream.fileno()).st_dev,
+        os.fstat(handler.stream.fileno()).st_ino,
+    )
+    emit(handler)
+    assert b"synthetic-before" not in path.read_bytes()
+    assert b"retained\n" in path.read_bytes()
+    assert b"synthetic-after" in path.read_bytes()
+
+
+def test_no_handlers_pipeline_only_is_supported(tmp_path):
+    path = tmp_path / "pipeline.log"
+    path.write_bytes(b"synthetic-before\n")
+    with gate(path) as lease:
+        lease.require_bound(files(path))
+        replace(lease, path)
+    assert path.read_bytes() == b"retained\n"
+
+
+@pytest.mark.parametrize("detached", [False, True])
+def test_unowned_file_handler_rejected_before_any_stream_changes(tmp_path, detached):
+    native_handler = native(tmp_path)
+    path = Path(native_handler.baseFilename)
+    caller = logging.FileHandler(path)
+    caller._hy_memory_diagnostic_handler = True  # Forging this must not help.
+    if not detached:
+        logging.getLogger("hy_memory").addHandler(caller)
+    old_fd = caller.stream.fileno()
+    before = path.read_bytes()
+    with pytest.raises(policy.DiagnosticPolicyError, match="unsupported"):
+        with gate(path, detached_handlers=(caller,) if detached else ()):
+            pytest.fail("uncontrolled handler accepted")
+    assert caller.stream.fileno() == old_fd
+    assert path.read_bytes() == before
+    emit(native_handler)
+    assert b"synthetic-after" in path.read_bytes()
