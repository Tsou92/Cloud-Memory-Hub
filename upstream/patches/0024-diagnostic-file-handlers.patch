index 0000000..315f36e
--- /dev/null
+++ b/hy_memory/utils/file_log_lifecycle.py
@@ -0,0 +1,430 @@
+"""Synchronous maintenance of SDK-owned file handlers (ADR-0043).
+
+This is an I/O coordination gate, not record deletion authority. The caller
+must hold SDK admission and drain pipeline work before entering, and must keep
+its entire file transaction on this thread. Arbitrary later Python logging
+configuration/raw file opens are outside the dedicated-process contract.
+"""
+
+from __future__ import annotations
+
+import io
+import logging
+import os
+import stat
+import threading
+import weakref
+from contextlib import contextmanager
+from dataclasses import dataclass
+from logging.handlers import TimedRotatingFileHandler
+from pathlib import Path
+from typing import TextIO
+
+try:
+    import fcntl
+except ImportError:  # Normal SDK logging still works on non-POSIX platforms.
+    fcntl = None
+
+from . import diagnostic_policy as policy
+
+_BUSY = "diagnostic_file_logging_busy"
+_UNSUPPORTED = "diagnostic_file_logging_unsupported"
+_MISMATCH = "diagnostic_file_logging_mismatch"
+_REOPEN = "diagnostic_file_logging_reopen_required"
+
+
+@dataclass
+class _SinkState:
+    sealed: bool = False
+    needs_rebind: bool = False
+
+
+# Membership comes only from our factory; public ownership flags are not proof.
+_SINKS: weakref.WeakKeyDictionary = weakref.WeakKeyDictionary()
+
+
+class _ManagedTimedRotatingFileHandler(TimedRotatingFileHandler):
+    def emit(self, record):
+        state = _SINKS.get(self)
+        if state is not None and state.sealed:
+            return
+        super().emit(record)
+
+
+@policy.locked_diagnostic_setup
+def _create_sdk_file_handler(**kwargs):
+    path = Path(os.path.abspath(kwargs["filename"]))
+    if any(state.needs_rebind and _filename(h) == path for h, state in _SINKS.items()):
+        _fail(_REOPEN)
+    handler = _ManagedTimedRotatingFileHandler(**kwargs)
+    _SINKS[handler] = _SinkState()
+    return handler
+
+
+@dataclass(frozen=True)
+class StreamRequest:
+    """Ephemeral stream token; never persist it in the cleanup manifest."""
+
+    token: int
+    mode: str
+    encoding: str | None
+    errors: str | None
+
+
+def _fail(code):
+    raise policy.DiagnosticPolicyError(code) from None
+
+
+def _path(value):
+    if not isinstance(value, Path) or not value.is_absolute():
+        _fail(_UNSUPPORTED)
+    return Path(os.path.abspath(value))
+
+
+def _inside(path, roots):
+    return any(path == root or root in path.parents for root in roots)
+
+
+def _stream_identity(stream):
+    if type(stream) is not io.TextIOWrapper:
+        _fail(_UNSUPPORTED)
+    try:
+        info = os.fstat(stream.fileno())
+    except (OSError, ValueError):
+        _fail(_MISMATCH)
+    if not stat.S_ISREG(info.st_mode):
+        _fail(_UNSUPPORTED)
+    return info
+
+
+@contextmanager
+def _registry():
+    lock = logging._lock
+    if lock._is_owned() or not lock.acquire(False):
+        _fail(_BUSY)
+    try:
+        yield
+    finally:
+        lock.release()
+
+
+def _handlers(detached):
+    # Called with the registry lock. Retain strong references until exit.
+    result = {h for ref in logging._handlerList if (h := ref()) is not None}
+    result.update(logging.root.handlers)
+    for logger in logging.root.manager.loggerDict.values():
+        if isinstance(logger, logging.Logger):
+            result.update(logger.handlers)
+    result.update(detached)
+    result.update(_SINKS)
+    return tuple(result)
+
+
+def _filename(handler):
+    value = vars(handler).get("baseFilename")
+    if type(value) is not str:
+        _fail(_UNSUPPORTED)
+    return _path(Path(value))
+
+
+def _lock(handler):
+    lock = vars(handler).get("lock")
+    if not callable(getattr(lock, "_is_owned", None)):
+        _fail(_UNSUPPORTED)
+    if lock._is_owned() or not lock.acquire(False):
+        _fail(_BUSY)
+    return lock
+
+
+class FileHandlerLease:
+    """Only the context manager creates active leases; not an authorization."""
+
+    def __init__(self, roots, detached):
+        self._roots = roots
+        self._detached = detached
+        self._thread = threading.get_ident()
+        self._active = False
+        self._handlers = ()
+        self._locks = []
+        self._initial = {}
+        self._suspended = {}
+        self._adopted = set()
+        self._verified = False
+        self._bound = {}
+
+    def _check(self):
+        if not self._active or self._thread != threading.get_ident():
+            _fail(_UNSUPPORTED)
+
+    def _snapshot(self, identities=()):
+        handlers = _handlers(self._detached)
+        targets = []
+        for handler in handlers:
+            if not isinstance(handler, logging.FileHandler):
+                self._check_stream_handler(handler, identities)
+                continue
+            path = _filename(handler)
+            relevant = _inside(path, self._roots)
+            stream = vars(handler).get("stream")
+            # Outside-root aliases are checked against the engine's inventory.
+            if not relevant and identities and stream is not None:
+                if type(stream) is not io.TextIOWrapper:
+                    _fail(_UNSUPPORTED)
+                if not stream.closed:
+                    try:
+                        info = os.fstat(stream.fileno())
+                    except (OSError, ValueError):
+                        _fail(_MISMATCH)
+                    relevant = (
+                        stat.S_ISREG(info.st_mode)
+                        and (info.st_dev, info.st_ino) in identities
+                    )
+            if not relevant:
+                continue
+            if (
+                handler in self._detached
+                or not _inside(path, self._roots)
+                or type(handler) is not _ManagedTimedRotatingFileHandler
+                or handler not in _SINKS
+            ):
+                _fail(_UNSUPPORTED)
+            targets.append(handler)
+        return tuple(sorted(targets, key=lambda h: (_filename(h), id(h))))
+
+    def _check_stream_handler(self, handler, identities):
+        # A plain StreamHandler can also own a real file descriptor. Inspect
+        # standard streams only; do not execute arbitrary caller fileno/repr.
+        stream = vars(handler).get("stream")
+        if type(stream) is not io.TextIOWrapper or stream.closed:
+            return
+        try:
+            info = os.fstat(stream.fileno())
+        except (OSError, ValueError):
+            _fail(_MISMATCH)
+        if not stat.S_ISREG(info.st_mode):
+            return
+        name = stream.name
+        path_hit = type(name) is str and _inside(
+            Path(os.path.abspath(name)), self._roots
+        )
+        if path_hit or (info.st_dev, info.st_ino) in identities:
+            _fail(_UNSUPPORTED)
+
+    def _enter(self):
+        if (
+            not policy._LOCK._is_owned()
+            or policy._FILE_MAINTENANCE_OWNER != threading.get_ident()
+        ):
+            _fail(_UNSUPPORTED)
+        self._active = True
+        with _registry():
+            self._handlers = self._snapshot()
+            for handler in self._handlers:
+                self._locks.append(_lock(handler))
+                if (
+                    handler.mode != "a"
+                    or handler.namer is not None
+                    or handler.rotator is not None
+                ):
+                    _fail(_UNSUPPORTED)
+                if handler.stream is not None and not handler.stream.closed:
+                    _stream_identity(handler.stream)
+            for handler in self._handlers:
+                state = _SINKS[handler]
+                self._initial[handler] = state.sealed
+                state.sealed = True
+
+    def _files(self, files):
+        if type(files) is not tuple or len(files) > 4096:
+            _fail(_UNSUPPORTED)
+        result = {}
+        for item in files:
+            if type(item) is not tuple or len(item) != 3:
+                _fail(_UNSUPPORTED)
+            path, device, inode = item
+            path = _path(path)
+            if (
+                not _inside(path, self._roots)
+                or type(device) is not int
+                or type(inode) is not int
+                or device < 0
+                or inode <= 0
+            ):
+                _fail(_UNSUPPORTED)
+            result.setdefault(path, set()).add((device, inode))
+        return result
+
+    def _recheck(self, files):
+        identities = {identity for values in files.values() for identity in values}
+        with _registry():
+            if self._snapshot(identities) != self._handlers:
+                _fail(_MISMATCH)
+
+    def require_bound(self, files: tuple[tuple[Path, int, int], ...]) -> None:
+        """Reject aliases/uncontrolled sinks before any destructive I/O."""
+        self._check()
+        expected = self._files(files)
+        self._recheck(expected)
+        for handler in self._handlers:
+            stream = handler.stream
+            if stream is None or stream.closed:
+                if _SINKS[handler].needs_rebind:
+                    continue  # A previous failed maintenance can be repaired.
+                if handler._closed:
+                    continue  # Dormant; future emit will open the current name.
+                _fail(_MISMATCH)
+            info = _stream_identity(stream)
+            if (info.st_dev, info.st_ino) not in expected.get(_filename(handler), ()):
+                _fail(_MISMATCH)
+        self._bound = expected
+
+    def suspend(self, path: Path) -> tuple[StreamRequest, ...]:
+        """Flush/close streams, preserving handler identity and rollover state."""
+        self._check()
+        path = _path(path)
+        if path not in self._bound or path in self._suspended:
+            _fail(_UNSUPPORTED)
+        self._recheck({})
+        handlers = tuple(
+            h
+            for h in self._handlers
+            if _filename(h) == path
+            and (not h._closed or h.stream is not None or _SINKS[h].needs_rebind)
+        )
+        self._suspended[path] = handlers
+        self._verified = False
+        for handler in handlers:
+            _SINKS[handler].needs_rebind = True
+        try:
+            for handler in handlers:
+                stream = handler.stream
+                if stream is not None:
+                    if not stream.closed:
+                        _stream_identity(stream)
+                        stream.flush()
+                        stream.close()
+                    handler.stream = None
+        except Exception:
+            _fail(_REOPEN)
+        return tuple(
+            StreamRequest(id(h), h.mode, h.encoding, h.errors) for h in handlers
+        )
+
+    def adopt(
+        self, path: Path, replacements: dict[int, TextIO], *, identity: tuple[int, int]
+    ) -> None:
+        """Validate ALL streams before taking ownership. Never opens a path."""
+        self._check()
+        path = _path(path)
+        handlers = self._suspended.get(path)
+        if (
+            handlers is None
+            or path in self._adopted
+            or type(replacements) is not dict
+            or set(replacements) != {id(h) for h in handlers}
+            or type(identity) is not tuple
+            or len(identity) != 2
+            or any(type(v) is not int for v in identity)
+        ):
+            _fail(_UNSUPPORTED)
+        self._recheck({path: {identity}})
+        if fcntl is None:
+            _fail(_UNSUPPORTED)
+        streams = []
+        for handler in handlers:
+            stream = replacements[id(handler)]
+            info = _stream_identity(stream)
+            if (
+                handler.stream is not None
+                or (info.st_dev, info.st_ino) != identity
+                or info.st_nlink != 1
+                or not stream.writable()
+                or not (fcntl.fcntl(stream.fileno(), fcntl.F_GETFL) & os.O_APPEND)
+                or stream.encoding != handler.encoding
+                or stream.errors != (handler.errors or "strict")
+            ):
+                _fail(_MISMATCH)
+            if stream in streams:
+                _fail(_MISMATCH)
+            streams.append(stream)
+        for handler, stream in zip(handlers, streams):
+            handler.stream = stream
+        self._adopted.add(path)
+
+    def verify_bound(self, files: tuple[tuple[Path, int, int], ...]) -> None:
+        """Verify the current inode set before the caller completes its pass."""
+        self._check()
+        if set(self._suspended) != self._adopted:
+            _fail(_REOPEN)
+        repaired = {h for handlers in self._suspended.values() for h in handlers}
+        if any(_SINKS[h].needs_rebind and h not in repaired for h in self._handlers):
+            _fail(_REOPEN)
+        expected = self._files(files)
+        if any(len(values) != 1 for values in expected.values()):
+            _fail(_MISMATCH)
+        for path, handlers in self._suspended.items():
+            if path not in expected:
+                _fail(_MISMATCH)
+            for handler in handlers:
+                if handler.stream is None or handler.stream.closed:
+                    _fail(_REOPEN)
+                if _stream_identity(handler.stream).st_nlink != 1:
+                    _fail(_MISMATCH)
+        self.require_bound(files)
+        self._verified = True
+
+    def _leave(self, successful):
+        incomplete = bool(self._suspended) and not self._verified
+        for handler, initially_sealed in self._initial.items():
+            state = _SINKS[handler]
+            touched = any(handler in hs for hs in self._suspended.values())
+            if touched:
+                if successful and self._verified:
+                    state.needs_rebind = False
+                    state.sealed = False
+                else:
+                    state.sealed = True
+            else:
+                state.sealed = initially_sealed
+        self._active = False
+        for lock in reversed(self._locks):
+            lock.release()
+        if successful and incomplete:
+            _fail(_REOPEN)
+
+
+@contextmanager
+def diagnostic_file_maintenance(*, roots: tuple[Path, ...], detached_handlers=()):
+    """Try-lock native setup + related handler I/O, entirely on one thread.
+
+    The registry lock is held only for snapshots; it is never retained while
+    the engine performs SQL/file I/O. Unknown/detached file sinks fail closed.
+    This does not control arbitrary concurrent third-party FileHandler creation.
+    """
+    if type(roots) is not tuple or not roots or len(roots) > 16:
+        _fail(_UNSUPPORTED)
+    normalized = tuple(sorted(set(_path(root) for root in roots)))
+    if type(detached_handlers) not in (tuple, list, set, frozenset):
+        _fail(_UNSUPPORTED)
+    detached = tuple(detached_handlers)
+    if len(detached) > 4096 or any(
+        not isinstance(h, logging.Handler) for h in detached
+    ):
+        _fail(_UNSUPPORTED)
+    lock = policy._LOCK
+    if lock._is_owned() or not lock.acquire(False):
+        _fail(_BUSY)
+    lease = FileHandlerLease(normalized, detached)
+    succeeded = False
+    try:
+        policy.require_diagnostic_setup_available()
+        policy._FILE_MAINTENANCE_OWNER = threading.get_ident()
+        lease._enter()
+        yield lease
+        succeeded = True
+    finally:
+        try:
+            lease._leave(succeeded)
+        finally:
+            policy._FILE_MAINTENANCE_OWNER = None
+            lock.release()
