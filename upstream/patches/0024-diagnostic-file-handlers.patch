+@pytest.mark.parametrize("stage", ["flush", "close"])
+def test_actual_stream_failure_remains_sealed_and_repairable(tmp_path, stage):
+    handler = native(tmp_path)
+    path = Path(handler.baseFilename)
+    handler.stream.close()
+
+    class FaultingFile(io.FileIO):
+        fail = True
+
+        def flush(self):
+            if stage == "flush" and self.fail:
+                raise OSError("synthetic-private-io-detail")
+            return super().flush()
+
+        def close(self):
+            if stage == "close" and self.fail:
+                raise OSError("synthetic-private-io-detail")
+            return super().close()
+
+    raw = FaultingFile(path, "ab")
+    stream = io.TextIOWrapper(raw, encoding=handler.encoding)
+    handler.stream = stream
+    with pytest.raises(
+        policy.DiagnosticPolicyError, match="^diagnostic_file_logging_reopen_required$"
+    ):
+        with gate(path) as lease:
+            lease.require_bound(files(path))
+            lease.suspend(path)
+    assert not stream.closed
+    before = path.read_bytes()
+    emit(handler, "must-remain-sealed")
+    assert path.read_bytes() == before
+    raw.fail = False
+    with gate(path) as lease:
+        lease.require_bound(files(path))
+        requested = lease.suspend(path)
+        assert stream.closed
+        lease.adopt(path, streams(path, requested), identity=identity(path))
+        lease.verify_bound(files(path))
+    emit(handler)
+    assert b"synthetic-after" in path.read_bytes()
+
