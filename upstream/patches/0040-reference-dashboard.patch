+        {memories.data?.items.map((item) => (
+          <p key={item.record_id}>{item.content}</p>
+        ))}
+        {memories.data?.candidate_limit_reached ? (
+          <p>还有候选内容尚未检查，请到记忆库继续查看。</p>
+        ) : null}
+        {!memories.loading && emptyMemories ? (
+          <p>当前项目尚无可显示的记忆。</p>
+        ) : null}
+        <button
+          type="button"
+          className="hub-card-link"
+          onClick={() => onNavigate("library")}
+        >
+          打开记忆库 <ArrowRight size={15} />
+        </button>
+        {emptyMemories ? firstMemoryGuide : null}
+      </details>
+    </div>
+  );
+}
+function CardHeading({
+  title,
+  action,
+  badge,
+  onClick,
+}: {
+  title: string;
+  action?: string;
+  badge?: string;
+  onClick?: () => void;
+}) {
+  return (
+    <div className="hub-card-heading">
+      <h2>{title}</h2>
+      {onClick ? (
+        <button
+          type="button"
+          className="hub-card-action"
+          aria-label={action ? `${action}${title}` : `管理${title}`}
+          onClick={onClick}
+        >
+          {action}
+          <ChevronRight size={16} />
+        </button>
+      ) : badge ? (
+        <span className="hub-card-badge">{badge}</span>
+      ) : null}
+    </div>
+  );
+}
+function Activity({ item, onClick }: { item: HubItem; onClick(): void }) {
+  const display = historyDisplay({
+    raw_id: item.record_id,
+    content: item.content,
+    truncated: item.next_content_offset !== null,
+  });
+  const title =
+    display?.kind === "remember"
+      ? "保存共享记忆"
+      : display?.kind === "handoff"
+        ? "创建任务交接"
+        : display?.kind === "conversation"
+          ? "同步对话记录"
+          : "接纳共享记录";
+  const excerpt =
+    display?.kind === "remember"
+      ? display.text
+      : display?.kind === "handoff"
+        ? display.handoff.goal
+        : display?.kind === "conversation"
+          ? display.messages.at(-1)?.text
+          : (item.source ?? "查看原始记录");
+  const date =
+    item.memory_at === null
+      ? null
+      : new Date(
+          item.memory_at < 1e12 ? item.memory_at * 1000 : item.memory_at,
+        );
+  return (
+    <button className="hub-activity" type="button" onClick={onClick}>
+      <span
+        className={`hub-activity-icon hub-activity-icon--${display?.kind ?? "other"}`}
+      >
+        {display?.kind === "handoff" ? (
+          <MessagesSquare size={18} />
+        ) : display?.kind === "remember" ? (
+          <Sparkles size={18} />
+        ) : (
+          <FileText size={18} />
+        )}
+      </span>
+      <span className="hub-activity-copy">
+        <strong>{title}</strong>
+        <span>{excerpt}</span>
+      </span>
+      <small>
+        {date && Number.isFinite(date.getTime())
+          ? date.toLocaleDateString("zh-CN", {
+              month: "numeric",
+              day: "numeric",
+            })
+          : "时间未提供"}
+      </small>
+    </button>
+  );
+}
+function Service({
+  Icon,
+  title,
+  value,
+  ready,
+}: {
+  Icon: typeof Server;
+  title: string;
+  value: string;
+  ready: boolean;
+}) {
+  return (
+    <div className="hub-service">
+      <Icon size={19} strokeWidth={1.5} />
+      <span>{title}</span>
+      <strong className={ready ? "is-confirmed" : ""}>
+        {ready ? <Check size={13} /> : null}
+        {value}
+      </strong>
+    </div>
+  );
+}
+function ActivityChart({ data }: { data: HubDashboardData["daily_activity"] }) {
+  const id = useId().replace(/:/g, "");
+  const max = Math.max(2, ...data.map((day) => day.count));
+  const points = data.map((day, index) => [
+    42 + index * 57,
+    145 - (day.count / max) * 115,
+  ]);
+  const line = points
+    .map(([x, y], index) => `${index ? "L" : "M"} ${x} ${y}`)
+    .join(" ");
+  return (
+    <div className="hub-activity-chart">
+      <svg
+        viewBox="0 0 420 178"
+        role="img"
+        aria-label={`最近七天共享记录：${data.map((day) => `${day.date} ${day.count} 条`).join("，")}`}
+      >
+        <defs>
+          <linearGradient id={`${id}-fill`} x1="0" y1="0" x2="0" y2="1">
+            <stop stopColor="#a68df8" stopOpacity=".32" />
+            <stop offset="1" stopColor="#a68df8" stopOpacity="0" />
+          </linearGradient>
+        </defs>
+        {[0, 0.5, 1].map((ratio) => (
+          <g key={ratio}>
+            <line
+              x1="42"
+              x2="384"
+              y1={145 - ratio * 115}
+              y2={145 - ratio * 115}
+              stroke="#b5b4dd"
+              strokeOpacity=".1"
+              strokeDasharray="3 5"
+            />
+            <text x="30" y={149 - ratio * 115} textAnchor="end">
+              {Math.ceil(max * ratio)}
+            </text>
+          </g>
+        ))}
+        <path d={`${line} L 384 145 L 42 145 Z`} fill={`url(#${id}-fill)`} />
+        <path
+          d={line}
+          fill="none"
+          stroke="#b4a2ff"
+          strokeWidth="2.8"
+          strokeLinejoin="round"
+        />
+        {points.map(([x, y], index) => (
+          <g key={data[index].date}>
+            <circle
+              cx={x}
+              cy={y}
+              r="3.6"
+              fill="#d0bbff"
+              stroke="#8470c8"
+              strokeWidth="2"
+            >
+              <title>
+                {data[index].date}：{data[index].count} 条
+              </title>
+            </circle>
+            <text x={x} y="170" textAnchor="middle">
+              {data[index].date.slice(5).replace("-", "/")}
+            </text>
+          </g>
+        ))}
+      </svg>
+    </div>
+  );
+}
