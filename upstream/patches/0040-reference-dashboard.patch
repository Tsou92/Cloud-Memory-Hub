+// @vitest-environment jsdom
+import { cleanup, render, screen } from "@testing-library/react";
+import { afterEach, expect, it } from "vitest";
+import { HubNetwork } from "./HubNetwork";
+import type { HubSource } from "./hub-api";
+
+const source = (index: number): HubSource => ({
+  source_id: `source-${index}`,
+  device_id: `device-${index}`,
+  scope_id: "scope",
+  display_name: `真实 Agent ${index}`,
+  adapter_id: "cloud-memory-hub.agent",
+  status: "active",
+  device_status: "active",
+  device_display_name: `合成设备 ${index}`,
+});
+afterEach(cleanup);
+it.each([0, 1, 4, 8, 30])(
+  "renders exactly %i real source nodes with an accessible complete inventory",
+  (count) => {
+    const sources = Array.from({ length: count }, (_, index) => source(index));
+    const { container } = render(<HubNetwork sources={sources} />);
+    expect(container.querySelectorAll("[data-source-id]")).toHaveLength(count);
+    expect(container.querySelectorAll("animateMotion")).toHaveLength(count);
+    expect(
+      screen.getByRole("figure", {
+        name: `Agent 协作网络：${count} 个有效连接`,
+      }),
+    ).toBeTruthy();
+    for (const entry of sources)
+      expect(
+        screen.getByText(
+          `${entry.device_display_name} · ${entry.display_name}`,
+          { selector: "li" },
+        ),
+      ).toBeTruthy();
+    if (count === 0) expect(screen.getByText(/连接第一个 Agent/)).toBeTruthy();
+  },
+);
+it("does not invent a brand from the generic adapter or duplicate a source", () => {
+  const { container } = render(<HubNetwork sources={[source(0), source(0)]} />);
+  expect(container.querySelectorAll("[data-source-id]")).toHaveLength(1);
+  expect(screen.queryByText("Claude Code")).toBeNull();
+  const duration = container
+    .querySelector("animateMotion")
+    ?.getAttribute("dur");
+  expect(Number.parseFloat(duration ?? "0")).toBeGreaterThanOrEqual(3);
+  expect(Number.parseFloat(duration ?? "0")).toBeLessThanOrEqual(5);
+});
