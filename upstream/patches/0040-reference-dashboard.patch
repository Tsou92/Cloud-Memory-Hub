+import { getHubSummary, HubError, type HubSource } from "./hub-api";
+import type { PairDevice } from "./hub-pairing";
+
+const sharingPermissions = new Set([
+  "events:write",
+  "memory:read",
+  "history:read",
+]);
+
+export function effectiveHubSources(
+  sources: HubSource[],
+  devices: PairDevice[],
+  scope: string,
+): HubSource[] {
+  const allowed = new Set(
+    devices
+      .filter(
+        (device) =>
+          device.status === "active" &&
+          device.grants.some(
+            (grant) =>
+              grant.scope_id === scope &&
+              grant.permissions.some((permission) =>
+                sharingPermissions.has(permission),
+              ),
+          ),
+      )
+      .map((device) => device.device_id),
+  );
+  return [
+    ...new Map(
+      sources
+        .filter(
+          (source) =>
+            source.scope_id === scope &&
+            source.status === "active" &&
+            source.device_status === "active" &&
+            allowed.has(source.device_id),
+        )
+        .map((source) => [source.source_id, source]),
+    ).values(),
+  ];
+}
+
+export async function getAllHubSources(
+  instance: string,
+  scope: string,
+  signal: AbortSignal,
+): Promise<HubSource[]> {
+  const sources = new Map<string, HubSource>();
+  const visited = new Set<number>();
+  let offset: number | null = 0;
+  while (offset !== null) {
+    if (visited.has(offset))
+      throw new HubError("来源列表分页未能完成，请刷新后重试。");
+    visited.add(offset);
+    const page = await getHubSummary(instance, scope, offset, signal);
+    for (const source of page.sources) sources.set(source.source_id, source);
+    offset = page.next_offset;
+    signal.throwIfAborted();
+  }
+  return [...sources.values()];
+}
