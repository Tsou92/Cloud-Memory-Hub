+import { Bot, Infinity as InfinityIcon, Network } from "lucide-react";
+import { useId } from "react";
+import type { HubSource } from "./hub-api";
+
+export function HubNetwork({ sources }: { sources: HubSource[] }) {
+  const id = useId().replace(/:/g, "");
+  const nodes = [
+    ...new Map(sources.map((source) => [source.source_id, source])).values(),
+  ];
+  const rows = Math.ceil(nodes.length / 2);
+  const height = Math.max(320, rows * 108 + 48);
+  const center = { x: 380, y: height / 2 };
+  return (
+    <figure
+      className="hub-network"
+      aria-label={`Agent 协作网络：${nodes.length} 个有效连接`}
+    >
+      <div className="hub-network__canvas">
+        <svg
+          viewBox={`0 0 760 ${height}`}
+          role="img"
+          aria-label="当前项目的真实 Agent 连接与共享中枢"
+        >
+          <defs>
+            <radialGradient id={`${id}-orb`} cx="32%" cy="26%" r="78%">
+              <stop offset="0%" stopColor="#809dff" stopOpacity=".7" />
+              <stop offset="44%" stopColor="#3c3d91" stopOpacity=".66" />
+              <stop offset="80%" stopColor="#373361" stopOpacity=".8" />
+              <stop offset="100%" stopColor="#ba87ff" stopOpacity=".95" />
+            </radialGradient>
+            <linearGradient id={`${id}-edge`} x1="0" x2="1">
+              <stop stopColor="#78bdff" stopOpacity=".9" />
+              <stop offset=".5" stopColor="#887cf8" stopOpacity=".22" />
+              <stop offset="1" stopColor="#c498ff" stopOpacity=".9" />
+            </linearGradient>
+            <filter
+              id={`${id}-glow`}
+              x="-75%"
+              y="-75%"
+              width="250%"
+              height="250%"
+            >
+              <feGaussianBlur stdDeviation="8" />
+            </filter>
+          </defs>
+          {nodes.map((source, index) => {
+            const side = index % 2 === 0 ? -1 : 1;
+            const row = Math.floor(index / 2);
+            const x = center.x + side * 218;
+            const y =
+              nodes.length <= 2
+                ? center.y - 28
+                : 58 + row * ((height - 158) / Math.max(1, rows - 1));
+            const path = `M ${x} ${y + 4} C ${center.x + side * 94} ${y - 12}, ${center.x + side * 115} ${center.y}, ${center.x + side * 64} ${center.y}`;
+            return (
+              <g
+                key={source.source_id}
+                data-source-id={source.source_id}
+                className="hub-network__node"
+              >
+                <title>{`${source.device_display_name} · ${source.display_name}`}</title>
+                <path
+                  id={`${id}-link-${index}`}
+                  d={path}
+                  fill="none"
+                  stroke={`url(#${id}-edge)`}
+                  strokeWidth="1.8"
+                />
+                <circle
+                  r="3.5"
+                  fill={side < 0 ? "#b399ff" : "#84bfff"}
+                  className="hub-network__motion"
+                >
+                  <animateMotion
+                    dur={`${3.2 + (index % 5) * 0.34}s`}
+                    begin={`${-(index % 4)}s`}
+                    repeatCount="indefinite"
+                  >
+                    <mpath href={`#${id}-link-${index}`} />
+                  </animateMotion>
+                </circle>
+                <circle
+                  cx={x}
+                  cy={y}
+                  r="33"
+                  fill="#7771e5"
+                  opacity=".23"
+                  filter={`url(#${id}-glow)`}
+                />
+                <circle
+                  cx={x}
+                  cy={y}
+                  r="29"
+                  fill="#383958"
+                  stroke="#7477b7"
+                  strokeWidth="1.4"
+                />
+                <Bot
+                  x={x - 16}
+                  y={y - 16}
+                  width="32"
+                  height="32"
+                  stroke="#e3e2ff"
+                  strokeWidth="1.5"
+                />
+                <rect
+                  x={x - 83}
+                  y={y + 35}
+                  width="166"
+                  height="55"
+                  rx="15"
+                  fill="#22273d"
+                  stroke="#383c5b"
+                />
+                <text
+                  x={x}
+                  y={y + 57}
+                  textAnchor="middle"
+                  className="hub-network__label"
+                >
+                  {source.display_name.length > 17
+                    ? `${source.display_name.slice(0, 16)}…`
+                    : source.display_name}
+                </text>
+                <text
+                  x={x}
+                  y={y + 77}
+                  textAnchor="middle"
+                  className="hub-network__device"
+                >
+                  {source.device_display_name.length > 19
+                    ? `${source.device_display_name.slice(0, 18)}…`
+                    : source.device_display_name}
+                </text>
+              </g>
+            );
+          })}
+          <circle
+            cx={center.x}
+            cy={center.y}
+            r="83"
+            fill="#8978ff"
+            opacity=".38"
+            filter={`url(#${id}-glow)`}
+          />
+          <circle
+            cx={center.x}
+            cy={center.y}
+            r="76"
+            fill={`url(#${id}-orb)`}
+            stroke={`url(#${id}-edge)`}
+            strokeWidth="4"
+          />
+          <ellipse
+            cx={center.x}
+            cy={center.y}
+            rx="56"
+            ry="76"
+            fill="none"
+            stroke="#b4b1ff"
+            opacity=".15"
+            transform={`rotate(-35 ${center.x} ${center.y})`}
+          />
+          <ellipse
+            cx={center.x}
+            cy={center.y}
+            rx="76"
+            ry="30"
+            fill="none"
+            stroke="#b4b1ff"
+            opacity=".12"
+            transform={`rotate(40 ${center.x} ${center.y})`}
+          />
+          <image
+            href="/hub/assets/hub-orb-v1.png"
+            x={center.x - 100}
+            y={center.y - 100}
+            width="200"
+            height="200"
+            onError={(event) => {
+              event.currentTarget.style.display = "none";
+            }}
+          />
+          <InfinityIcon
+            x={center.x - 35}
+            y={center.y - 35}
+            width="70"
+            height="70"
+            stroke="#f0eaff"
+            strokeWidth="2.1"
+          />
+        </svg>
+      </div>
+      {nodes.length === 0 ? (
+        <p className="hub-network__empty">
+          <Network size={16} />
+          连接第一个 Agent，建立你的共享记忆网络
+        </p>
+      ) : null}
+      <figcaption>共享链路示意 · {nodes.length} 个有效来源连接</figcaption>
+      {nodes.length > 0 ? (
+        <details className="hub-network__inventory">
+          <summary>查看全部连接名称</summary>
+          <ul>
+            {nodes.map((source) => (
+              <li key={source.source_id}>
+                {source.device_display_name} · {source.display_name}
+              </li>
+            ))}
+          </ul>
+        </details>
+      ) : null}
+    </figure>
+  );
+}
