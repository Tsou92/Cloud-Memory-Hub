+import { afterEach, expect, it, vi } from "vitest";
+import {
+  CredentialChangeError,
+  changeAdminCredential,
+  credentialChangeMessage,
+  validAdminCredential,
+} from "./hub-admin-credential";
+
+afterEach(() => vi.unstubAllGlobals());
+
+it.each([
+  "a".repeat(31),
+  "a".repeat(257),
+  "a".repeat(31) + " ",
+  "a".repeat(31) + "\n",
+  "a".repeat(32) + "\n",
+  "a".repeat(31) + "\0",
+  "a".repeat(31) + "中",
+])(
+  "rejects credentials outside the existing printable ASCII policy",
+  (value) => {
+    expect(validAdminCredential(value)).toBe(false);
+  },
+);
+
+it.each([32, 64, 256])("accepts the supported credential length %s", (size) => {
+  expect(validAdminCredential("a".repeat(size))).toBe(true);
+});
+
+it.each([
+  [413, "输入内容过长"],
+  [429, "尝试次数过多"],
+  [503, "无法确认是否修改成功"],
+  [422, "新凭证格式不正确"],
+])("maps HTTP %s to fixed user guidance", async (status, message) => {
+  vi.stubGlobal(
+    "fetch",
+    vi.fn().mockResolvedValue(new Response("{}", { status: Number(status) })),
+  );
+  let caught: unknown;
+  try {
+    await changeAdminCredential("synthetic-current", "synthetic-next");
+  } catch (error) {
+    caught = error;
+  }
+  expect(credentialChangeMessage(caught)).toContain(message);
+});
+
+it("treats an unconfirmed success response as unknown and never claims a change", async () => {
+  vi.stubGlobal(
+    "fetch",
+    vi
+      .fn()
+      .mockResolvedValue(
+        new Response(JSON.stringify({ state: "unexpected" }), { status: 200 }),
+      ),
+  );
+  await expect(
+    changeAdminCredential("synthetic-current", "synthetic-next"),
+  ).rejects.toEqual(new CredentialChangeError("unconfirmed_response", true));
+});
+
+it.each([
+  new Response("synthetic server failure", { status: 500 }),
+  new Response(JSON.stringify({ detail: "admin_credential_unavailable" }), {
+    status: 503,
+  }),
+])(
+  "prevents a blind retry when a server failure cannot prove the credential stayed unchanged",
+  async (response) => {
+    vi.stubGlobal("fetch", vi.fn().mockResolvedValue(response));
+    let caught: unknown;
+    try {
+      await changeAdminCredential("synthetic-current", "synthetic-next");
+    } catch (error) {
+      caught = error;
+    }
+    expect(caught).toBeInstanceOf(CredentialChangeError);
+    expect((caught as CredentialChangeError).outcomeUnknown).toBe(true);
+    expect(credentialChangeMessage(caught)).toContain("新凭证重新登录");
+  },
+);
