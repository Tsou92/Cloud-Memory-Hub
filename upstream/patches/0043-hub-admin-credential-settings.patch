@@ -0,0 +1,199 @@
+import { type FormEvent, useEffect, useId, useRef, useState } from "react";
+import {
+  CredentialChangeError,
+  changeAdminCredential,
+  credentialChangeMessage,
+  generateAdminCredential,
+  validAdminCredential,
+} from "./hub-admin-credential";
+import { R6Button, R6Field } from "./R6Controls";
+import "./hub-admin-credential.css";
+
+export function HubAdminCredential({
+  active = true,
+  onChanged = () => window.location.assign("/hub/login"),
+}: {
+  active?: boolean;
+  onChanged?: () => void;
+}) {
+  const id = useId();
+  const [current, setCurrent] = useState("");
+  const [next, setNext] = useState("");
+  const [confirmation, setConfirmation] = useState("");
+  const [visible, setVisible] = useState(false);
+  const [saved, setSaved] = useState(false);
+  const [pending, setPending] = useState(false);
+  const [unknown, setUnknown] = useState(false);
+  const [error, setError] = useState("");
+  const [message, setMessage] = useState("");
+  const busy = useRef(false);
+
+  useEffect(() => {
+    if (active) return;
+    setCurrent("");
+    setNext("");
+    setConfirmation("");
+    setVisible(false);
+    setSaved(false);
+  }, [active]);
+
+  function editNext(value: string) {
+    setNext(value);
+    setSaved(false);
+    setMessage("");
+  }
+
+  function generate() {
+    try {
+      const value = generateAdminCredential();
+      editNext(value);
+      setConfirmation(value);
+      setError("");
+    } catch {
+      setError(
+        "当前浏览器无法生成安全凭证，请自行填写。不要使用简单重复的字符。",
+      );
+    }
+  }
+
+  async function copy() {
+    try {
+      await navigator.clipboard.writeText(next);
+      setMessage(
+        "已复制新凭证，请保存到密码管理器。剪贴板内容请自行妥善处理。",
+      );
+    } catch {
+      setMessage("无法复制。可以点击‘显示新凭证’，手动复制并保存。");
+    }
+  }
+
+  async function submit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (busy.current || unknown) return;
+    setError("");
+    setMessage("");
+    if (!current) {
+      setError("请输入当前管理员凭证。");
+      return;
+    }
+    if (!validAdminCredential(next)) {
+      setError(
+        "请填写 32–256 位英文字符、数字或符号，不含空格，也可点击‘生成安全凭证’。",
+      );
+      return;
+    }
+    if (next !== confirmation) {
+      setError("两次输入的新凭证不一致。");
+      return;
+    }
+    if (next === current) {
+      setError("新凭证需要与当前凭证不同。");
+      return;
+    }
+    if (!saved) {
+      setError("请先保存新凭证，并勾选下方确认项。");
+      return;
+    }
+    busy.current = true;
+    setPending(true);
+    try {
+      await changeAdminCredential(current, next);
+      setCurrent("");
+      setNext("");
+      setConfirmation("");
+      setVisible(false);
+      setSaved(false);
+      onChanged();
+    } catch (caught) {
+      setError(credentialChangeMessage(caught));
+      if (caught instanceof CredentialChangeError && caught.outcomeUnknown)
+        setUnknown(true);
+    } finally {
+      busy.current = false;
+      setPending(false);
+    }
+  }
+
+  return (
+    <div className="hub-admin-credential">
+      <p>
+        更改用于登录后台的管理员凭证。成功后，所有后台登录会话都需要重新登录，已连接的
+        Agent 不受影响。
+      </p>
+      <form onSubmit={(event) => void submit(event)} noValidate>
+        <R6Field
+          label="当前管理员凭证"
+          type="password"
+          autoComplete="current-password"
+          value={current}
+          maxLength={256}
+          disabled={pending || unknown}
+          onChange={(event) => setCurrent(event.target.value)}
+        />
+        <R6Field
+          label="新管理员凭证"
+          type={visible ? "text" : "password"}
+          autoComplete="new-password"
+          value={next}
+          maxLength={256}
+          aria-describedby={`${id}-format`}
+          disabled={pending || unknown}
+          onChange={(event) => editNext(event.target.value)}
+        />
+        <p id={`${id}-format`} className="r6-model-embedding">
+          使用 32–256
+          位英文字符、数字或符号，不含空格。推荐生成安全凭证，并保存到密码管理器。
+        </p>
+        <div className="r6-model-actions">
+          <R6Button onClick={generate} disabled={pending || unknown}>
+            生成安全凭证
+          </R6Button>
+          <R6Button
+            onClick={() => setVisible((value) => !value)}
+            disabled={!next || pending}
+          >
+            {visible ? "隐藏新凭证" : "显示新凭证"}
+          </R6Button>
+          <R6Button onClick={() => void copy()} disabled={!next || pending}>
+            复制新凭证
+          </R6Button>
+        </div>
+        <R6Field
+          label="再次输入新凭证"
+          type={visible ? "text" : "password"}
+          autoComplete="new-password"
+          value={confirmation}
+          maxLength={256}
+          disabled={pending || unknown}
+          onChange={(event) => setConfirmation(event.target.value)}
+        />
+        <label className="hub-admin-credential-saved">
+          <input
+            type="checkbox"
+            checked={saved}
+            disabled={pending || unknown}
+            onChange={(event) => setSaved(event.target.checked)}
+          />
+          我已妥善保存新凭证
+        </label>
+        {message && <p role="status">{message}</p>}
+        {error && (
+          <p role="alert" className="r6-settings-error">
+            {error}
+          </p>
+        )}
+        <div className="r6-model-actions">
+          <R6Button
+            type="submit"
+            variant="primary"
+            pending={pending}
+            disabled={unknown}
+          >
+            保存并重新登录
+          </R6Button>
+          {unknown && <a href="/hub/login">前往登录</a>}
+        </div>
+      </form>
+    </div>
+  );
+}
