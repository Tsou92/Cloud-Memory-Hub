index 0000000..1bc5cde
--- /dev/null
+++ b/memhub/apps/web/src/HubAdminCredential.test.tsx
@@ -0,0 +1,182 @@
+// @vitest-environment jsdom
+
+import {
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, expect, it, vi } from "vitest";
+import { HubAdminCredential } from "./HubAdminCredential";
+import { validAdminCredential } from "./hub-admin-credential";
+
+const current = "synthetic-current-admin-credential-000000000000";
+const next = "synthetic-new-admin-credential-11111111111111";
+
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+  vi.restoreAllMocks();
+});
+
+function fill(confirmation = next) {
+  fireEvent.change(screen.getByLabelText("当前管理员凭证"), {
+    target: { value: current },
+  });
+  fireEvent.change(screen.getByLabelText("新管理员凭证"), {
+    target: { value: next },
+  });
+  fireEvent.change(screen.getByLabelText("再次输入新凭证"), {
+    target: { value: confirmation },
+  });
+}
+
+it("requires matching credentials and a saved copy before making any request", async () => {
+  const fetcher = vi.fn();
+  vi.stubGlobal("fetch", fetcher);
+  render(<HubAdminCredential />);
+  fill("different-synthetic-confirmation-000000000000");
+  await userEvent.click(screen.getByRole("button", { name: "保存并重新登录" }));
+  expect(screen.getByRole("alert").textContent).toContain("不一致");
+  fill();
+  await userEvent.click(screen.getByRole("button", { name: "保存并重新登录" }));
+  expect(screen.getByRole("alert").textContent).toContain("保存新凭证");
+  expect(fetcher).not.toHaveBeenCalled();
+});
+
+it("sends one change request and clears secret inputs before returning to login", async () => {
+  let finish: (response: Response) => void = () => undefined;
+  const fetcher = vi.fn().mockImplementation(
+    () =>
+      new Promise<Response>((resolve) => {
+        finish = resolve;
+      }),
+  );
+  vi.stubGlobal("fetch", fetcher);
+  const changed = vi.fn();
+  render(<HubAdminCredential onChanged={changed} />);
+  fill();
+  await userEvent.click(
+    screen.getByRole("checkbox", { name: "我已妥善保存新凭证" }),
+  );
+  await userEvent.dblClick(
+    screen.getByRole("button", { name: "保存并重新登录" }),
+  );
+  expect(fetcher).toHaveBeenCalledTimes(1);
+  expect(fetcher).toHaveBeenCalledWith(
+    "/hub/v1/admin/credential",
+    expect.objectContaining({
+      method: "POST",
+      credentials: "same-origin",
+      redirect: "error",
+      cache: "no-store",
+      body: JSON.stringify({
+        current_credential: current,
+        new_credential: next,
+      }),
+    }),
+  );
+  finish(
+    new Response(
+      JSON.stringify({
+        schema_version: 1,
+        state: "credential_changed",
+        login_required: true,
+      }),
+      { status: 200 },
+    ),
+  );
+  await waitFor(() => expect(changed).toHaveBeenCalledTimes(1));
+  for (const label of ["当前管理员凭证", "新管理员凭证", "再次输入新凭证"]) {
+    expect((screen.getByLabelText(label) as HTMLInputElement).value).toBe("");
+    expect((screen.getByLabelText(label) as HTMLInputElement).type).toBe(
+      "password",
+    );
+  }
+});
+
+it("generates a valid safe credential, lets the user reveal it and resets saved confirmation", async () => {
+  render(<HubAdminCredential />);
+  await userEvent.click(
+    screen.getByRole("checkbox", { name: "我已妥善保存新凭证" }),
+  );
+  await userEvent.click(screen.getByRole("button", { name: "生成安全凭证" }));
+  const generated = screen.getByLabelText("新管理员凭证") as HTMLInputElement;
+  expect(validAdminCredential(generated.value)).toBe(true);
+  expect(generated.value.length).toBe(64);
+  expect(
+    (screen.getByLabelText("再次输入新凭证") as HTMLInputElement).value,
+  ).toBe(generated.value);
+  expect((screen.getByRole("checkbox") as HTMLInputElement).checked).toBe(
+    false,
+  );
+  expect(generated.type).toBe("password");
+  await userEvent.click(screen.getByRole("button", { name: "显示新凭证" }));
+  expect(generated.type).toBe("text");
+  await userEvent.click(screen.getByRole("button", { name: "隐藏新凭证" }));
+  expect(generated.type).toBe("password");
+});
+
+it("shows a fixed current-credential error without reflecting the server response", async () => {
+  vi.stubGlobal(
+    "fetch",
+    vi
+      .fn()
+      .mockResolvedValue(
+        new Response(
+          JSON.stringify({
+            detail: "current_credential_incorrect",
+            rejected_input: current,
+          }),
+          { status: 403 },
+        ),
+      ),
+  );
+  const changed = vi.fn();
+  render(<HubAdminCredential onChanged={changed} />);
+  fill();
+  await userEvent.click(screen.getByRole("checkbox"));
+  await userEvent.click(screen.getByRole("button", { name: "保存并重新登录" }));
+  expect((await screen.findByRole("alert")).textContent).toBe(
+    "当前凭证不正确，请重新输入。",
+  );
+  expect(document.body.textContent).not.toContain(current);
+  expect(changed).not.toHaveBeenCalled();
+});
+
+it("prevents a blind retry after an unknown network result and provides login recovery", async () => {
+  const fetcher = vi
+    .fn()
+    .mockRejectedValue(new TypeError("synthetic connection lost"));
+  vi.stubGlobal("fetch", fetcher);
+  render(<HubAdminCredential />);
+  fill();
+  await userEvent.click(screen.getByRole("checkbox"));
+  await userEvent.click(screen.getByRole("button", { name: "保存并重新登录" }));
+  expect((await screen.findByRole("alert")).textContent).toContain(
+    "无法确认是否修改成功",
+  );
+  expect(
+    (
+      screen.getByRole("button", {
+        name: "保存并重新登录",
+      }) as HTMLButtonElement
+    ).disabled,
+  ).toBe(true);
+  expect(
+    screen.getByRole("link", { name: "前往登录" }).getAttribute("href"),
+  ).toBe("/hub/login");
+  await userEvent.click(screen.getByRole("button", { name: "保存并重新登录" }));
+  expect(fetcher).toHaveBeenCalledTimes(1);
+});
+
+it("clears credentials when the user leaves the security settings", () => {
+  const view = render(<HubAdminCredential />);
+  fill();
+  view.rerender(<HubAdminCredential active={false} />);
+  for (const label of ["当前管理员凭证", "新管理员凭证", "再次输入新凭证"]) {
+    expect((screen.getByLabelText(label) as HTMLInputElement).value).toBe("");
+  }
+});
diff --git a/memhub/apps/web/src/HubAdminCredential.tsx b/memhub/apps/web/src/HubAdminCredential.tsx
new file mode 100644
index 0000000..1bb42cc
--- /dev/null
