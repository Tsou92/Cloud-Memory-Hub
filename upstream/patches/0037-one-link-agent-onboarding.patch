+});
+
+it.each([
+  ["success", 0, true],
+  ["http404", 22, false],
+  ["offline", 7, false],
+  ["partial", 18, false],
+  ["installer_failed", 19, true],
+] as const)(
+  "runs the exact copied Unix command: %s",
+  (mode, expectedExit, executed) => {
+    const directory = mkdtempSync(join(tmpdir(), "cmh-invitation-command-"));
+    const downloadMarker = join(directory, "download-path");
+    const executionMarker = join(directory, "executed");
+    const instructions = invitationInstructions(issued, "codex");
+    try {
+      writeFileSync(
+        join(directory, "curl"),
+        `#!/bin/sh
+while [ "$#" -gt 0 ]; do
+  case "$1" in
+    -o) shift; cmh_output=$1 ;;
+    --proto-redir) shift; [ "$1" = '=https' ] || exit 90 ;;
+  esac
+  shift
+done
+[ -n "$cmh_output" ] || exit 91
+printf '%s' "$cmh_output" > "$CMH_DOWNLOAD_MARK"
+case "$CMH_TEST_MODE" in
+  http404) exit 22 ;;
+  offline) exit 7 ;;
+esac
+cat > "$cmh_output" <<'SYNTHETIC_INSTALLER'
+[ "$1" = '--link' ] && [ "$2" = "$CMH_EXPECTED_LINK" ] && [ "$3" = '--agent' ] && [ "$4" = 'codex' ] || exit 92
+printf 'executed' > "$CMH_EXECUTION_MARK"
+[ "$CMH_TEST_MODE" != 'installer_failed' ] || exit 19
+SYNTHETIC_INSTALLER
+[ "$CMH_TEST_MODE" != 'partial' ] || exit 18
+`,
+        { mode: 0o700 },
+      );
+      const result = spawnSync("sh", ["-c", instructions.unix], {
+        encoding: "utf8",
+        env: {
+          ...process.env,
+          PATH: `${directory}:/usr/bin:/bin`,
+          TMPDIR: directory,
+          CMH_TEST_MODE: mode,
+          CMH_DOWNLOAD_MARK: downloadMarker,
+          CMH_EXECUTION_MARK: executionMarker,
+          CMH_EXPECTED_LINK: instructions.link,
