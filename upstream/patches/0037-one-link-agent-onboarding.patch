+      method: "POST",
+      body: JSON.stringify({ scope_id: scope, display_name: "合成设备" }),
+    }),
+  );
+  const instructions = invitationInstructions(result, "codex");
+  expect(new URL(instructions.link).search).toBe("");
+  expect(instructions.link).toBe(
+    `https://synthetic.example/hub/connect#pairing_id=${id}&secret=${issued.invitation_secret}`,
+  );
+  expect(instructions.unix).toContain("sh -c ");
+  expect(instructions.unix).toContain("--proto-redir");
+  expect(instructions.unix).toContain(
+    `cmh-connect 'https://synthetic.example' '${instructions.link}' codex`,
+  );
+  expect(instructions.powershell).toBe(
+    `& { $ErrorActionPreference = 'Stop'; $cmhScript = irm -ErrorAction Stop 'https://synthetic.example/hub/install.ps1'; & ([scriptblock]::Create($cmhScript)) -Link '${instructions.link}' -Agent codex }`,
+  );
