diff --git a/memhub/apps/web/src/HubAgentConnect.tsx b/memhub/apps/web/src/HubAgentConnect.tsx
new file mode 100644
--- /dev/null
+++ b/memhub/apps/web/src/HubAgentConnect.tsx
@@ -0,0 +1,422 @@
+import { useEffect, useRef, useState } from "react";
+import type { HubProject } from "./hub-api";
+import {
+  type Agent,
+  agents,
+  createInvitation,
+  type Invitation,
+  InvitationError,
+  type InvitationProgress,
+  type InvitationStatus,
+  invitationInstructions,
+  invitationKey,
+  invitationMessage,
+  readInvitation,
+  readInvitationProgress,
+} from "./hub-invitation";
+import { pairingMessage, validLabel } from "./hub-pairing";
+import { R6Button } from "./R6Controls";
+
+export function HubAgentConnect({
+  instance,
+  project,
+}: {
+  instance: string;
+  project: HubProject;
+}) {
+  const key = invitationKey(instance, project.scope_id);
+  const [name, setName] = useState("");
+  const [agent, setAgent] = useState<Agent>("claude");
+  const [progress, setProgress] = useState<InvitationProgress | null>(null);
+  const [invitation, setInvitation] = useState<Invitation | null>(null);
+  const [status, setStatus] = useState<InvitationStatus | null>(null);
+  const [initialized, setInitialized] = useState(false);
+  const [storageError, setStorageError] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [errorCode, setErrorCode] = useState("");
+  const [notice, setNotice] = useState("");
+  const [confirmed, setConfirmed] = useState(false);
+  const refresh = useRef<() => void>(() => {});
+  const writer = useRef<AbortController | null>(null);
+  const writing = useRef(false);
+  const alive = useRef(true);
+  function save(next: InvitationProgress | null) {
+    setProgress(next);
+    try {
+      if (next) sessionStorage.setItem(key, JSON.stringify(next));
+      else sessionStorage.removeItem(key);
+    } catch {
+      setStorageError(true);
+      throw new InvitationError("storage_unavailable");
+    }
+  }
+  useEffect(() => {
+    alive.current = true;
+    try {
+      setProgress(readInvitationProgress(key));
+    } catch {
+      setStorageError(true);
+    }
+    setInitialized(true);
+    return () => {
+      alive.current = false;
+      writer.current?.abort();
+    };
+  }, [key]);
+  useEffect(() => {
+    const id = progress?.pairing_id;
+    if (!id || busy) return;
+    const pairingId = id;
+    let controller: AbortController | null = null;
+    let timer: ReturnType<typeof setTimeout>;
+    async function poll() {
+      controller?.abort();
+      clearTimeout(timer);
+      const current = new AbortController();
+      controller = current;
+      let pending = true;
+      try {
+        const next = await readInvitation(
+          pairingId,
+          project.scope_id,
+          current.signal,
+        );
+        if (current.signal.aborted) return;
+        setStatus(next);
+        setError("");
+        setErrorCode("");
+        pending = next.state === "pending";
+        if (!pending) {
+          setInvitation(null);
+          setNotice("");
+        }
+      } catch (reason) {
+        if (current.signal.aborted) return;
+        setError(invitationMessage(reason));
+        setErrorCode(
+          reason instanceof InvitationError ? reason.code : "request_failed",
+        );
+        pending = !(
+          reason instanceof InvitationError &&
+          [
+            "administrator_required",
+            "authentication_required",
+            "pairing_not_found",
+          ].includes(reason.code)
+        );
+        if (!pending) setInvitation(null);
+      }
+      if (pending && !current.signal.aborted)
+        timer = setTimeout(() => void poll(), 5000);
+    }
+    refresh.current = () => void poll();
+    void poll();
+    return () => {
+      refresh.current = () => {};
+      controller?.abort();
+      clearTimeout(timer);
+    };
+  }, [progress?.pairing_id, project.scope_id, busy]);
+  async function mutate(revoke: boolean) {
+    if (
+      writing.current ||
+      storageError ||
+      !initialized ||
+      (revoke ? !progress?.pairing_id || !confirmed : !!progress)
+    )
+      return;
+    let label = "";
+    if (!revoke) {
+      try {
+        label = validLabel(name);
+      } catch (reason) {
+        setError(pairingMessage(reason));
+        return;
+      }
+    }
+    const controller = new AbortController();
+    writer.current = controller;
+    writing.current = true;
+    setBusy(true);
+    setError("");
+    setErrorCode("");
+    setNotice("");
+    setConfirmed(false);
+    try {
+      if (revoke) {
+        const pairingId = progress?.pairing_id;
+        if (!pairingId) throw new InvitationError("invalid_response");
+        setInvitation(null);
+        const next = await readInvitation(
+          pairingId,
+          project.scope_id,
+          controller.signal,
+          true,
+        );
+        if (!controller.signal.aborted) {
+          setStatus(next);
+          setInvitation(null);
+        }
+      } else {
+        save({ version: 1, pairing_id: null });
+        const next = await createInvitation(
+          project.scope_id,
+          label,
+          controller.signal,
+          (id) => save({ version: 1, pairing_id: id }),
+        );
+        if (!controller.signal.aborted) setInvitation(next);
+      }
+    } catch (reason) {
+      if (!controller.signal.aborted) {
+        if (!revoke && reason instanceof InvitationError && reason.rejected) {
+          try {
+            save(null);
+          } catch {
+            /* Keep storage failure visible. */
+          }
+        }
+        setError(invitationMessage(reason));
+        setErrorCode(
+          reason instanceof InvitationError ? reason.code : "request_failed",
+        );
+      }
+    } finally {
+      writing.current = false;
+      if (alive.current) setBusy(false);
+    }
+  }
+  function finish() {
+    try {
+      save(null);
+      setInvitation(null);
+      setStatus(null);
+      setConfirmed(false);
+      setError("");
+      setErrorCode("");
+      setNotice("");
+    } catch (reason) {
+      setError(invitationMessage(reason));
+    }
+  }
+  async function copy(text: string) {
+    try {
+      await navigator.clipboard.writeText(text);
+      if (alive.current) setNotice("已复制。请只交给要接入的设备或 Agent。");
+    } catch {
+      if (alive.current) setNotice("未能自动复制，请选中下方文本手动复制。");
+    }
+  }
+  const instructions = invitation && invitationInstructions(invitation, agent);
+  const terminal = status && status.state !== "pending";
+  const expiry = status?.expires_at ?? invitation?.expires_at;
+  return (
+    <section className="hub-card hub-pairing" aria-label="连接 Agent">
+      <h2>连接 Agent</h2>
+      <p>
+        当前项目：{project.display_name}
+        。可在页面上方切换项目；每台设备分别创建链接。
+      </p>
+      <p>
+        无需独立 App。把一句话交给 Agent，或在目标设备运行一条命令，安装 MCP 和
+        Skill。新设备仅获得当前项目的上传、记忆读取和历史读取权限。
+      </p>
+      {project.scope_id === "global" ? (
+        <p>请先选择或创建一个项目；全局偏好不能用于设备配对。</p>
+      ) : (
+        <>
+          <label>
+            要连接的 Agent{" "}
+            <select
+              value={agent}
+              onChange={(event) => setAgent(event.target.value as Agent)}
+            >
+              {Object.entries(agents).map(([id, label]) => (
+                <option value={id} key={id}>
+                  {label}
+                </option>
+              ))}
+            </select>
+          </label>
+          {!progress ? (
+            <form
+              onSubmit={(event) => {
+                event.preventDefault();
+                void mutate(false);
+              }}
+            >
+              <label>
+                设备显示名{" "}
+                <input
+                  value={name}
+                  maxLength={80}
+                  placeholder="例如：办公室 Mac mini"
+                  disabled={busy}
+                  onChange={(event) => setName(event.target.value)}
+                />
+              </label>
+              <R6Button
+                type="submit"
+                variant="primary"
+                pending={busy}
+                disabled={!name.trim() || storageError || !initialized}
+              >
+                生成 10 分钟连接链接
+              </R6Button>
+            </form>
+          ) : (
+            <>
+              <p role="status">
+                {status?.state === "claimed"
+                  ? "已配对：设备身份已签发。"
+                  : status?.state === "expired"
+                    ? "链接已过期。"
+                    : status?.state === "cancelled"
+                      ? "邀请已撤销。"
+                      : progress.pairing_id
+                        ? "等待连接：正在核对邀请状态。"
+                        : "创建结果尚未确认，未取得可用链接。"}
+              </p>
+              {progress.pairing_id && (
+                <details>
+                  <summary>邀请编号</summary>
+                  <code>{progress.pairing_id}</code>
+                </details>
+              )}
+              {expiry && <p>有效期至：{new Date(expiry).toLocaleString()}</p>}
+              {instructions && !terminal && (
+                <>
+                  <p>
+                    链接有效期 10
+                    分钟，仅供一台设备领取。刷新或离开页面后不再显示链接；请勿公开分享。
+                  </p>
+                  <label>
+                    给 Agent 的一句话{" "}
+                    <textarea readOnly rows={4} value={instructions.prompt} />
+                  </label>
+                  <R6Button onClick={() => void copy(instructions.prompt)}>
+                    复制给 Agent 的一句话
+                  </R6Button>
+                  <details>
+                    <summary>在终端运行一条命令</summary>
+                    <label>
+                      macOS / Linux{" "}
+                      <textarea readOnly rows={3} value={instructions.unix} />
+                    </label>
+                    <R6Button onClick={() => void copy(instructions.unix)}>
+                      复制 macOS / Linux 命令
+                    </R6Button>
+                    <label>
+                      Windows PowerShell{" "}
+                      <textarea
+                        readOnly
+                        rows={3}
+                        value={instructions.powershell}
+                      />
+                    </label>
+                    <R6Button
+                      onClick={() => void copy(instructions.powershell)}
+                    >
+                      复制 PowerShell 命令
+                    </R6Button>
+                    <p>
+                      宿主和系统的支持情况以实际安装检查为准；脚本存在不代表该宿主已通过验收。
+                    </p>
+                  </details>
+                  <R6Button
+                    variant="quiet"
+                    onClick={() => void copy(instructions.link)}
+                  >
+                    仅复制连接链接
+                  </R6Button>
+                </>
+              )}
+              {progress.pairing_id && !invitation && !terminal && (
+                <p>
+                  此页已没有邀请秘密。可以查询原邀请或撤销后重新生成；不会自动重复创建。
+                </p>
+              )}
+              {status?.state === "claimed" && (
+                <p>
+                  配对不代表设备在线，也不代表 MCP 和 Skill
+                  已安装完成。请按目标设备的安装结果完成连接验证；如提示重新加载，请在对应
+                  Agent 中操作。
+                </p>
+              )}
+              {status?.state === "cancelled" && (
+                <p>
+                  此链接不能再领取。若此前已签发设备身份，撤销邀请不会撤销该设备；设备访问请在高级设备授权中管理。
+                </p>
+              )}
+              {progress.pairing_id && (
+                <R6Button
+                  variant="quiet"
+                  disabled={busy}
+                  onClick={() => refresh.current()}
+                >
+                  查询邀请状态
+                </R6Button>
+              )}
+              {progress.pairing_id &&
+                !terminal &&
+                errorCode !== "pairing_not_found" && (
+                  <>
+                    <label>
+                      <input
+                        type="checkbox"
+                        checked={confirmed}
+                        disabled={busy}
+                        onChange={(event) => setConfirmed(event.target.checked)}
+                      />
+                      我确认撤销此邀请链接；已签发设备的授权不受影响。
+                    </label>
+                    <R6Button
+                      disabled={busy || !confirmed || storageError}
+                      onClick={() => void mutate(true)}
+                    >
+                      撤销邀请链接
+                    </R6Button>
+                  </>
+                )}
+              {!progress.pairing_id && !busy && (
+                <>
+                  <p>
+                    请求可能已在服务器完成，但没有拿到链接。不会自动重发；未领取的旧邀请会在服务器创建后
+                    10 分钟过期。
+                  </p>
+                  <label>
+                    <input
+                      type="checkbox"
+                      checked={confirmed}
+                      onChange={(event) => setConfirmed(event.target.checked)}
+                    />
+                    我理解旧请求仍可能完成，决定结束本次未知尝试。
+                  </label>
+                  <R6Button
+                    disabled={!confirmed || storageError}
+                    onClick={finish}
+                  >
+                    结束本次未知尝试
+                  </R6Button>
+                </>
+              )}
+              {(terminal || errorCode === "pairing_not_found") && (
+                <R6Button disabled={busy || storageError} onClick={finish}>
+                  准备连接另一台设备
+                </R6Button>
+              )}
+            </>
+          )}
+        </>
+      )}
+      {storageError && (
+        <p role="alert">
+          {invitationMessage(new InvitationError("storage_unavailable"))}
+        </p>
+      )}
+      {error && <p role="alert">{error}</p>}
+      {notice && <p role="status">{notice}</p>}
+    </section>
+  );
+}
