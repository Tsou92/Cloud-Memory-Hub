+def _chat_history_evidence(nodes=(), identities=(), rendered="", status="complete"):
+    """Freeze only the nodes that contributed to the actual history string."""
+    unavailable = {"schema_version": 1, "status": "unavailable", "records": [], "rendered": ""}
+    try:
+        if len(identities) > 512 or len(rendered) > 2 * 1024 * 1024:
+            return unavailable
+        records = []
+        evidence = {"schema_version": 1, "status": status, "records": records, "rendered": rendered}
+        size = len(json.dumps(evidence, ensure_ascii=False, allow_nan=False).encode())
+        if size > 2 * 1024 * 1024:
+            return unavailable
+        for node in nodes:
+            if node.node_id not in identities:
+                continue
+            record = {
+                name: getattr(node, name, None)
+                for name in ("node_id", "user_id", "agent_id", "session_id", "source", "content")
+            }
+            record["request_id"] = (node.custom or {}).get("request_id")
+            if any(value is not None and not isinstance(value, str) for value in record.values()):
+                return unavailable
+            if any(value is not None and len(value) > 2 * 1024 * 1024 for value in record.values()):
+                return unavailable
+            size += len(json.dumps(record, ensure_ascii=False, allow_nan=False).encode()) + 2
+            if size > 2 * 1024 * 1024:
+                return unavailable
+            records.append(record)
+        if len(records) != len(identities) or {record["node_id"] for record in records} != set(identities):
+            return unavailable
+        return evidence
+    except Exception:
+        return unavailable


