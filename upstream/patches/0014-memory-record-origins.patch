+def memory_update_origin(old, updates, request_id):
+    """Reuse the writer's existing old-node read; never synthesize missing state."""
+    from ..models.memory import MemoryNode
+
+    result = dict(updates)
+    result.update(origin_request_id=None, origin_digest=None)
+    if old is None:
+        return result
+    try:
+        payload = old.to_dict()
+        payload.update(updates)
+        node = stamp_memory_origin(MemoryNode.from_dict(payload), request_id)
+        result.update(
+            origin_request_id=node.origin_request_id, origin_digest=node.origin_digest
+        )
+    except (KeyError, ValueError, TypeError, OverflowError, AttributeError):
+        pass
+    return result
+
+
+def invalidate_memory_origin(updates):
+    """Partial untracked semantic changes must not inherit a previous producer."""
