+def stamp_memory_origin(node, request_id):
+    """Unobservable origin must not change the existing write behavior."""
+    try:
+        stamp_origin(node, "memory", request_id or None)
+    except (KeyError, ValueError, TypeError, OverflowError, AttributeError):
+        node.origin_request_id = node.origin_digest = None
+    return node
