+++ b/hy_memory/agent/tools/profile_capture.py
@@ -0,0 +1,96 @@
+"""Call-local evidence of the existing deterministic L0 update, not another write."""
+
+import json
+
+from ...coding.input_capture import ReconcileInputCapture
+
+_EFFECTS = (
+    "attempted_output_ids",
+    "output_ids",
+    "attempted_supersede_ids",
+    "superseded_ids",
+)
+
+
+def profile_capture_result(status="not_used"):
+    return {
+        "schema_version": 1,
+        "status": status,
+        "stages": [],
+        "effects_complete": True,
+        **{key: [] for key in _EFFECTS},
+    }
+
+
+class ProfileInputCapture:
+    # The unchanged native query returns at most 1000 old nodes, plus one new ID.
+    MAX_EFFECTS = 1024
+    MAX_ID_CHARS = 512
+
+    def __init__(self, target):
+        self.target = target
+        self.inputs = ReconcileInputCapture()
+        self.effects = profile_capture_result("unavailable")
+
+    def decision(self, nodes, fields, incoming, existing, heads):
+        if self.target is None:
+            return
+        token = self.inputs.begin(
+            "basic_profile_update",
+            "profile",
+            nodes,
+            lambda: json.dumps(
+                {
+                    "allowed_fields": fields,
+                    "incoming_kv": incoming,
+                    "existing_kv": existing,
+                    "head_ids": [n.node_id for n in heads],
+                },
+                ensure_ascii=False,
+                sort_keys=True,
+                allow_nan=False,
+            ),
+        )
+        self.inputs.end(token, "used")
+
+    def effect(self, key, identity):
+        if self.target is None or not self.effects["effects_complete"]:
+            return
+        if (
+            not isinstance(identity, str)
+            or not identity
+            or len(identity) > self.MAX_ID_CHARS
+            or len(self.effects[key]) >= self.MAX_EFFECTS
+        ):
+            self.effects["effects_complete"] = False
+            self.failed()
+            return
+        self.effects[key].append(identity)
+
+    def failed(self):
+        self.inputs.unavailable = True
+
+    def finish(self, result):
+        if self.target is None:
+            return
+        try:
+            if result is None or not result.success:
+                self.failed()
+            payload = dict(self.effects)
+            payload.update(self.inputs.result(required=("basic_profile_update",)))
+            if (
+                len(json.dumps(payload, ensure_ascii=False, allow_nan=False).encode())
+                > self.inputs.MAX_BYTES
+            ):
+                payload.update(status="unavailable", stages=[])
+            if (
+                len(json.dumps(payload, ensure_ascii=False, allow_nan=False).encode())
+                > self.inputs.MAX_BYTES
+            ):
+                payload = profile_capture_result("unavailable")
+                payload["effects_complete"] = False
+        except Exception:
+            payload = profile_capture_result("unavailable")
+            payload["effects_complete"] = False
+        self.target.clear()
+        self.target.update(payload)
