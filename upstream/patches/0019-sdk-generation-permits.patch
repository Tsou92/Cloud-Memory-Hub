diff --git a/memhub/apps/core/tests/test_sdk_generation_permit.py b/memhub/apps/core/tests/test_sdk_generation_permit.py
new file mode 100644
index 0000000..fedce34
--- /dev/null
+++ b/memhub/apps/core/tests/test_sdk_generation_permit.py
@@ -0,0 +1,382 @@
+"""Optional durable generation permission, exact inputs and both composition paths."""
+
+import asyncio
+import json
+import sqlite3
+from contextlib import asynccontextmanager
+from dataclasses import FrozenInstanceError
+from datetime import UTC, datetime
+from types import SimpleNamespace
+
+import pytest
+
+from one_memory.api import _sdk_library_bridge, create_app
+from one_memory.config import Settings
+from one_memory.hy_memory_bridge import (
+    HyMemoryBridge,
+    HyMemoryBridgeError,
+    HyMemoryIngestResult,
+    HyMemoryOutput,
+    builtin_retrieval_snapshot,
+    sdk_generation_input,
+)
+from one_memory.hy_response_guard import HyReconcileGuard
+from one_memory.imports.models import (
+    EvidenceContentKind,
+    EvidenceInput,
+    EvidenceOrigin,
+    OriginMetadata,
+    WrittenBy,
+    materialize_write_input,
+)
+from one_memory.memory_processing import MemoryTaskRunner, sdk_generation_input_for
+from one_memory.memory_server.contracts import BatchIdentity, WriteRequest, internal_session_id_for
+
+
+def frozen_request(kind=EvidenceContentKind.RAW_CONVERSATION):
+    records = tuple(
+        materialize_write_input(
+            EvidenceInput(
+                user_id="synthetic-user",
+                source_id="synthetic-source",
+                workspace="synthetic-scope",
+                conversation_id="synthetic-session",
+                message_id=f"message-{index}",
+                role="user",
+                written_by=WrittenBy.PERSON,
+                content_kind=kind,
+                verbatim=text,
+                created_at=datetime(2026, 11, 9, tzinfo=UTC),
+                origin_meta={EvidenceOrigin.PLUGIN: OriginMetadata(raw_meta={"synthetic": True})},
+            ),
+            observed_at=datetime(2026, 11, 9, tzinfo=UTC),
+        )
+        for index, text in enumerate(
+            ("keep order password=synthetic-private-value", "second input")
+        )
+    )
+    session = internal_session_id_for("synthetic-session", "synthetic-source")
+    return WriteRequest(
+        internal_session_id=session,
+        source_id="synthetic-source",
+        batch_identity=BatchIdentity(internal_session_id=session, first_round=1, last_round=2),
+        evidence_ids=[record.evidence_id for record in records],
+        input_records=records,
+        idempotency_key="cmh2:synthetic-instance:synthetic-birth:synthetic-device:synthetic-event",
+    )
+
+
+def sdk_request():
+    frozen = frozen_request()
+    return MemoryTaskRunner.request_for(frozen.request_key, frozen.input_records).model_copy(
+        update={"source_context": None}
+    )
+
+
+class Guard(HyReconcileGuard):
+    _extract = None
+
+
+class Client:
+    def __init__(self, fail=False):
+        self.calls = []
+        self.fail = fail
+        self.before_call = lambda: None
+        self.guard = Guard(SimpleNamespace())
+        self._one_memory_write_guards = (self.guard,)
+
+    def add(self, argument, **kwargs):
+        return self.record("add", argument, kwargs)
+
+    def add_extracted(self, argument, **kwargs):
+        return self.record("add_extracted", argument, kwargs)
+
+    def record(self, operation, argument, kwargs):
+        self.before_call()
+        self.calls.append((operation, argument, kwargs))
+        if self.fail:
+            if operation == "add":
+                self.guard.bindings = "synthetic-dirty-binding"
+            else:
+                self.guard.imported_contents = frozenset({"synthetic-dirty-import"})
+            raise RuntimeError("synthetic-private-sdk-error")
+        return {"success": True}
+
+    def close(self):
+        pass
+
+
+def bridge_for(tmp_path, monkeypatch, permit=None, *, fail=False, operation_guard=None):
+    client = Client(fail)
+    bridge = HyMemoryBridge(
+        profile=builtin_retrieval_snapshot(),
+        api_key=None,
+        data_dir=tmp_path,
+        client=client,
+        generation_permit=permit,
+        operation_guard=operation_guard,
+    )
+
+    async def result(*args, **kwargs):
+        return HyMemoryIngestResult(
+            success=True,
+            memories=(HyMemoryOutput(memory_id="synthetic-output", content="synthetic result"),),
+        )
+
+    monkeypatch.setattr(bridge, "_result", result)
+    return bridge, client
+
+
+async def invoke(bridge, operation, request=None, contents=None):
+    request = request or sdk_request()
+    if operation == "add":
+        return await bridge.ingest(request)
+    return await bridge.ingest_extracted(
+        request, [" first ", "second", " first "] if contents is None else contents
+    )
+
+
+def assert_exact(descriptor, client):
+    operation, argument, kwargs = client.calls[0]
+    decoded = json.loads(descriptor.canonical_input)
+    expected_kwargs = {**kwargs, "memory_at": kwargs["memory_at"].isoformat()}
+    expected_args = [list(argument) if isinstance(argument, tuple) else argument]
+    assert decoded == {
+        "version": 1,
+        "operation": operation,
+        "args": expected_args,
+        "kwargs": expected_kwargs,
+        "legacy_source_context": False,
+    }
+    assert descriptor.request_id == kwargs["request_id"]
+    assert "synthetic-private-value" not in descriptor.canonical_input.decode()
+    assert "second input" not in repr(descriptor)
+    with pytest.raises(FrozenInstanceError):
+        descriptor.request_id = "changed"
+
+
+@pytest.mark.parametrize("operation", ["add", "add_extracted"])
+def test_permission_waits_inside_both_locks_before_exact_sdk_call(tmp_path, monkeypatch, operation):
+    async def scenario():
+        entered, release = asyncio.Event(), asyncio.Event()
+        guarded, descriptors = [], []
+
+        @asynccontextmanager
+        async def operation_guard():
+            guarded.append(True)
+            try:
+                yield
+            finally:
+                guarded.pop()
+
+        async def permit(value):
+            descriptors.append(value)
+            assert guarded and bridge._write_lock.locked()
+            assert bridge._access_owner is asyncio.current_task()
+            entered.set()
+            await release.wait()
+            with sqlite3.connect(tmp_path / "permission.sqlite3") as db:
+                db.execute("CREATE TABLE permitted (input BLOB NOT NULL)")
+                db.execute("INSERT INTO permitted VALUES (?)", (value.canonical_input,))
+
+        bridge, client = bridge_for(tmp_path, monkeypatch, permit, operation_guard=operation_guard)
+
+        def require_committed():
+            with sqlite3.connect(tmp_path / "permission.sqlite3") as db:
+                assert db.execute("SELECT input FROM permitted").fetchall() == [
+                    (descriptors[0].canonical_input,)
+                ]
+
+        client.before_call = require_committed
+        task = asyncio.create_task(invoke(bridge, operation))
+        await entered.wait()
+        assert client.calls == []
+        release.set()
+        assert (await task).success
+        assert len(descriptors) == len(client.calls) == 1
+        assert_exact(descriptors[0], client)
+        assert client.guard.bindings is None and client.guard.imported_contents is None
+        assert not guarded and not bridge._write_lock.locked()
+
+    asyncio.run(scenario())
+
+
+@pytest.mark.parametrize("operation", ["add", "add_extracted"])
+@pytest.mark.parametrize("failure", ["deny", "cancel"])
+def test_unfinished_or_rejected_permission_never_calls_sdk(
+    tmp_path, monkeypatch, operation, failure
+):
+    async def scenario():
+        entered = asyncio.Event()
+
+        async def permit(value):
+            entered.set()
+            if failure == "deny":
+                raise ValueError("synthetic-private-callback-error")
+            await asyncio.Event().wait()
+
+        bridge, client = bridge_for(tmp_path, monkeypatch, permit)
+        task = asyncio.create_task(invoke(bridge, operation))
+        await entered.wait()
+        if failure == "cancel":
+            task.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await task
+        else:
+            with pytest.raises(HyMemoryBridgeError) as caught:
+                await task
+            assert str(caught.value) == "hy_memory_generation_not_permitted"
+            assert caught.value.__suppress_context__
+        assert client.calls == []
+        assert client.guard.bindings is None and client.guard.imported_contents is None
+        assert not bridge._write_lock.locked() and bridge._access_owner is None
+
+    asyncio.run(scenario())
+
