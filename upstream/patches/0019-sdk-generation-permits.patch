+@pytest.mark.parametrize(
+    "change", ["operation", "contents", "request_id", "turn", "source_context"]
+)
+def test_input_or_operation_change_is_rejected_before_sdk(tmp_path, monkeypatch, change):
+    async def scenario():
+        request = sdk_request()
+        contents = ("first", "second", "first")
+        operation = "add_extracted" if change == "contents" else "add"
+        expected = sdk_generation_input(operation, request, contents)
+
+        async def permit(value):
+            if value != expected:
+                raise ValueError("changed generation input")
+
+        bridge, client = bridge_for(tmp_path, monkeypatch, permit)
+        if change == "operation":
+            operation = "add_extracted"
+        elif change == "contents":
+            contents = ("first", "first", "second")
+        elif change == "request_id":
+            request = request.model_copy(update={"request_id": request.request_id + "-changed"})
+        elif change == "turn":
+            turn = request.turns[0].model_copy(update={"content": "changed turn"})
+            request = request.model_copy(update={"turns": (turn, *request.turns[1:])})
+        else:
+            frozen = frozen_request()
+            request = MemoryTaskRunner.request_for(frozen.request_key, frozen.input_records)
+            assert request.source_context is not None
+        with pytest.raises(HyMemoryBridgeError, match="^hy_memory_generation_not_permitted$"):
+            await invoke(bridge, operation, request, contents)
+        assert client.calls == []
+        assert client.guard.bindings is None and client.guard.imported_contents is None
+
+    asyncio.run(scenario())
