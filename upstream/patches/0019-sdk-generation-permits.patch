+def test_awaiting_permission_cannot_change_extracted_contents(tmp_path, monkeypatch):
+    async def scenario():
+        entered, release = asyncio.Event(), asyncio.Event()
+        captured = []
+
+        async def permit(value):
+            captured.append(value)
+            entered.set()
+            await release.wait()
+
+        bridge, client = bridge_for(tmp_path, monkeypatch, permit)
+        contents = [" duplicate ", "second", " duplicate "]
+        task = asyncio.create_task(invoke(bridge, "add_extracted", contents=contents))
+        await entered.wait()
+        contents[:] = ["modified while awaiting permission"]
+        release.set()
+        await task
+        assert client.calls[0][1] == (" duplicate ", "second", " duplicate ")
+        assert_exact(captured[0], client)
+
+    asyncio.run(scenario())
