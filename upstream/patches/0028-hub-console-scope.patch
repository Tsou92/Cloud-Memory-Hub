+.hub-console,
+.hub-start {
+  color: var(--text-primary, #252722);
+  max-width: 1120px;
+  margin: 0 auto;
+  padding: 28px;
+}
+.hub-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+}
+.hub-header strong {
+  font-size: 24px;
+  letter-spacing: -0.5px;
+}
+.hub-header p {
+  margin: 6px 0 0;
+  color: var(--text-muted, #62665c);
+}
+.hub-project-select {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 10px;
+  margin: 28px 0 18px;
+}
+.hub-project-select select {
+  margin-left: 8px;
+  min-width: 220px;
+  padding: 9px;
+  border: 1px solid #d8dbd2;
+  border-radius: 8px;
+  background: var(--surface, #fff);
+  color: inherit;
+}
+.hub-navigation {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  padding-bottom: 20px;
+  border-bottom: 1px solid #d8dbd2;
+}
+.hub-content {
+  padding: 20px 0;
+}
+.hub-content h1 {
+  font-size: 24px;
+  margin-bottom: 24px;
+}
+.hub-content h2 {
+  font-size: 19px;
+}
+.hub-overview {
+  display: grid;
+  gap: 18px;
+}
+.hub-card {
+  padding: 22px;
+  border: 1px solid #d8dbd2;
+  border-radius: 12px;
+  background: var(--surface, #fff);
+}
+.hub-card ul,
+.hub-content .sdk-memory-library ul {
+  padding-left: 22px;
+}
+.hub-card li {
+  margin: 12px 0;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+}
+.hub-content p {
+  line-height: 1.65;
+}
+.hub-content [role="alert"] {
+  color: #a52a25;
+}
+.hub-content nav {
+  display: flex;
+  gap: 10px;
+  margin: 16px 0;
+}
+.hub-content textarea {
+  display: block;
+  width: 100%;
+  min-height: 100px;
+  margin: 12px 0;
+  padding: 10px;
+  font: inherit;
+  border: 1px solid #d8dbd2;
+  border-radius: 8px;
+}
+.hub-answer,
+.hub-content aside p,
+.hub-content [aria-label="SDK 原始对话"] li p {
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+}
+.hub-content .r6-settings {
+  min-height: auto;
+}
+@media (max-width: 640px) {
+  .hub-console,
+  .hub-start {
+    padding: 16px;
+  }
+  .hub-project-select label,
+  .hub-project-select select {
+    width: 100%;
+  }
+  .hub-project-select select {
+    margin: 8px 0 0;
+  }
+}
