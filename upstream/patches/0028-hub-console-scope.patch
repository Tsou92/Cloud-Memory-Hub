+import type { SdkAskMemoryResponse } from "@one-memory/contracts";
+import { type FormEvent, useEffect, useRef, useState } from "react";
+import { HubError, hubErrorMessage } from "./hub-api";
+import { R6Button } from "./R6Controls";
+
+/** Uses the existing recall/delta/final SSE contract, on the Hub-only route. */
+export async function askHub(
+  scope: string,
+  question: string,
+  signal: AbortSignal,
+): Promise<SdkAskMemoryResponse> {
+  const response = await fetch("/hub/v1/console/ask-stream", {
+    method: "POST",
+    credentials: "same-origin",
+    cache: "no-store",
+    signal,
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ scope_id: scope, question }),
+  });
+  if (
+    !response.ok ||
+    !response.body ||
+    !response.headers.get("content-type")?.includes("text/event-stream")
+  ) {
+    throw new HubError(
+      response.status === 404
+        ? "网页问答尚未接通，请升级 Hub 后重试。"
+        : "问答请求未完成，请检查登录状态和模型设置后重试。",
+    );
+  }
+  const reader = response.body.getReader();
+  const decoder = new TextDecoder();
+  let buffer = "";
+  let answer: SdkAskMemoryResponse | null = null;
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      buffer = (buffer + decoder.decode(value, { stream: !done })).replace(
+        /\r\n/g,
+        "\n",
+      );
+      if (buffer.length > 256_000)
+        throw new HubError("问答内容超过显示上限，请缩短问题后重试。");
+      const frames = buffer.split("\n\n");
+      buffer = frames.pop() ?? "";
+      for (const frame of frames) {
+        const data = frame
+          .split("\n")
+          .filter((line) => line.startsWith("data:"))
+          .map((line) => line.slice(5).trim())
+          .join("\n");
+        if (!data) continue;
+        const event = JSON.parse(data);
+        if (event.type === "error")
+          throw new HubError(
+            "问答未完成，请检查模型设置或稍后重试。已有记忆仍可在记忆库查看。",
+          );
+        if (event.type === "final") {
+          if (
+            answer ||
+            event.schema_version !== 2 ||
+            typeof event.answer !== "string" ||
+            !["empty", "extractive", "generated"].includes(event.mode) ||
+            !Array.isArray(event.memories) ||
+            !event.memories.every(
+              (item: Record<string, unknown>) =>
+                typeof item?.memory_id === "string" &&
+                typeof item?.content === "string",
+            )
+          ) {
+            throw new HubError("问答返回的数据无法确认，请重试。");
+          }
+          answer = event;
+        } else if (!["recall", "delta"].includes(event.type)) {
+          throw new HubError("问答返回的数据无法确认，请重试。");
+        }
+      }
+      if (done) break;
+    }
+    if (!answer || buffer.trim())
+      throw new HubError("问答连接提前结束，请重试。");
+    return answer;
+  } finally {
+    await reader.cancel();
+    reader.releaseLock();
+  }
+}
+
+export function HubQuestion({
+  scope,
+  enabled,
+  onOpenMemory,
+}: {
+  instance: string;
+  scope: string;
+  enabled: boolean;
+  onOpenMemory?(id: string | null): void;
+}) {
+  const [question, setQuestion] = useState("");
+  const [answer, setAnswer] = useState<SdkAskMemoryResponse | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const controller = useRef<AbortController | null>(null);
+  useEffect(() => () => controller.current?.abort(), []);
+  async function submit(event: FormEvent) {
+    event.preventDefault();
+    if (!enabled || busy || !question.trim()) return;
+    const next = new AbortController();
+    controller.current?.abort();
+    controller.current = next;
+    setAnswer(null);
+    onOpenMemory?.(null);
+    setError("");
+    setBusy(true);
+    try {
+      const result = await askHub(scope, question.trim(), next.signal);
+      if (!next.signal.aborted) setAnswer(result);
+    } catch (reason) {
+      if (!next.signal.aborted) setError(hubErrorMessage(reason));
+    } finally {
+      if (!next.signal.aborted) setBusy(false);
+    }
+  }
+  return (
+    <section className="hub-card">
+      <h2>问当前项目的记忆</h2>
+      <p>仅使用当前项目的可见记忆回答；提问会调用已配置的模型。</p>
+      {!enabled ? (
+        <p role="status">
+          当前服务尚未接通网页问答，可先在记忆库查看内容。升级后请刷新页面。
+        </p>
+      ) : (
+        <>
+          <form onSubmit={(event) => void submit(event)}>
+            <label>
+              你的问题
+              <textarea
+                aria-label="你的问题"
+                value={question}
+                maxLength={4096}
+                onChange={(event) => setQuestion(event.target.value)}
+              />
+            </label>
+            <R6Button
+              type="submit"
+              variant="primary"
+              pending={busy}
+              disabled={!question.trim()}
+            >
+              提问
+            </R6Button>
+          </form>
+          {busy && <p role="status">正在检索当前项目并生成回答…</p>}
+          {error && <p role="alert">{error}</p>}
+          {answer && (
+            <div className="hub-answer">
+              <p>{answer.answer}</p>
+              <h3>引用记忆</h3>
+              {answer.memories.length ? (
+                <ul>
+                  {answer.memories.map((item) => (
+                    <li key={item.memory_id}>
+                      {onOpenMemory ? (
+                        <button
+                          type="button"
+                          onClick={() => onOpenMemory(item.memory_id)}
+                        >
+                          {item.content}
+                        </button>
+                      ) : (
+                        item.content
+                      )}
+                    </li>
+                  ))}
+                </ul>
+              ) : (
+                <p>没有引用记忆。</p>
+              )}
+            </div>
+          )}
+        </>
+      )}
+    </section>
+  );
+}
diff --git a/memhub/apps/web/src/hub-api.ts b/memhub/apps/web/src/hub-api.ts
new file mode 100644
index 0000000..c210fb6
--- /dev/null
+++ b/memhub/apps/web/src/hub-api.ts
@@ -0,0 +1,255 @@
+/** Administrator console transport. Never falls back to Core's local namespace. */
+export interface HubProject {
+  scope_id: string;
+  display_name: string;
+}
+export interface HubBootstrap {
+  schema_version: 1;
+  mode: "hub";
+  product: "Cloud Memory Hub";
+  instance_id: string;
+  version: string | null;
+  build_revision: string | null;
+  features: string[];
+  projects: HubProject[];
+  next_offset: number | null;
+  global_scope: HubProject;
+}
+export interface HubSource {
+  source_id: string;
+  device_id: string;
+  scope_id: string;
+  display_name: string;
+  adapter_id: string;
+  status: string;
+  device_display_name: string;
+  device_status: string;
+}
+export interface HubSummary {
+  scope: HubProject;
+  sources: HubSource[];
+  sources_total: number;
+  next_offset: number | null;
+  visible_memory_total: number | null;
+  visible_history_total: number | null;
+}
+export interface HubItem {
+  record_id: string;
+  kind: "memory" | "history";
+  content: string;
+  content_offset: number;
+  next_content_offset: number | null;
+  layer: string | null;
+  agent_id: string;
+  session_id: string | null;
+  source: string | null;
+  source_raw_ids: string[];
+  memory_at: number | null;
+}
+export type HubReadOperation =
+  | "memory-list"
+  | "memory-get"
+  | "memory-search"
+  | "history-list"
+  | "history-get";
+export interface HubPage {
+  items: HubItem[];
+  next_offset: number | null;
+  candidate_limit_reached: boolean;
+}
+
+export class HubError extends Error {}
+const errors: Record<string, string> = {
+  administrator_required: "登录已失效，请重新登录管理网页。",
+  authentication_required: "登录已失效，请重新登录管理网页。",
+  console_scope_not_found: "这个项目已不存在，请刷新项目列表后重新选择。",
+  record_not_found: "这条内容已不可读取，请刷新当前项目。",
+  read_busy: "记忆服务正在处理其他请求，请稍后重试。",
+  read_unavailable: "记忆服务暂时不可用，请稍后重试。",
+  query_requires_refiltering: "问题中含有需要保护的内容，请移除凭证后重试。",
+  memory_answer_provider_unsupported:
+    "当前模型尚不支持网页问答，请检查模型配置。",
+  memory_answer_model_unavailable: "无法连接问答模型，请检查模型设置后重试。",
+  memory_answer_model_failed: "问答模型未能完成请求，请检查模型设置后重试。",
+};
+export function hubErrorMessage(error: unknown): string {
+  return error instanceof HubError
+    ? error.message
+    : "读取未完成，请检查连接后重试。";
+}
+function invalid(): never {
+  throw new HubError("服务返回的数据与当前项目不一致，请刷新后重试。");
+}
+function object(value: unknown): Record<string, unknown> {
+  if (!value || typeof value !== "object" || Array.isArray(value)) invalid();
+  return value as Record<string, unknown>;
+}
+function cursor(value: unknown): value is number | null {
+  return value === null || (Number.isSafeInteger(value) && Number(value) >= 0);
+}
+function project(value: unknown): HubProject {
+  const row = object(value);
+  if (
+    typeof row.scope_id !== "string" ||
+    !row.scope_id ||
+    typeof row.display_name !== "string"
+  )
+    invalid();
+  return row as unknown as HubProject;
+}
+async function request(
+  path: string,
+  body?: unknown,
+  signal?: AbortSignal,
+): Promise<unknown> {
+  const response = await fetch(`/hub/v1/console/${path}`, {
+    method: body === undefined ? "GET" : "POST",
+    credentials: "same-origin",
+    cache: "no-store",
+    headers:
+      body === undefined ? undefined : { "Content-Type": "application/json" },
+    body: body === undefined ? undefined : JSON.stringify(body),
+    signal,
+  });
+  if (!response.ok) {
+    let code: unknown;
+    try {
+      code = object(await response.json()).detail;
+    } catch {
+      /* Never echo a server body. */
+    }
+    throw new HubError(
+      typeof code === "string" && errors[code]
+        ? errors[code]
+        : response.status === 404
+          ? "当前服务尚不支持这个网页接口，请升级 Hub 后重试。"
+          : response.status === 401 || response.status === 403
+            ? "当前请求未获授权，请重新登录后重试。"
+            : "读取未完成，请检查服务状态后重试。",
+    );
+  }
+  try {
+    return await response.json();
+  } catch {
+    return invalid();
+  }
+}
+export async function getHubBootstrap(
+  offset = 0,
+  signal?: AbortSignal,
+): Promise<HubBootstrap> {
+  const value = object(
+    await request(`bootstrap?limit=50&offset=${offset}`, undefined, signal),
+  );
+  if (
+    value.schema_version !== 1 ||
+    value.mode !== "hub" ||
+    value.product !== "Cloud Memory Hub" ||
+    typeof value.instance_id !== "string" ||
+    !Array.isArray(value.projects) ||
+    !Array.isArray(value.features) ||
+    !value.features.every((v) => typeof v === "string") ||
+    !cursor(value.next_offset) ||
+    !(value.version === null || typeof value.version === "string") ||
+    !(value.build_revision === null || typeof value.build_revision === "string")
+  )
+    invalid();
+  value.projects.forEach(project);
+  if (project(value.global_scope).scope_id !== "global") invalid();
+  return value as unknown as HubBootstrap;
+}
+export async function getHubSummary(
+  instance: string,
+  scope: string,
+  offset = 0,
+  signal?: AbortSignal,
+): Promise<HubSummary> {
+  const value = object(
+    await request("summary", { scope_id: scope, limit: 10, offset }, signal),
+  );
+  if (
+    value.schema_version !== 1 ||
+    value.instance_id !== instance ||
+    project(value.scope).scope_id !== scope ||
+    !Array.isArray(value.sources) ||
+    !cursor(value.next_offset) ||
+    !Number.isSafeInteger(value.sources_total) ||
+    !cursor(value.visible_memory_total) ||
+    !cursor(value.visible_history_total)
+  )
+    invalid();
+  for (const raw of value.sources) {
+    const row = object(raw);
+    if (
+      row.scope_id !== scope ||
+      ![
+        "source_id",
+        "device_id",
+        "display_name",
+        "adapter_id",
+        "status",
+        "device_display_name",
+        "device_status",
+      ].every((key) => typeof row[key] === "string")
+    )
+      invalid();
+  }
+  return value as unknown as HubSummary;
+}
+export async function readHub(
+  instance: string,
+  scope: string,
+  operation: HubReadOperation,
+  parameters: Record<string, unknown> = {},
+  signal?: AbortSignal,
+): Promise<HubPage> {
+  const value = object(
+    await request(
+      `read/${operation}`,
+      { ...parameters, scope_id: scope },
+      signal,
+    ),
+  );
+  if (
+    value.schema_version !== 1 ||
+    value.authority !== "administrator" ||
+    value.instance_id !== instance ||
+    value.scope_id !== scope ||
+    value.operation !== operation ||
+    value.content_trust !== "untrusted_history" ||
+    !Array.isArray(value.items) ||
+    value.items.length > 10 ||
+    value.returned_count !== value.items.length ||
+    !cursor(value.next_offset) ||
+    typeof value.candidate_limit_reached !== "boolean"
+  )
+    invalid();
+  const kind = operation.startsWith("history-") ? "history" : "memory";
+  for (const raw of value.items) {
+    const item = object(raw);
+    if (
+      item.kind !== kind ||
+      typeof item.record_id !== "string" ||
+      typeof item.content !== "string" ||
+      !cursor(item.content_offset) ||
+      item.content_offset === null ||
+      !cursor(item.next_content_offset) ||
+      typeof item.agent_id !== "string" ||
+      !(item.layer === null || typeof item.layer === "string") ||
+      !(item.source === null || typeof item.source === "string") ||
+      !(item.session_id === null || typeof item.session_id === "string") ||
+      !Array.isArray(item.source_raw_ids) ||
+      !item.source_raw_ids.every((v) => typeof v === "string") ||
+      !cursor(item.memory_at)
+    )
+      invalid();
+    if (
+      operation.endsWith("-get") &&
+      (item.record_id !== parameters.record_id ||
+        item.content_offset !== (parameters.content_offset ?? 0))
+    )
+      invalid();
+  }
+  if (operation.endsWith("-get") && value.items.length !== 1) invalid();
+  return value as unknown as HubPage;
+}
