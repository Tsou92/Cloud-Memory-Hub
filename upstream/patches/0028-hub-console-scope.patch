index 0000000..543833a
--- /dev/null
+++ b/memhub/apps/web/src/HubQuestion.test.tsx
@@ -0,0 +1,111 @@
+// @vitest-environment jsdom
+import { cleanup, render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, expect, it, vi } from "vitest";
+import { askHub, HubQuestion } from "./HubQuestion";
+
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+function stream(events: unknown[]) {
+  return new Response(
+    events.map((event) => `data: ${JSON.stringify(event)}\n\n`).join(""),
+    { headers: { "Content-Type": "text/event-stream" } },
+  );
+}
+const final = {
+  type: "final",
+  schema_version: 2,
+  answer: "合成回答",
+  mode: "generated",
+  memories: [{ memory_id: "memory-1", content: "合成依据" }],
+};
+it("posts the explicit scope and displays only a completed answer with references", async () => {
+  const fetcher = vi
+    .fn()
+    .mockResolvedValue(
+      stream([
+        { type: "recall", memories: [] },
+        { type: "delta", text: "片段" },
+        final,
+      ]),
+    );
+  vi.stubGlobal("fetch", fetcher);
+  render(<HubQuestion scope="project-a" instance="instance" enabled />);
+  await userEvent.type(
+    screen.getByRole("textbox", { name: "你的问题" }),
+    "测试问题",
+  );
+  await userEvent.click(screen.getByRole("button", { name: "提问" }));
+  await screen.findByText("合成回答");
+  expect(screen.getByText("合成依据")).toBeTruthy();
+  expect(fetcher).toHaveBeenCalledWith(
+    "/hub/v1/console/ask-stream",
+    expect.objectContaining({
+      body: JSON.stringify({ scope_id: "project-a", question: "测试问题" }),
+    }),
+  );
+});
+it("does not convert truncated or error streams into successful answers", async () => {
+  vi.stubGlobal(
+    "fetch",
+    vi
+      .fn()
+      .mockResolvedValueOnce(stream([{ type: "delta", text: "未完成" }]))
+      .mockResolvedValueOnce(
+        stream([final, { type: "error", code: "private text" }]),
+      ),
+  );
+  await expect(
+    askHub("project", "question", new AbortController().signal),
+  ).rejects.toThrow("提前结束");
+  await expect(
+    askHub("project", "question", new AbortController().signal),
+  ).rejects.toThrow("问答未完成");
+});
+it("aborts in-flight question work on project unmount", async () => {
+  let signal: AbortSignal | undefined;
+  vi.stubGlobal(
+    "fetch",
+    vi.fn((_url, init: RequestInit) => {
+      signal = init.signal as AbortSignal;
+      return new Promise(() => {});
+    }),
+  );
+  const view = render(
+    <HubQuestion scope="project-a" instance="instance" enabled />,
+  );
+  await userEvent.type(
+    screen.getByRole("textbox", { name: "你的问题" }),
+    "测试问题",
+  );
+  await userEvent.click(screen.getByRole("button", { name: "提问" }));
+  view.unmount();
+  expect(signal?.aborted).toBe(true);
+});
+
+it("accepts CRLF SSE frames split between network chunks", async () => {
+  const encoded = new TextEncoder();
+  const body = new ReadableStream({
+    start(controller) {
+      controller.enqueue(encoded.encode(`data: ${JSON.stringify(final)}\r`));
+      controller.enqueue(encoded.encode("\n\r"));
+      controller.enqueue(encoded.encode("\n"));
+      controller.close();
+    },
+  });
+  vi.stubGlobal(
+    "fetch",
+    vi
+      .fn()
+      .mockResolvedValue(
+        new Response(body, {
+          headers: { "Content-Type": "text/event-stream" },
+        }),
+      ),
+  );
+  expect(
+    await askHub("project", "question", new AbortController().signal),
+  ).toMatchObject({ answer: "合成回答" });
+});
