@@ -0,0 +1,128 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { getHubBootstrap, getHubSummary, readHub } from "./hub-api";
+
+const item = {
+  record_id: "memory-1",
+  kind: "memory",
+  content: "合成内容",
+  content_offset: 0,
+  next_content_offset: null,
+  agent_id: "agent",
+  layer: "fact",
+  session_id: null,
+  source: null,
+  source_raw_ids: [],
+  memory_at: null,
+};
+const page = {
+  schema_version: 1,
+  authority: "administrator",
+  instance_id: "instance",
+  scope_id: "project-a",
+  operation: "memory-list",
+  content_trust: "untrusted_history",
+  items: [item],
+  returned_count: 1,
+  next_offset: null,
+  candidate_limit_reached: false,
+};
+afterEach(() => vi.unstubAllGlobals());
+describe("Hub administrator read transport", () => {
+  it("uses only the same-origin Hub route and explicit project", async () => {
+    const fetcher = vi.fn().mockResolvedValue(Response.json(page));
+    vi.stubGlobal("fetch", fetcher);
+    expect(
+      (await readHub("instance", "project-a", "memory-list", { limit: 10 }))
+        .items,
+    ).toEqual([item]);
+    expect(fetcher).toHaveBeenCalledWith(
+      "/hub/v1/console/read/memory-list",
+      expect.objectContaining({
+        credentials: "same-origin",
+        body: JSON.stringify({ limit: 10, scope_id: "project-a" }),
+      }),
+    );
+    expect(fetcher.mock.calls[0][1].headers.Authorization).toBeUndefined();
+  });
+  it.each([
+    { scope_id: "project-b" },
+    { instance_id: "another" },
+    { operation: "history-list" },
+    { items: [{ ...item, kind: "history" }] },
+    { returned_count: 8 },
+  ])("rejects a mismatched envelope %j", async (change) => {
+    vi.stubGlobal(
+      "fetch",
+      vi.fn().mockResolvedValue(Response.json({ ...page, ...change })),
+    );
+    await expect(
+      readHub("instance", "project-a", "memory-list"),
+    ).rejects.toThrow("不一致");
+  });
+  it("rejects a get response for another record or content block", async () => {
+    vi.stubGlobal(
+      "fetch",
+      vi
+        .fn()
+        .mockResolvedValue(Response.json({ ...page, operation: "memory-get" })),
+    );
+    await expect(
+      readHub("instance", "project-a", "memory-get", { record_id: "memory-2" }),
+    ).rejects.toThrow();
+  });
+  it("keeps a filtered empty page pageable without inventing a total", async () => {
+    vi.stubGlobal(
+      "fetch",
+      vi.fn().mockResolvedValue(
+        Response.json({
+          ...page,
+          items: [],
+          returned_count: 0,
+          next_offset: 10,
+        }),
+      ),
+    );
+    expect(await readHub("instance", "project-a", "memory-list")).toMatchObject(
+      { items: [], next_offset: 10 },
+    );
+  });
+  it("does not expose a server error body or use a local fallback", async () => {
+    const fetcher = vi
+      .fn()
+      .mockResolvedValue(
+        Response.json({ detail: "private diagnostic" }, { status: 503 }),
+      );
+    vi.stubGlobal("fetch", fetcher);
+    await expect(
+      readHub("instance", "project-a", "memory-list"),
+    ).rejects.toThrow("服务状态");
+    expect(fetcher).toHaveBeenCalledTimes(1);
+  });
+  it("rejects a missing bootstrap instead of switching to local data", async () => {
+    vi.stubGlobal(
+      "fetch",
+      vi.fn().mockResolvedValue(new Response("", { status: 404 })),
+    );
+    await expect(getHubBootstrap()).rejects.toThrow("升级 Hub");
+  });
+  it("rejects summary sources belonging to another project", async () => {
+    vi.stubGlobal(
+      "fetch",
+      vi.fn().mockResolvedValue(
+        Response.json({
+          schema_version: 1,
+          instance_id: "instance",
+          scope: { scope_id: "project-a", display_name: "A" },
+          sources: [{ scope_id: "project-b" }],
+          sources_total: 1,
+          next_offset: null,
+          visible_memory_total: null,
+          visible_history_total: null,
+        }),
+      ),
+    );
+    await expect(getHubSummary("instance", "project-a")).rejects.toThrow(
+      "不一致",
+    );
+  });
+});
