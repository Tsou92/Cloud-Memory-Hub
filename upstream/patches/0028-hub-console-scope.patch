@@ -0,0 +1,375 @@
+import { useEffect, useMemo, useState } from "react";
+import { HubProvider, useHub } from "./HubContext";
+import { HubQuestion } from "./HubQuestion";
+import {
+  getHubSummary,
+  type HubItem,
+  type HubPage,
+  type HubProject,
+  type HubSummary,
+  hubErrorMessage,
+  readHub,
+} from "./hub-api";
+import { R6Button } from "./R6Controls";
+import { R6Settings } from "./R6Settings";
+import { type MemoryLibraryReader, SdkMemoryLibrary } from "./SdkMemoryLibrary";
+import { type RawHistoryReader, SdkRawHistory } from "./SdkRawHistory";
+import "./hub-console.css";
+
+type View = "home" | "library" | "history" | "ask" | "settings";
+const views: [View, string][] = [
+  ["home", "首页与设备"],
+  ["library", "记忆库"],
+  ["history", "历史原文"],
+  ["ask", "问记忆"],
+  ["settings", "模型与帮助"],
+];
+const memory = (item: HubItem) => ({
+  memory_id: item.record_id,
+  content: item.content,
+  layer: item.layer ?? "",
+  status: "active" as const,
+  next_content_offset: item.next_content_offset,
+});
+const history = (item: HubItem) => ({
+  raw_id: item.record_id,
+  content: item.content,
+  source: item.source ?? "",
+  session_id: item.session_id ?? "",
+  memory_at: item.memory_at,
+  next_content_offset: item.next_content_offset,
+});
+
+export function HubConsole() {
+  return (
+    <HubProvider>
+      <Console />
+    </HubProvider>
+  );
+}
+function Console() {
+  const { bootstrap, project, select, moreProjects, refresh, loading, error } =
+    useHub();
+  const [view, setView] = useState<View>("home");
+  useEffect(() => {
+    document.title = "Cloud Memory Hub";
+  }, []);
+  return (
+    <div className="hub-console">
+      <a className="skip-link" href="#main-content">
+        跳到主要内容
+      </a>
+      <header className="hub-header">
+        <div>
+          <strong>Cloud Memory Hub</strong>
+          <p>NAS 上的共享记忆</p>
+        </div>
+        <a
+          href="/api/v1/ui/session/logout"
+          onClick={(event) => {
+            event.preventDefault();
+            void fetch("/api/v1/ui/session/logout", {
+              method: "POST",
+              credentials: "same-origin",
+            }).then((response) => {
+              if (response.ok) window.location.assign("/hub/login");
+            });
+          }}
+        >
+          退出登录
+        </a>
+      </header>
+      <div className="hub-project-select">
+        <label>
+          当前项目{" "}
+          <select
+            aria-label="当前项目"
+            value={project?.scope_id ?? ""}
+            onChange={(event) => select(event.target.value)}
+          >
+            <option value="">请选择一个项目</option>
+            {bootstrap.projects.map((row) => (
+              <option key={row.scope_id} value={row.scope_id}>
+                {row.display_name}
+              </option>
+            ))}
+            <option value="global">全局偏好（独立范围）</option>
+          </select>
+        </label>
+        <R6Button variant="quiet" disabled={loading} onClick={refresh}>
+          刷新项目
+        </R6Button>
+        {bootstrap.next_offset !== null && (
+          <R6Button disabled={loading} onClick={moreProjects}>
+            更多项目
+          </R6Button>
+        )}
+        {error && <p role="alert">{error}</p>}
+      </div>
+      <nav className="hub-navigation" aria-label="主要导航">
+        {views.map(([id, label]) => (
+          <R6Button
+            key={id}
+            variant={view === id ? "primary" : "quiet"}
+            aria-current={view === id ? "page" : undefined}
+            onClick={() => setView(id)}
+          >
+            {label}
+          </R6Button>
+        ))}
+      </nav>
+      <main id="main-content" className="hub-content">
+        {view === "settings" ? (
+          <R6Settings
+            onDiagnostics={() => {}}
+            hub={{
+              version: bootstrap.version,
+              revision: bootstrap.build_revision,
+            }}
+          />
+        ) : project ? (
+          <ProjectContent
+            key={`${bootstrap.instance_id}:${project.scope_id}:${view}`}
+            view={view}
+            project={project}
+          />
+        ) : (
+          <section className="hub-card">
+            <h1>
+              {bootstrap.projects.length ? "选择要查看的项目" : "还没有项目"}
+            </h1>
+            <p>
+              {bootstrap.projects.length
+                ? "请选择一个项目，查看该项目的记忆、历史和设备。"
+                : "创建项目并配对设备后，共享内容会出现在这里。网页创建和配对向导尚未接通；请按安装文档完成配置。"}
+            </p>
+            <p>全局偏好是独立范围，不会混合显示各项目的内容。</p>
+          </section>
+        )}
+      </main>
+    </div>
+  );
+}
+function ProjectContent({
+  view,
+  project,
+}: {
+  view: Exclude<View, "settings">;
+  project: HubProject;
+}) {
+  const { bootstrap } = useHub();
+  const scope = project.scope_id;
+  const instance = bootstrap.instance_id;
+  const [citationId, setCitationId] = useState<string | null>(null);
+  const readers = useMemo(
+    () => ({
+      memory: {
+        errorMessage: hubErrorMessage,
+        async list(offset: number) {
+          const page = await readHub(instance, scope, "memory-list", {
+            limit: 10,
+            offset,
+          });
+          return {
+            memories: page.items.map(memory),
+            next_offset: page.next_offset,
+          };
+        },
+        async get(id: string, offset = 0, signal?: AbortSignal) {
+          const page = await readHub(
+            instance,
+            scope,
+            "memory-get",
+            {
+              record_id: id,
+              content_offset: offset,
+            },
+            signal,
+          );
+          return memory(page.items[0]);
+        },
+      } satisfies MemoryLibraryReader,
+      history: {
+        errorMessage: hubErrorMessage,
+        async list(offset: number) {
+          const page = await readHub(instance, scope, "history-list", {
+            limit: 10,
+            offset,
+          });
+          return {
+            items: page.items.map(history),
+            next_offset: page.next_offset,
+          };
+        },
+        async get(id: string, offset: number) {
+          const page = await readHub(instance, scope, "history-get", {
+            record_id: id,
+            content_offset: offset,
+          });
+          return history(page.items[0]);
+        },
+      } satisfies RawHistoryReader,
+    }),
+    [instance, scope],
+  );
+  return (
+    <>
+      <h1>{project.display_name}</h1>
+      {view === "home" && <HubHome project={project} />}
+      {view === "library" && (
+        <SdkMemoryLibrary active reader={readers.memory} />
+      )}
+      {view === "history" && <SdkRawHistory reader={readers.history} />}
+      {view === "ask" && (
+        <>
+          <HubQuestion
+            instance={instance}
+            scope={scope}
+            enabled={bootstrap.features.includes("scoped_console_ask")}
+            onOpenMemory={setCitationId}
+          />
+          {citationId && (
+            <section className="hub-card" aria-label="引用记忆详情">
+              <h2>引用记忆详情</h2>
+              <R6Button variant="quiet" onClick={() => setCitationId(null)}>
+                关闭引用详情
+              </R6Button>
+              <SdkMemoryLibrary
+                key={citationId}
+                active
+                detailOnly
+                reader={readers.memory}
+                focusedMemoryId={citationId}
+              />
+            </section>
+          )}
+        </>
+      )}
+    </>
+  );
+}
+function HubHome({ project }: { project: HubProject }) {
+  const { bootstrap } = useHub();
+  const [summary, setSummary] = useState<HubSummary | null>(null);
+  const [page, setPage] = useState<HubPage | null>(null);
+  const [error, setError] = useState("");
+  const [memoryError, setMemoryError] = useState("");
+  const [offset, setOffset] = useState(0);
+  const [revision, setRevision] = useState(0);
+  useEffect(() => {
+    void revision; // Explicit refresh reloads both project panels.
+    const controller = new AbortController();
+    setSummary(null);
+    setPage(null);
+    setError("");
+    setMemoryError("");
+    void getHubSummary(
+      bootstrap.instance_id,
+      project.scope_id,
+      offset,
+      controller.signal,
+    ).then(
+      (value) => {
+        if (!controller.signal.aborted) setSummary(value);
+      },
+      (reason) => {
+        if (!controller.signal.aborted) setError(hubErrorMessage(reason));
+      },
+    );
+    void readHub(
+      bootstrap.instance_id,
+      project.scope_id,
+      "memory-list",
+      { limit: 3, offset: 0 },
+      controller.signal,
+    ).then(
+      (value) => {
+        if (!controller.signal.aborted) setPage(value);
+      },
+      (reason) => {
+        if (!controller.signal.aborted) setMemoryError(hubErrorMessage(reason));
+      },
+    );
+    return () => controller.abort();
+  }, [bootstrap.instance_id, project, offset, revision]);
+  return (
+    <div className="hub-overview">
+      <section className="hub-card">
+        <h2>项目记忆</h2>
+        {memoryError ? (
+          <p role="alert">{memoryError}</p>
+        ) : page ? (
+          <>
+            <p>已加载 {page.items.length} 条记忆预览 · 总数尚未统计</p>
+            <ul>
+              {page.items.map((item) => (
+                <li key={item.record_id}>{item.content}</li>
+              ))}
+            </ul>
+            {!page.items.length && (
+              <p>
+                {page.next_offset !== null
+                  ? "本批内容已被过滤，请在记忆库继续翻页。"
+                  : "当前项目尚无可显示的记忆。"}
+              </p>
+            )}
+          </>
+        ) : (
+          <p role="status">正在读取记忆…</p>
+        )}
+      </section>
+      <section className="hub-card">
+        <h2>此项目的设备与来源</h2>
+        <p>这里只显示授权状态，不表示设备在线或本地队列已同步。</p>
+        {error ? (
+          <p role="alert">{error}</p>
+        ) : summary ? (
+          <>
+            <p>
+              本页 {summary.sources.length} 个来源 · 共 {summary.sources_total}{" "}
+              个
+            </p>
+            <ul>
+              {summary.sources.map((source) => (
+                <li key={source.source_id}>
+                  <strong>{source.device_display_name}</strong> ·{" "}
+                  {source.display_name} · {source.adapter_id}
+                  <span>
+                    {" "}
+                    ·{" "}
+                    {source.status === "active" &&
+                    source.device_status === "active"
+                      ? "已授权"
+                      : "已停用"}
+                  </span>
+                </li>
+              ))}
+            </ul>
+            {!summary.sources.length && (
+              <p>此项目还没有注册来源，请按安装文档配对设备。</p>
+            )}
+            <nav aria-label="设备来源分页">
+              <R6Button
+                disabled={offset === 0}
+                onClick={() => setOffset(Math.max(0, offset - 10))}
+              >
+                上一页
+              </R6Button>
+              <R6Button
+                disabled={summary.next_offset === null}
+                onClick={() => setOffset(summary.next_offset ?? offset)}
+              >
+                下一页
+              </R6Button>
+            </nav>
+          </>
+        ) : (
+          <p role="status">正在读取设备…</p>
+        )}
+      </section>
+      <R6Button variant="quiet" onClick={() => setRevision((v) => v + 1)}>
+        刷新当前项目
+      </R6Button>
+    </div>
+  );
+}
