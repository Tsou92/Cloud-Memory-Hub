+// @vitest-environment jsdom
+import { act, cleanup, render, screen, waitFor } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { HubConsole } from "./HubConsole";
+
+const local = vi.hoisted(() =>
+  vi.fn(() => {
+    throw new Error("local_api_must_not_run");
+  }),
+);
+vi.mock("./api", () => ({
+  getSdkMemory: local,
+  getSdkMemoryLibrary: local,
+  updateSdkMemory: local,
+  deleteSdkMemory: local,
+  getSdkRaw: local,
+  searchSdkRaw: local,
+}));
+vi.mock("./R6Settings", () => ({ R6Settings: () => <p>模型设置</p> }));
+const bootstrap = {
+  schema_version: 1,
+  product: "Cloud Memory Hub",
+  mode: "hub",
+  instance_id: "instance",
+  version: "0.1.0",
+  build_revision: null,
+  features: ["scoped_console_reads"],
+  next_offset: null,
+  projects: [
+    { scope_id: "project-a", display_name: "项目 A" },
+    { scope_id: "project-b", display_name: "项目 B" },
+  ],
+  global_scope: { scope_id: "global", display_name: "Global preferences" },
+};
+function page(scope: string, operation: string, extra = {}) {
+  return {
+    schema_version: 1,
+    authority: "administrator",
+    instance_id: "instance",
+    scope_id: scope,
+    operation,
+    content_trust: "untrusted_history",
+    returned_count: 1,
+    next_offset: null,
+    candidate_limit_reached: false,
+    items: [
+      {
+        record_id: `${scope}-item`,
+        kind: operation.startsWith("history") ? "history" : "memory",
+        content: `${scope} 的合成内容`,
+        content_offset: 0,
+        next_content_offset: null,
+        layer: "fact",
+        agent_id: "agent",
+        session_id: "session",
+        source: "source",
+        source_raw_ids: [],
+        memory_at: null,
+      },
+    ],
+    ...extra,
+  };
+}
+function handler(url: string, init?: RequestInit): Promise<Response> {
+  if (url.includes("bootstrap"))
+    return Promise.resolve(Response.json(bootstrap));
+  const body = JSON.parse(String(init?.body));
+  if (url.endsWith("summary"))
+    return Promise.resolve(
+      Response.json({
+        schema_version: 1,
+        instance_id: "instance",
+        scope: { scope_id: body.scope_id, display_name: body.scope_id },
+        next_offset: null,
+        visible_memory_total: null,
+        visible_history_total: null,
+        sources_total: 1,
+        sources: [
+          {
+            source_id: "source",
+            device_id: "device",
+            scope_id: body.scope_id,
+            display_name: "Claude",
+            adapter_id: "claude",
+            status: "active",
+            device_display_name: "测试 Mac",
+            device_status: "active",
+          },
+        ],
+      }),
+    );
+  return Promise.resolve(
+    Response.json(page(body.scope_id, url.split("/").at(-1) ?? "invalid")),
+  );
+}
+function withAsk(url: string, init?: RequestInit): Promise<Response> {
+  if (url.includes("bootstrap"))
+    return Promise.resolve(
+      Response.json({
+        ...bootstrap,
+        features: ["scoped_console_reads", "scoped_console_ask"],
+      }),
+    );
+  if (url.endsWith("ask-stream")) {
+    const { scope_id } = JSON.parse(String(init?.body));
+    return Promise.resolve(
+      new Response(
+        `data: ${JSON.stringify({
+          type: "final",
+          schema_version: 2,
+          answer: "合成回答",
+          mode: "generated",
+          memories: [
+            { memory_id: `${scope_id}-item`, content: `${scope_id}引用预览` },
+          ],
+        })}\n\n`,
+        { headers: { "Content-Type": "text/event-stream" } },
+      ),
+    );
+  }
+  return handler(url, init);
+}
+let fetcher: ReturnType<typeof vi.fn>;
+beforeEach(() => {
+  fetcher = vi.fn(handler);
+  vi.stubGlobal("fetch", fetcher);
+  local.mockClear();
+});
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+async function select(scope = "project-a") {
+  await userEvent.selectOptions(
+    await screen.findByRole("combobox", { name: "当前项目" }),
+    scope,
+  );
+}
+async function askAndOpen(scope = "project-a") {
+  await userEvent.click(screen.getByRole("button", { name: "问记忆" }));
+  await userEvent.type(
+    screen.getByRole("textbox", { name: "你的问题" }),
+    "测试问题",
+  );
+  await userEvent.click(screen.getByRole("button", { name: "提问" }));
+  await userEvent.click(
+    await screen.findByRole("button", { name: `${scope}引用预览` }),
+  );
+}
+
+it("opens a citation through current-project memory-get without loading another library", async () => {
+  fetcher.mockImplementation(withAsk);
+  render(<HubConsole />);
+  await select();
+  await askAndOpen();
+  await screen.findByText("project-a 的合成内容");
+  expect(screen.getByRole("region", { name: "引用记忆详情" })).toBeTruthy();
+  expect(
+    screen.queryByRole("navigation", { name: "SDK 记忆库分页" }),
+  ).toBeNull();
+  expect(fetcher).toHaveBeenCalledWith(
+    "/hub/v1/console/read/memory-get",
+    expect.objectContaining({
+      body: JSON.stringify({
+        record_id: "project-a-item",
+        content_offset: 0,
+        scope_id: "project-a",
+      }),
+    }),
+  );
+  expect(local).not.toHaveBeenCalled();
+  await userEvent.click(screen.getByRole("button", { name: "记忆库" }));
+  await userEvent.click(screen.getByRole("button", { name: "问记忆" }));
+  expect(screen.queryByRole("region", { name: "引用记忆详情" })).toBeNull();
+});
+
