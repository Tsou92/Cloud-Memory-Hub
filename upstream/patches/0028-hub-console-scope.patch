diff --git a/memhub/apps/web/src/HubContext.tsx b/memhub/apps/web/src/HubContext.tsx
new file mode 100644
index 0000000..f8a5976
--- /dev/null
+++ b/memhub/apps/web/src/HubContext.tsx
@@ -0,0 +1,117 @@
+import {
+  createContext,
+  type ReactNode,
+  useContext,
+  useEffect,
+  useRef,
+  useState,
+} from "react";
+import {
+  getHubBootstrap,
+  type HubBootstrap,
+  type HubProject,
+  hubErrorMessage,
+} from "./hub-api";
+
+interface HubState {
+  bootstrap: HubBootstrap;
+  project: HubProject | null;
+  select(scope: string): void;
+  moreProjects(): void;
+  refresh(): void;
+  loading: boolean;
+  error: string;
+}
+const Context = createContext<HubState | null>(null);
+export function useHub() {
+  const value = useContext(Context);
+  if (!value) throw new Error("hub_context_required");
+  return value;
+}
+export function HubProvider({ children }: { children: ReactNode }) {
+  const [bootstrap, setBootstrap] = useState<HubBootstrap | null>(null);
+  const [scope, setScope] = useState("");
+  const [offset, setOffset] = useState(0);
+  const [revision, setRevision] = useState(0);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState("");
+  const instance = useRef<string | null>(null);
+  useEffect(() => {
+    void revision; // Explicit refresh retries an unchanged endpoint.
+    const controller = new AbortController();
+    setLoading(true);
+    setError("");
+    void getHubBootstrap(offset, controller.signal)
+      .then(
+        (next) => {
+          if (controller.signal.aborted) return;
+          if (offset > 0 && instance.current !== next.instance_id) {
+            setScope("");
+            setBootstrap(null);
+            setError("服务实例已改变，请刷新项目列表后重新选择。");
+            return;
+          }
+          instance.current = next.instance_id;
+          setBootstrap((previous) => {
+            if (offset === 0 || !previous) return next;
+            const projects = new Map(
+              previous.projects.map((row) => [row.scope_id, row]),
+            );
+            for (const row of next.projects) projects.set(row.scope_id, row);
+            return { ...next, projects: [...projects.values()] };
+          });
+        },
+        (reason) => {
+          if (!controller.signal.aborted) setError(hubErrorMessage(reason));
+        },
+      )
+      .finally(() => {
+        if (!controller.signal.aborted) setLoading(false);
+      });
+    return () => controller.abort();
+  }, [offset, revision]);
+  const refresh = () => {
+    setScope("");
+    setBootstrap(null);
+    setOffset(0);
+    setRevision((v) => v + 1);
+  };
+  if (!bootstrap)
+    return (
+      <main className="hub-start" aria-label="Cloud Memory Hub">
+        <h1>Cloud Memory Hub</h1>
+        {error ? (
+          <>
+            <p role="alert">{error}</p>
+            <button type="button" onClick={refresh}>
+              重试连接
+            </button>
+            <a href="/hub/login">重新登录</a>
+          </>
+        ) : (
+          <p role="status">正在连接 NAS 记忆服务…</p>
+        )}
+      </main>
+    );
+  const project =
+    [...bootstrap.projects, bootstrap.global_scope].find(
+      (row) => row.scope_id === scope,
+    ) ?? null;
+  return (
+    <Context.Provider
+      value={{
+        bootstrap,
+        project,
+        error,
+        loading,
+        refresh,
+        select: setScope,
+        moreProjects: () => {
+          if (bootstrap.next_offset !== null) setOffset(bootstrap.next_offset);
+        },
+      }}
+    >
+      {children}
+    </Context.Provider>
+  );
+}
