+"""Offline Messages protocol contract through the shared LLMProvider entrypoints."""
+
+import copy
+import json
+import logging
+
+import httpx
+import pytest
+
+from hy_memory.agent.anthropic_messages import AnthropicRequestError, messages_url
+from hy_memory.agent.extractor import Extractor
+from hy_memory.agent.llm_provider import LLMProvider, LLMRetryError
+from hy_memory.config import MemoryConfig
+
+
+def reply(content=None, *, reason="end_turn", usage=None):
+    return {
+        "id": "msg_synthetic",
+        "type": "message",
+        "role": "assistant",
+        "model": "synthetic-model",
+        "content": content if content is not None else [{"type": "text", "text": "ok"}],
+        "stop_reason": reason,
+        "usage": usage or {"input_tokens": 7, "output_tokens": 3},
+    }
+
+
+def provider(handler, **overrides):
+    config = MemoryConfig()
+    config.llm.provider = "anthropic"
+    config.llm.model = "synthetic-model"
+    config.llm.api_key = "synthetic-secret-key"  # pragma: allowlist secret
+    config.llm.base_url = "https://model.example.test/v1"
+    config.llm.omit_temperature = True
+    config.llm.max_retries = 3
+    config.llm.retry_delay = 0
+    config.llm.extra_headers = None
+    config.llm.extra_body = None
+    for key, value in overrides.items():
+        setattr(config.llm, key, value)
+    config.http_transport_factory = lambda: httpx.MockTransport(handler)
+    return LLMProvider(config)
+
+
+@pytest.mark.parametrize(
+    "base",
