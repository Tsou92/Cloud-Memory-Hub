+        secrets=secrets,
+    )
+    snapshot = store.snapshot(profile.profile_id, profile.revision)
+    with sqlite3.connect(database) as connection:
+        connection.execute("BEGIN IMMEDIATE")
+        if not with_key:
+            with pytest.raises(ModelProfileUnavailableError, match="model_secret_required"):
+                store.activate_in_connection(connection, snapshot, expected_secret_ref=None)
+        else:
+            store.activate_in_connection(
+                connection, snapshot, expected_secret_ref=store.secret_ref(profile.profile_id)
+            )
+    active = store.active(secrets)
+    assert (active is not None) is with_key
+    if active is not None:
+        assert active.revision == profile.revision
+        assert active.embedding_provider_kind is ProviderKind.LOCAL_ONNX
+        assert not active.capabilities.structured_output
+    assert API_KEY.encode() not in database.read_bytes()
+
+
