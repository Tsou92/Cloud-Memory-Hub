@@ -0,0 +1,236 @@
+"""Small Messages protocol adapter; extraction and tool execution stay upstream."""
+
+import json
+from urllib.parse import urlsplit, urlunsplit
+
+
+class AnthropicRequestError(RuntimeError):
+    """Safe diagnostic with no request, response body, URL or credentials."""
+
+    def __init__(self, code, *, status_code=None):
+        super().__init__(code)
+        self.status_code = status_code
+
+
+def messages_url(base_url):
+    parts = urlsplit(base_url or "https://api.anthropic.com")
+    if (
+        parts.scheme not in {"http", "https"}
+        or not parts.hostname
+        or parts.username
+        or parts.password
+        or parts.query
+        or parts.fragment
+    ):
+        raise AnthropicRequestError("anthropic_endpoint_invalid")
+    path = parts.path.rstrip("/")
+    if not path.endswith("/v1/messages"):
+        path += "/messages" if path.endswith("/v1") else "/v1/messages"
+    return urlunsplit((parts.scheme, parts.netloc, path, "", ""))
+
+
+def _text_blocks(content):
+    if content is None or content == "":
+        return []
+    if isinstance(content, str):
+        return [{"type": "text", "text": content}]
+    if isinstance(content, list) and all(
+        isinstance(block, dict)
+        and block.get("type") == "text"
+        and isinstance(block.get("text"), str)
+        for block in content
+    ):
+        return [
+            {"type": "text", "text": block["text"]}
+            for block in content
+            if block["text"]
+        ]
+    raise AnthropicRequestError("anthropic_message_content_unsupported")
+
+
+def _tool_use(call):
+    try:
+        function = call["function"]
+        arguments = function.get("arguments", {})
+        if isinstance(arguments, str):
+            arguments = json.loads(arguments)
+        if (
+            not isinstance(call["id"], str)
+            or not call["id"]
+            or not isinstance(function["name"], str)
+            or not function["name"]
+            or not isinstance(arguments, dict)
+        ):
+            raise ValueError
+        return {
+            "type": "tool_use",
+            "id": call["id"],
+            "name": function["name"],
+            "input": arguments,
+        }
+    except (KeyError, TypeError, ValueError, AttributeError):
+        raise AnthropicRequestError("anthropic_tool_call_invalid") from None
+
+
+def build_payload(
+    messages,
+    *,
+    model,
+    max_tokens,
+    temperature=None,
+    stop=None,
+    tools=None,
+    tool_choice=None,
+    extra_body=None,
+):
+    system, turns = [], []
+    for message in messages:
+        role = message.get("role")
+        blocks = _text_blocks(message.get("content"))
+        if role == "system":
+            system.extend(blocks)
+            continue
+        if role == "tool":
+            identity = message.get("tool_call_id")
+            if not isinstance(identity, str) or not identity:
+                raise AnthropicRequestError("anthropic_tool_result_invalid")
+            blocks = [
+                {"type": "tool_result", "tool_use_id": identity, "content": blocks}
+            ]
+            role = "user"
+        elif role == "assistant":
+            blocks.extend(_tool_use(call) for call in message.get("tool_calls") or [])
+        elif role != "user":
+            raise AnthropicRequestError("anthropic_message_role_unsupported")
+        if not blocks:
+            raise AnthropicRequestError("anthropic_message_empty")
+        if turns and turns[-1]["role"] == role:
+            turns[-1]["content"].extend(blocks)
+        else:
+            turns.append({"role": role, "content": blocks})
+    if not turns:
+        raise AnthropicRequestError("anthropic_messages_empty")
+    body = {"model": model, "messages": turns, "max_tokens": max_tokens}
+    if system:
+        body["system"] = system
+    if temperature is not None:
+        body["temperature"] = temperature
+    if stop:
+        body["stop_sequences"] = stop
+    if tools and tool_choice != "none":
+        converted = []
+        try:
+            for tool in tools:
+                function = tool["function"]
+                if tool.get("type", "function") != "function" or not function["name"]:
+                    raise ValueError
+                schema = function.get(
+                    "parameters", {"type": "object", "properties": {}}
+                )
+                if not isinstance(schema, dict):
+                    raise ValueError
+                item = {"name": function["name"], "input_schema": schema}
+                if function.get("description"):
+                    item["description"] = function["description"]
+                converted.append(item)
+        except (KeyError, TypeError, ValueError):
+            raise AnthropicRequestError("anthropic_tool_schema_invalid") from None
+        body["tools"] = converted
+        if tool_choice in (None, "auto"):
+            body["tool_choice"] = {"type": "auto"}
+        elif tool_choice == "required":
+            body["tool_choice"] = {"type": "any"}
+        elif (
+            isinstance(tool_choice, dict)
+            and tool_choice.get("type") == "function"
+            and isinstance(tool_choice.get("function"), dict)
+            and isinstance(tool_choice["function"].get("name"), str)
+        ):
+            body["tool_choice"] = {
+                "type": "tool",
+                "name": tool_choice["function"]["name"],
+            }
+        else:
+            raise AnthropicRequestError("anthropic_tool_choice_unsupported")
+    # No automatic thinking opt-in or OpenAI-specific extra fields. Explicit
+    # thinking-off is the only extension needed by the shared model profile.
+    if extra_body:
+        if extra_body != {"thinking": {"type": "disabled"}}:
+            raise AnthropicRequestError("anthropic_extra_body_unsupported")
+        body["thinking"] = {"type": "disabled"}
+    return body
+
+
+def parse_response(payload, *, model):
+    try:
+        if (
+            not isinstance(payload, dict)
+            or payload.get("type") != "message"
+            or payload.get("role") != "assistant"
+            or not isinstance(payload["content"], list)
+        ):
+            raise ValueError
+        texts, calls = [], []
+        for block in payload["content"]:
+            kind = block["type"]
+            if kind == "text":
+                if not isinstance(block["text"], str):
+                    raise ValueError
+                texts.append(block["text"])
+            elif kind == "tool_use":
+                if (
+                    not isinstance(block["id"], str)
+                    or not block["id"]
+                    or not isinstance(block["name"], str)
+                    or not block["name"]
+                    or not isinstance(block["input"], dict)
+                ):
+                    raise ValueError
+                calls.append(
+                    {
+                        "id": block["id"],
+                        "type": "function",
+                        "function": {
+                            "name": block["name"],
+                            "arguments": json.dumps(block["input"], ensure_ascii=False),
+                        },
+                    }
+                )
+            elif kind not in {"thinking", "redacted_thinking"}:
+                raise ValueError
+        reason = payload["stop_reason"]
+        finish = {
+            "end_turn": "stop",
+            "stop_sequence": "stop",
+            "max_tokens": "length",
+            "tool_use": "tool_calls",
+        }.get(reason)
+        if finish is None or (reason == "tool_use") != bool(calls):
+            raise ValueError
+        if not "".join(texts).strip() and not calls and finish != "length":
+            raise ValueError
+        if len({call["id"] for call in calls}) != len(calls):
+            raise ValueError
+        usage = payload["usage"]
+        counts = [
+            usage["input_tokens"],
+            usage["output_tokens"],
+            usage.get("cache_creation_input_tokens", 0),
+            usage.get("cache_read_input_tokens", 0),
+        ]
+        if any(type(value) is not int or value < 0 for value in counts):
+            raise ValueError
+        inputs, outputs = counts[0] + counts[2] + counts[3], counts[1]
+        return {
+            "content": "".join(texts),
+            "tool_calls": calls or None,
+            "model": payload.get("model") or model,
+            "response_id": payload.get("id") or "",
+            "choices_count": 1,
+            "finish_reason": finish,
+            "tokens_used": inputs + outputs,
+            "prompt_tokens": inputs,
+            "completion_tokens": outputs,
+        }
+    except (KeyError, TypeError, ValueError, AttributeError):
+        raise AnthropicRequestError("anthropic_response_invalid") from None
