+        "https://model.example.test",
+        "https://model.example.test/",
+        "https://model.example.test/v1/",
+        "https://model.example.test/v1/messages",
+    ],
+)
+def test_messages_endpoint_normalization(base):
+    assert messages_url(base) == "https://model.example.test/v1/messages"
