diff --git a/hy_memory/core/write_effects.py b/hy_memory/core/write_effects.py
new file mode 100644
index 0000000..bd4204e
--- /dev/null
+++ b/hy_memory/core/write_effects.py
@@ -0,0 +1,316 @@
+"""Bounded observations of native mutations, never a governance certificate.
+
+The snapshot is only call-local evidence. It is not durable before a mutation,
+not rollback resistant, and does not prove that all persistent domains are covered.
+"""
+
+import copy
+import inspect
+import json
+import threading
+from contextlib import contextmanager
+from contextvars import ContextVar
+from functools import wraps
+
+_CURRENT = ContextVar("hy_write_effect_observation", default=None)
+_DOMAINS = frozenset({"chroma", "history", "cache_request_rows", "cache_episode_state"})
+_DOMAIN_STATES = {
+    "write_outcome": {"known_preexisting_claim_and_terminal_envelope"},
+    "chroma": {"observed", "not_observed"},
+    "history": {"observed", "disabled", "not_observed"},
+    "cache_request_rows": {"observed", "not_observed"},
+    "cache_episode_state": {"observed", "not_observed"},
+    "graph": {"disabled", "not_observed"},
+    "productivity": {"not_used", "not_observed"},
+    "diagnostic_files": {"not_observed"},
+    "entity_index": {"disabled", "not_observed"},
+    "tag_index": {"unsupported_by_backend", "not_observed"},
+    "retrieval_clause_index": {"unsupported_by_backend", "not_observed"},
+}
+_REASONS = frozenset(
+    {
+        "identity_limit",
+        "selector_invalid",
+        "attempt_limit",
+        "byte_limit",
+        "late_mutation",
+        "pending_mutation",
+        "vector_backend_unobserved",
+        "history_backend_unobserved",
+        "cache_backend_unobserved",
+        "graph_unobserved",
+        "productivity_unobserved",
+        "derived_writer_unobserved",
+        "entity_index_unobserved",
+        "background_pipeline_logs_unjoined",
+        "unknown_domain",
+    }
+)
+
+
+class WriteEffectObservation:
+    MAX_ATTEMPTS = 1024
+    MAX_STRING_BYTES = 512
+    MAX_BYTES = 256 * 1024
+
+    def __init__(
+        self, *, request_id, user_id, agent_id, session_id, operation, domains=None
+    ):
+        self._lock = threading.RLock()
+        self._sealed = False
+        self._reasons = set()
+        self._attempts = []
+        self._pending = set()
+        self._bytes = 0
+        self._examined = 0
+        self._unsupported = False
+        self._request = {}
+        for key, value in dict(
+            request_id=request_id,
+            user_id=user_id,
+            agent_id=agent_id,
+            session_id=session_id,
+            operation=operation,
+        ).items():
+            if (
+                not isinstance(value, str)
+                or len(value.encode("utf-8")) > self.MAX_STRING_BYTES
+            ):
+                self._request[key] = None
+                self._reasons.add("identity_limit")
+            else:
+                self._request[key] = value
+        self._domains = {}
+        if isinstance(domains, dict):
+            for name in _DOMAIN_STATES:
+                state = domains.get(name)
+                if isinstance(state, str) and state in _DOMAIN_STATES[name]:
+                    self._domains[name] = state
+                elif name in domains:
+                    self.partial("unknown_domain")
+            if domains.keys() - _DOMAIN_STATES.keys():
+                self.partial("unknown_domain")
+        elif domains is not None:
+            self.partial("unknown_domain")
+        # JSON escaping can expand even ASCII identity bytes sixfold. Reserve
+        # the actual encoded header, with every bounded reason already present.
+        header = self.snapshot()
+        header.update(status="unsupported", reasons=sorted(_REASONS))
+        header["domains"] = {
+            name: max(states, key=len) for name, states in _DOMAIN_STATES.items()
+        }
+        self._header_bytes = len(json.dumps(header, ensure_ascii=False).encode())
+
+    @classmethod
+    def for_client(cls, client, **identity):
+        from ..data.cache_sqlite import SqliteCache
+        from ..data.history_store import HistoryStore
+        from ..data.vector_store_chroma import ChromaVectorStore
+
+        vector = getattr(client, "_vector_store", None)
+        cache = getattr(client, "_cache", None)
+        history = getattr(client, "_history_store", None)
+        graph = getattr(client, "_graph_store", None)
+        recall = getattr(getattr(client, "_config", None), "recall", None)
+        entity_disabled = getattr(recall, "entity_store_enabled", None) is False
+        chroma = type(vector) is ChromaVectorStore
+        sqlite = type(cache) is SqliteCache
+        domains = {
+            "write_outcome": "known_preexisting_claim_and_terminal_envelope",
+            "chroma": "observed" if chroma else "not_observed",
+            "history": "disabled"
+            if history is None
+            else ("observed" if type(history) is HistoryStore else "not_observed"),
+            "cache_request_rows": "observed" if sqlite else "not_observed",
+            "cache_episode_state": "observed" if sqlite else "not_observed",
+            "graph": "disabled" if graph is None else "not_observed",
+            "productivity": "not_used",
+            "diagnostic_files": "not_observed",
+            "entity_index": "disabled" if entity_disabled else "not_observed",
+            "tag_index": "unsupported_by_backend" if chroma else "not_observed",
+            "retrieval_clause_index": "unsupported_by_backend"
+            if chroma
+            else "not_observed",
+        }
+        observation = cls(domains=domains, **identity)
+        for unavailable, reason in (
+            (not chroma, "vector_backend_unobserved"),
+            (not sqlite, "cache_backend_unobserved"),
+            (
+                history is not None and type(history) is not HistoryStore,
+                "history_backend_unobserved",
+            ),
+            (graph is not None, "graph_unobserved"),
+            (not entity_disabled, "entity_index_unobserved"),
+            (getattr(client, "_mode", None) == "ultra", "derived_writer_unobserved"),
+        ):
+            if unavailable:
+                observation.unsupported(reason)
+        return observation
+
+    def activate(self):
+        return _CURRENT.set(self)
+
+    @staticmethod
+    def reset(token):
+        _CURRENT.reset(token)
+
+    def partial(self, reason):
+        with self._lock:
+            self._reasons.add(reason if reason in _REASONS else "unknown_domain")
+
+    def unsupported(self, reason):
+        with self._lock:
+            self._unsupported = True
+            self.partial(reason)
+            if reason == "productivity_unobserved":
+                self._domains["productivity"] = "not_observed"
+
+    def begin(self, domain, operation, selectors):
+        """Record the bounded batch before any backend I/O; never copy bodies."""
+        with self._lock:
+            if self._sealed:
+                self.partial("late_mutation")
+                return ()
+            if domain not in _DOMAINS:
+                self.partial("unknown_domain")
+                return ()
+            tokens = []
+            try:
+                for selector in selectors:
+                    if self._examined >= self.MAX_ATTEMPTS:
+                        self.partial("attempt_limit")
+                        break
+                    self._examined += 1
+                    if (
+                        not isinstance(operation, str)
+                        or len(operation.encode()) > self.MAX_STRING_BYTES
+                        or not isinstance(selector, dict)
+                        or not 1 <= len(selector) <= 3
+                        or any(
+                            key
+                            not in {
+                                "collection",
+                                "node_id",
+                                "memory_id",
+                                "table",
+                                "request_id",
+                                "episode_key",
+                            }
+                            or not isinstance(value, str)
+                            or len(value.encode("utf-8")) > self.MAX_STRING_BYTES
+                            for key, value in selector.items()
+                        )
+                    ):
+                        self.partial("selector_invalid")
+                        continue
+                    entry = {
+                        "domain": domain,
+                        "operation": operation,
+                        "selector": dict(selector),
+                        "state": "uncertain",
+                    }
+                    size = len(json.dumps(entry, ensure_ascii=False).encode()) + 2
+                    # Reserve bounded request/domain/reason/header space.
+                    if self._bytes + size + self._header_bytes > self.MAX_BYTES:
+                        self.partial("byte_limit")
+                        break
+                    index = len(self._attempts)
+                    self._attempts.append(entry)
+                    self._pending.add(index)
+                    self._bytes += size
+                    tokens.append(index)
+            except Exception:
+                self.partial("selector_invalid")
+            return tuple(tokens)
+
+    def finish(self, tokens, *, returned):
+        with self._lock:
+            if self._sealed:
+                self.partial("late_mutation")
+                return
+            for index in tokens:
+                self._pending.discard(index)
+                if returned:
+                    self._attempts[index]["state"] = "returned"
+
+    def seal(self):
+        with self._lock:
+            if self._pending:
+                self.partial("pending_mutation")
+            self._sealed = True
+            return self.snapshot()
+
+    def snapshot(self):
+        """Return a detached snapshot. A sealed snapshot is not a no-late-writes claim."""
+        with self._lock:
+            status = (
+                "unsupported"
+                if self._unsupported
+                else ("partial" if self._reasons else "recorded")
+            )
+            return copy.deepcopy(
+                {
+                    "schema_version": 1,
+                    "observation_only": True,
+                    "all_effects_proven": False,
+                    "status": status,
+                    "snapshot_sealed": self._sealed,
+                    "request": self._request,
+                    "domains": self._domains,
+                    "attempts": self._attempts,
+                    "reasons": sorted(self._reasons),
+                }
+            )
+
+
+def unsupported(reason):
+    observation = _CURRENT.get()
+    if observation is not None:
+        observation.unsupported(reason)
+
+
+@contextmanager
+def observe_mutation(domain, operation, selectors):
+    """Observe an already prepared batch without consuming native inputs twice."""
+    observation = _CURRENT.get()
+    tokens = (
+        observation.begin(domain, operation, selectors)
+        if observation is not None
+        else ()
+    )
+    returned = False
+    try:
+        yield
+        returned = True
+    finally:
+        if observation is not None:
+            observation.finish(tokens, returned=returned)
+
+
+def observe_async(domain, operation, selectors, *, partial_reason=None):
+    """Observe an async facade. 'returned' means normal Python return, not success."""
+
+    def decorate(function):
+        signature = inspect.signature(function)
+
+        @wraps(function)
+        async def observed(*args, **kwargs):
+            observation = _CURRENT.get()
+            if observation is None:
+                return await function(*args, **kwargs)
+            if partial_reason:
+                observation.partial(partial_reason)
+            selected = ()
+            try:
+                arguments = signature.bind(*args, **kwargs)
+                arguments.apply_defaults()
+                selected = selectors(arguments.arguments)
+            except Exception:
+                observation.partial("selector_invalid")
+            with observe_mutation(domain, operation, selected):
+                return await function(*args, **kwargs)
+
+        return observed
+
+    return decorate
