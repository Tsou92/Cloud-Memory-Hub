+}
+
+/* Custom dropdown: native select popups cannot follow the Hub palette. */
+.hub-select {
+  position: relative;
+  display: inline-flex;
+  min-width: 0;
+}
+.hub-select__trigger {
+  display: inline-flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  width: 100%;
+  height: 44px;
+  min-width: 0;
+  padding: 9px 12px;
+  border: 1px solid #454b68;
+  border-radius: 8px;
+  background: #141a2d;
+  color: #edf0fa;
