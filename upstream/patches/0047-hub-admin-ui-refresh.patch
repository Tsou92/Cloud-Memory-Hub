new file mode 100644
index 0000000..c34f6c4
--- /dev/null
+++ b/memhub/apps/web/src/HubContext.preview.test.tsx
@@ -0,0 +1,78 @@
+// @vitest-environment jsdom
+import { cleanup, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { HubProvider, useHub } from "./HubContext";
+
+const project = { scope_id: "scope-1", display_name: "合成项目" };
+const global = { scope_id: "global", display_name: "全局偏好" };
+
+function bootstrap(overrides: Record<string, unknown> = {}) {
+  return {
+    schema_version: 1,
+    mode: "hub",
+    product: "Cloud Memory Hub",
+    instance_id: "instance-1",
+    version: "test",
+    build_revision: null,
+    features: [],
+    projects: [project],
+    next_offset: null,
+    global_scope: global,
+    ...overrides,
+  };
+}
+
+function Probe() {
+  const { project } = useHub();
+  return <p>{project ? `当前:${project.display_name}` : "未选择"}</p>;
+}
+
+function stubBootstrap(body: unknown) {
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(async () => new Response(JSON.stringify(body), { status: 200 })),
+  );
+}
+
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+
+describe("HubProvider preview auto-selection", () => {
+  it("selects the only project in the local copy-only preview", async () => {
+    stubBootstrap(bootstrap({ preview: "ui-copy-synthetic" }));
+    render(
+      <HubProvider>
+        <Probe />
+      </HubProvider>,
+    );
+    expect(await screen.findByText("当前:合成项目")).toBeTruthy();
+  });
+
+  it("keeps manual selection for a real Hub without the preview marker", async () => {
+    stubBootstrap(bootstrap());
+    render(
+      <HubProvider>
+        <Probe />
+      </HubProvider>,
+    );
+    await waitFor(() => expect(screen.getByText("未选择")).toBeTruthy());
+    expect(screen.queryByText("当前:合成项目")).toBeNull();
+  });
+
+  it("does not auto-select when the preview has several projects", async () => {
+    stubBootstrap(
+      bootstrap({
+        preview: "ui-copy-synthetic",
+        projects: [project, { scope_id: "scope-2", display_name: "另一项目" }],
+      }),
+    );
+    render(
+      <HubProvider>
+        <Probe />
+      </HubProvider>,
+    );
+    await waitFor(() => expect(screen.getByText("未选择")).toBeTruthy());
+  });
+});
