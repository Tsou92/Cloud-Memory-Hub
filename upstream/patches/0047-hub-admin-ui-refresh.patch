+// biome-ignore-all lint/a11y/noNoninteractiveElementToInteractiveRole: Custom combobox listbox renders ul/li with ARIA roles.
+// biome-ignore-all lint/a11y/useFocusableInteractive: Focus stays on the combobox trigger; aria-activedescendant tracks the option.
+// biome-ignore-all lint/a11y/useKeyWithClickEvents: Keyboard selection is handled by the combobox trigger.
+import { Check, ChevronDown } from "lucide-react";
+import {
+  type KeyboardEvent,
+  useEffect,
+  useId,
+  useLayoutEffect,
+  useRef,
+  useState,
+} from "react";
+import { createPortal } from "react-dom";
+
+export interface HubSelectOption {
+  value: string;
+  label: string;
+  disabled?: boolean;
+}
+
+interface Position {
+  left: number;
+  top: number;
+  width: number;
+  maxHeight: number;
+}
+
+export function HubSelect({
+  label,
+  value,
+  options,
+  onChange,
+  disabled = false,
+  className = "",
+  variant = "field",
+  align = "start",
+}: {
+  label: string;
+  value: string;
+  options: HubSelectOption[];
+  onChange: (value: string) => void;
+  disabled?: boolean;
+  className?: string;
+  variant?: "field" | "bare";
+  align?: "start" | "end";
+}) {
+  const id = useId();
+  const listId = `${id}-listbox`;
+  const [open, setOpen] = useState(false);
+  const [active, setActive] = useState(0);
+  const [position, setPosition] = useState<Position | null>(null);
+  const trigger = useRef<HTMLButtonElement>(null);
+  const menu = useRef<HTMLUListElement>(null);
+  const selected = options.find((option) => option.value === value);
+  const selectedIndex = options.findIndex((option) => option.value === value);
+
+  function openMenu(initial = selectedIndex) {
+    if (disabled) return;
+    const fallback = options.findIndex((option) => !option.disabled);
+    setActive(initial >= 0 ? initial : Math.max(0, fallback));
+    setOpen(true);
+  }
+  function close() {
+    setOpen(false);
+  }
+  function commit(option: HubSelectOption | undefined) {
+    if (!option || option.disabled) return;
+    onChange(option.value);
+    close();
+    trigger.current?.focus();
+  }
+  function move(step: number) {
+    if (!options.length) return;
+    let next = active;
+    for (let count = 0; count < options.length; count += 1) {
+      next = (next + step + options.length) % options.length;
+      if (!options[next]?.disabled) break;
+    }
+    setActive(next);
+  }
+
+  useEffect(() => {
+    if (!open) return;
+    function onPointerDown(event: PointerEvent) {
+      const target = event.target as Node;
+      if (trigger.current?.contains(target)) return;
+      if (menu.current?.contains(target)) return;
+      setOpen(false);
+    }
+    document.addEventListener("pointerdown", onPointerDown, true);
+    return () =>
+      document.removeEventListener("pointerdown", onPointerDown, true);
+  }, [open]);
+
+  useLayoutEffect(() => {
+    if (!open) {
+      setPosition(null);
+      return;
+    }
+    function place() {
+      const button = trigger.current;
+      if (!button) return;
+      const rect = button.getBoundingClientRect();
+      const menuHeight = menu.current?.offsetHeight ?? 0;
+      const spaceBelow = window.innerHeight - rect.bottom - 12;
+      const spaceAbove = rect.top - 12;
+      const placeAbove = menuHeight > spaceBelow && spaceAbove > spaceBelow;
+      const width = Math.max(rect.width, variant === "bare" ? 240 : 0);
+      let left = align === "end" ? rect.right - width : rect.left;
+      left = Math.min(
+        Math.max(8, left),
+        Math.max(8, window.innerWidth - width - 8),
+      );
+      setPosition({
+        left,
+        width,
+        maxHeight: Math.max(
+          160,
+          Math.min(320, placeAbove ? spaceAbove : spaceBelow),
+        ),
+        top: placeAbove
+          ? Math.max(8, rect.top - 6 - menuHeight)
+          : rect.bottom + 6,
+      });
+    }
+    place();
+    window.addEventListener("scroll", place, true);
+    window.addEventListener("resize", place);
+    return () => {
+      window.removeEventListener("scroll", place, true);
+      window.removeEventListener("resize", place);
+    };
+  }, [open, align, variant]);
+
+  useLayoutEffect(() => {
+    if (!open) return;
+    const option = menu.current?.querySelector<HTMLElement>(
+      `[data-index="${active}"]`,
+    );
+    option?.scrollIntoView?.({ block: "nearest" });
+  }, [open, active]);
+
+  function onKeyDown(event: KeyboardEvent<HTMLButtonElement>) {
+    if (disabled) return;
+    if (!open) {
+      if (
+        event.key === "ArrowDown" ||
+        event.key === "ArrowUp" ||
+        event.key === "Enter" ||
+        event.key === " "
+      ) {
+        event.preventDefault();
+        openMenu(
+          event.key === "ArrowUp" && selectedIndex < 0
+            ? options.length - 1
+            : selectedIndex,
+        );
+      }
+      return;
+    }
+    if (event.key === "ArrowDown") {
+      event.preventDefault();
+      move(1);
+    } else if (event.key === "ArrowUp") {
+      event.preventDefault();
+      move(-1);
+    } else if (event.key === "Home") {
+      event.preventDefault();
+      setActive(0);
+    } else if (event.key === "End") {
+      event.preventDefault();
+      setActive(options.length - 1);
+    } else if (event.key === "Enter" || event.key === " ") {
+      event.preventDefault();
+      commit(options[active]);
+    } else if (event.key === "Escape") {
+      event.preventDefault();
+      close();
+    } else if (event.key === "Tab") {
+      close();
+    }
+  }
+
+  return (
+    <div
+      className={`hub-select${variant === "bare" ? " is-bare" : ""}${className ? ` ${className}` : ""}`}
+    >
+      <button
+        ref={trigger}
+        type="button"
+        role="combobox"
+        aria-label={label}
+        aria-haspopup="listbox"
+        aria-expanded={open}
+        aria-controls={listId}
+        aria-activedescendant={open ? `${id}-option-${active}` : undefined}
+        className="hub-select__trigger"
+        data-value={value}
+        disabled={disabled}
+        onClick={() => (open ? close() : openMenu())}
+        onKeyDown={onKeyDown}
+      >
+        <span
+          className={`hub-select__value${selected ? "" : " is-placeholder"}`}
+        >
+          {selected?.label ?? "请选择"}
+        </span>
+        <ChevronDown
+          className="hub-select__chevron"
+          size={14}
+          aria-hidden="true"
+        />
+      </button>
+      {open
+        ? createPortal(
+            <ul
+              ref={menu}
+              id={listId}
+              role="listbox"
+              aria-label={label}
+              className="hub-select__menu"
+              style={{
+                left: position?.left ?? 0,
+                top: position?.top ?? 0,
+                width: position?.width,
+                maxHeight: position?.maxHeight,
+                visibility: position ? "visible" : "hidden",
+              }}
+            >
+              {options.map((option, index) => (
+                <li
+                  key={option.value}
+                  id={`${id}-option-${index}`}
+                  role="option"
+                  aria-selected={option.value === value}
+                  aria-disabled={option.disabled || undefined}
+                  data-index={index}
+                  className={`hub-select__option${index === active ? " is-active" : ""}`}
+                  onMouseEnter={() => setActive(index)}
+                  onMouseDown={(event) => event.preventDefault()}
+                  onClick={() => commit(option)}
+                >
+                  <span className="hub-select__option-label">
+                    {option.label}
+                  </span>
+                  <Check
+                    className="hub-select__check"
+                    size={14}
+                    aria-hidden="true"
+                    style={{
+                      visibility: option.value === value ? "visible" : "hidden",
+                    }}
+                  />
+                </li>
+              ))}
+            </ul>,
+            document.body,
+          )
+        : null}
+    </div>
+  );
+}
