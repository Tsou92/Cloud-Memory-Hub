+}
+.hub-select__trigger:hover {
+  border-color: #5b6288;
+  background: #182036;
+}
+.hub-select__trigger[aria-expanded="true"] {
+  border-color: #7d6bb0;
+  background: #182036;
+  box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.16);
+}
+.hub-select__trigger:disabled {
+  opacity: 0.55;
+}
+.hub-select__value {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.hub-select__value.is-placeholder {
+  color: #8e95b3;
+}
+.hub-select__chevron {
+  flex: none;
+  color: #9ca3c0;
+  transition: transform 140ms ease;
+}
+.hub-select__trigger[aria-expanded="true"] .hub-select__chevron {
+  transform: rotate(180deg);
+  color: #c2adff;
+}
+.hub-select.is-bare .hub-select__trigger {
+  width: auto;
+  height: 34px;
+  padding: 0 8px;
+  border: 0;
+  background: transparent;
+  color: #bec4db;
+  font-size: 12px;
+}
+.hub-select.is-bare .hub-select__trigger:hover {
+  border: 0;
+  background: #1a2035;
+  color: #f3f4fc;
+}
+.hub-select.is-bare .hub-select__trigger[aria-expanded="true"] {
+  border: 0;
+  background: #1a2035;
+  box-shadow: none;
+  color: #f3f4fc;
+}
+.hub-select__menu {
+  position: fixed;
+  z-index: 100;
+  box-sizing: border-box;
+  margin: 0;
+  padding: 6px;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  list-style: none;
+  border: 1px solid #363d5c;
+  border-radius: 10px;
+  background: #161b2e;
+  box-shadow:
+    0 18px 44px rgba(3, 5, 12, 0.6),
+    0 2px 8px rgba(3, 5, 12, 0.45);
+  font-family:
+    Inter, "SF Pro Display", "PingFang SC", "Microsoft YaHei", system-ui,
+    sans-serif;
+  animation: hub-select-in 120ms ease;
+}
+.hub-select.is-bare .hub-select__menu {
+  min-width: 240px;
+}
+.hub-select__option {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 9px 10px;
+  border-radius: 7px;
+  color: #d7dbee;
+  font-size: 13px;
+  line-height: 1.4;
+  cursor: pointer;
+}
+.hub-select__option.is-active {
+  background: #262c45;
+  color: #f3f4fc;
+}
+.hub-select__option[aria-selected="true"] {
+  background: #2c2748;
+  color: #efe9ff;
+}
+.hub-select__option[aria-selected="true"].is-active {
+  background: #353052;
+}
+.hub-select__option[aria-disabled="true"] {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+.hub-select__option-label {
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.hub-select__check {
+  flex: none;
+  color: #c2adff;
+}
+@keyframes hub-select-in {
+  from {
+    opacity: 0;
+    transform: translateY(-4px);
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .hub-select__menu {
+    animation: none;
+  }
+  .hub-select__chevron {
+    transition: none;
+  }
+}
+/* Footnote sits on the card's bottom edge, level with the device card footnote. */
+.hub-network-card .hub-network {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  align-items: stretch;
+}
+.hub-network-card .hub-network figcaption {
+  margin-top: auto;
+  line-height: 1.55;
+}
+.hub-network-card .hub-network__empty {
+  margin: auto;
+}
