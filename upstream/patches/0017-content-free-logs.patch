+def logged_content(value) -> str:
+    """Text for a log line: the value itself only when content logging is on."""
+    text = value if isinstance(value, str) else str(value)
+    return text if is_llm_content_logging_enabled() else redact_content(text)
+
+
+_ID_KEY = re.compile(r"(^|_)(id|ids)$")
+_METADATA_KEYS = frozenset({
+    "op", "step", "layer", "status", "scene", "mode", "kind", "variant", "reason",
+    "error", "error_code", "verified", "source", "owner", "valid_until", "memory_at",
+})
+
+
+def _redact_parsed_value(value, key=""):
+    if isinstance(value, dict):
+        return {k: _redact_parsed_value(v, str(k)) for k, v in value.items()}
+    if isinstance(value, list):
+        return [_redact_parsed_value(v, key) for v in value]
+    if isinstance(value, str) and not (
+        key in _METADATA_KEYS or _ID_KEY.search(key) or key.endswith(("_ms", "_at"))
+    ):
+        return redact_content(value)
+    return value
+
+
+def redact_parsed(parsed_str: str) -> str:
+    """Keep the JSON shape, IDs, counts and enums; redact free-text values."""
+    if not parsed_str:
+        return parsed_str
+    try:
+        obj = json.loads(parsed_str)
+    except (TypeError, ValueError):
+        return redact_content(parsed_str)
+    return json.dumps(_redact_parsed_value(obj), ensure_ascii=False, default=str)
+
