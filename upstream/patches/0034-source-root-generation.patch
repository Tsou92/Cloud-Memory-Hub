new file mode 100644
index 0000000..4f1f535
--- /dev/null
+++ b/memhub/apps/core/src/one_memory/imports/root_metadata.py
@@ -0,0 +1,116 @@
+"""Read a directory's identity from an open descriptor, including its birth time."""
+
+import ctypes
+import errno
+import os
+import sys
+from collections.abc import Callable
+from dataclasses import dataclass
+from functools import cache
+from typing import cast
+
+
+@dataclass(frozen=True)
+class RootMetadata:
+    inode: int
+    mode: int
+    uid: int
+    gid: int
+    birth_ns: int
+
+
+class _StatxTimestamp(ctypes.Structure):
+    _fields_ = [
+        ("seconds", ctypes.c_int64),
+        ("nanoseconds", ctypes.c_uint32),
+        ("reserved", ctypes.c_int32),
+    ]
+
+
+class _Statx(ctypes.Structure):
+    # Linux UAPI fixes this structure at 256 bytes. Fields after dev_minor are
+    # not needed here; reserve their complete space for newer kernel versions.
+    _fields_ = [
+        ("mask", ctypes.c_uint32),
+        ("blksize", ctypes.c_uint32),
+        ("attributes", ctypes.c_uint64),
+        ("nlink", ctypes.c_uint32),
+        ("uid", ctypes.c_uint32),
+        ("gid", ctypes.c_uint32),
+        ("mode", ctypes.c_uint16),
+        ("spare", ctypes.c_uint16),
+        ("inode", ctypes.c_uint64),
+        ("size", ctypes.c_uint64),
+        ("blocks", ctypes.c_uint64),
+        ("attributes_mask", ctypes.c_uint64),
+        ("atime", _StatxTimestamp),
+        ("btime", _StatxTimestamp),
+        ("ctime", _StatxTimestamp),
+        ("mtime", _StatxTimestamp),
+        ("rdev_major", ctypes.c_uint32),
+        ("rdev_minor", ctypes.c_uint32),
+        ("dev_major", ctypes.c_uint32),
+        ("dev_minor", ctypes.c_uint32),
+        ("reserved", ctypes.c_uint64 * 14),
+    ]
+
+
+_AT_EMPTY_PATH = 0x1000
+_STATX_REQUEST = 0x07FF | 0x0800  # BASIC_STATS | BTIME
+_STATX_REQUIRED = 0x0001 | 0x0002 | 0x0008 | 0x0010 | 0x0100 | 0x0800
+
+
+@cache
+def _statx_function() -> Callable[..., int]:
+    try:
+        function = ctypes.CDLL(None, use_errno=True).statx
+    except (AttributeError, OSError):
+        raise OSError(errno.ENOTSUP, "Directory birth time is unavailable") from None
+    function.argtypes = [
+        ctypes.c_int,
+        ctypes.c_char_p,
+        ctypes.c_int,
+        ctypes.c_uint,
+        ctypes.POINTER(_Statx),
+    ]
+    function.restype = ctypes.c_int
+    return cast(Callable[..., int], function)
+
+
+def _linux_metadata(descriptor: int) -> RootMetadata:
+    details = _Statx()
+    result = _statx_function()(
+        descriptor, b"", _AT_EMPTY_PATH, _STATX_REQUEST, ctypes.byref(details)
+    )
+    if result != 0:
+        raise OSError(ctypes.get_errno(), "Directory identity is unavailable")
+    if details.mask & _STATX_REQUIRED != _STATX_REQUIRED:
+        raise OSError(errno.ENOTSUP, "Directory birth time is unavailable")
+    if details.btime.nanoseconds >= 1_000_000_000:
+        raise OSError(errno.EIO, "Invalid directory birth time")
+    return RootMetadata(
+        inode=details.inode,
+        mode=details.mode,
+        uid=details.uid,
+        gid=details.gid,
+        birth_ns=details.btime.seconds * 1_000_000_000 + details.btime.nanoseconds,
+    )
+
+
+def root_metadata(descriptor: int) -> RootMetadata:
+    if sys.platform == "linux":
+        return _linux_metadata(descriptor)
+    details = os.fstat(descriptor)
+    birth_ns = getattr(details, "st_birthtime_ns", None)
+    if birth_ns is None:
+        birth_time = getattr(details, "st_birthtime", None)
+        if birth_time is None:
+            raise OSError(errno.ENOTSUP, "Directory birth time is unavailable")
+        birth_ns = int(birth_time * 1_000_000_000)
+    return RootMetadata(
+        inode=details.st_ino,
+        mode=details.st_mode,
+        uid=details.st_uid,
+        gid=details.st_gid,
+        birth_ns=birth_ns,
+    )
