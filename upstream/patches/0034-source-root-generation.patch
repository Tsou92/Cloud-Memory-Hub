new file mode 100644
index 0000000..c5d0731
--- /dev/null
+++ b/memhub/apps/core/tests/test_source_root_metadata.py
@@ -0,0 +1,157 @@
+import ctypes
+import errno
+import os
+import stat
+import sys
+from dataclasses import replace
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from one_memory.imports import access, root_metadata
+from one_memory.imports.access import AuthorizedSourceRoot, SourceAccessError, SourceAccessErrorCode
+
+
+def _statx_reply(monkeypatch, *, mask=root_metadata._STATX_REQUIRED, error=0, nanoseconds=73):
+    calls = []
+
+    def read(descriptor, path, flags, requested, pointer):
+        calls.append((descriptor, path, flags, requested))
+        if error:
+            ctypes.set_errno(error)
+            return -1
+        details = ctypes.cast(pointer, ctypes.POINTER(root_metadata._Statx)).contents
+        details.mask = mask
+        details.inode = 35
+        details.mode = stat.S_IFDIR | 0o700
+        details.uid = 101
+        details.gid = 102
+        details.btime.seconds = 1700000000
+        details.btime.nanoseconds = nanoseconds
+        return 0
+
+    monkeypatch.setattr(root_metadata, "_statx_function", lambda: read)
+    return calls
+
+
+def test_linux_reads_metadata_once_from_the_open_descriptor(monkeypatch):
+    calls = _statx_reply(monkeypatch)
+    result = root_metadata._linux_metadata(71)
+
+    assert result == root_metadata.RootMetadata(
+        35, stat.S_IFDIR | 0o700, 101, 102, 1700000000000000073
+    )
+    assert calls == [(71, b"", 0x1000, 0xFFF)]
+    assert ctypes.sizeof(root_metadata._Statx) == 256
+    assert root_metadata._Statx.btime.offset == 80
+
+
+@pytest.mark.parametrize("missing", [0x1, 0x2, 0x8, 0x10, 0x100, 0x800])
+def test_linux_requires_every_identity_field_in_the_returned_mask(monkeypatch, missing):
+    _statx_reply(monkeypatch, mask=root_metadata._STATX_REQUIRED & ~missing)
+    with pytest.raises(OSError) as refused:
+        root_metadata._linux_metadata(71)
+    assert refused.value.errno == errno.ENOTSUP
+
+
+@pytest.mark.parametrize("error", [errno.ENOSYS, errno.EACCES, errno.EBADF])
+def test_linux_statx_failure_does_not_fall_back_to_stat(monkeypatch, error):
+    _statx_reply(monkeypatch, error=error)
+    monkeypatch.setattr(root_metadata.os, "fstat", lambda _: pytest.fail("No inode-only fallback"))
+    with pytest.raises(OSError) as refused:
+        root_metadata._linux_metadata(71)
+    assert refused.value.errno == error
+
+
+def test_linux_rejects_malformed_birth_time(monkeypatch):
+    _statx_reply(monkeypatch, nanoseconds=1_000_000_000)
+    with pytest.raises(OSError):
+        root_metadata._linux_metadata(71)
+
+
+def test_a_missing_libc_statx_function_is_unavailable(monkeypatch):
+    root_metadata._statx_function.cache_clear()
+    monkeypatch.setattr(root_metadata.ctypes, "CDLL", lambda *a, **kw: SimpleNamespace())
+    try:
+        with pytest.raises(OSError) as refused:
+            root_metadata._statx_function()
+        assert refused.value.errno == errno.ENOTSUP
+    finally:
+        root_metadata._statx_function.cache_clear()
+
+
+def test_non_linux_birth_time_is_required(monkeypatch):
+    monkeypatch.setattr(root_metadata.sys, "platform", "darwin")
+    monkeypatch.setattr(root_metadata.os, "fstat", lambda _: SimpleNamespace())
+    with pytest.raises(OSError) as refused:
+        root_metadata.root_metadata(71)
+    assert refused.value.errno == errno.ENOTSUP
+
+
+def test_root_identity_survives_child_changes_and_descriptor_reopen(tmp_path):
+    root = tmp_path / "source"
+    root.mkdir()
+    expected = access.source_root_identity(root)
+    assert expected.startswith("root:v3:")
+    for index in range(4):
+        child = root / str(index)
+        child.mkdir()
+        (child / "history").write_text("synthetic")
+        assert access.source_root_identity(root) == expected
+        (child / "history").unlink()
+        child.rmdir()
+        assert access.root_identity_matches(root, expected)
+
+
+def test_missing_root_metadata_fails_closed_and_closes_its_descriptor(tmp_path, monkeypatch):
+    root = tmp_path / "source"
+    root.mkdir()
+    opened = []
+
+    def unavailable(descriptor):
+        opened.append(descriptor)
+        raise OSError(errno.ENOTSUP, "birth time missing")
+
+    monkeypatch.setattr(access, "root_metadata", unavailable)
+    with pytest.raises(SourceAccessError) as refused:
+        access.source_root_identity(root)
+    assert refused.value.code is SourceAccessErrorCode.SOURCE_UNAVAILABLE
+    assert len(opened) == 1
+    with pytest.raises(OSError) as closed:
+        os.fstat(opened[0])
+    assert closed.value.errno == errno.EBADF
+
+
+def test_file_open_checks_the_open_root_generation_before_reading(tmp_path, monkeypatch):
+    root = tmp_path / "source"
+    root.mkdir()
+    (root / "history").write_bytes(b"private synthetic history")
+    authorized = AuthorizedSourceRoot.grant(
+        source_id="fixture", root=root, user_confirmed=True, home=tmp_path / "home"
+    ).authorize_file(Path("history"))
+    real_metadata = access.root_metadata
+    checked = []
+
+    def replaced(descriptor):
+        original = real_metadata(descriptor)
+        checked.append(descriptor)
+        return replace(original, birth_ns=original.birth_ns + 1)
+
+    monkeypatch.setattr(access, "root_metadata", replaced)
+    # The descriptor check must enforce the identity even if the later path
+    # lookup points back to the original directory (an ABA path race).
+    monkeypatch.setattr(access, "_check_root_identity", lambda *_: None)
+    with pytest.raises(SourceAccessError) as refused:
+        authorized.open_binary()
+    assert refused.value.code is SourceAccessErrorCode.SOURCE_IDENTITY_CHANGED
+    assert len(checked) == 1
+    with pytest.raises(OSError):
+        os.fstat(checked[0])
+
+
+@pytest.mark.skipif(sys.platform != "linux", reason="Requires a real Linux statx syscall")
+def test_linux_procfs_without_birth_time_refuses_authorization():
+    with pytest.raises(SourceAccessError) as refused:
+        access.source_root_identity(Path("/proc/self"))
+    assert refused.value.code is SourceAccessErrorCode.SOURCE_UNAVAILABLE
