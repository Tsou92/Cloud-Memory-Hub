diff --git a/hy_memory/coding/input_capture.py b/hy_memory/coding/input_capture.py
new file mode 100644
index 0000000..58bba29
--- /dev/null
+++ b/hy_memory/coding/input_capture.py
@@ -0,0 +1,81 @@
+"""Bounded, call-local evidence of inputs used by productivity reconcilers."""
+
+import json
+
+
+class ReconcileInputCapture:
+    MAX_BYTES = 2 * 1024 * 1024
+    MAX_RECORDS = 512
+    MAX_STAGES = 512
+
+    def __init__(self):
+        self.stages = []
+        self.unavailable = False
+        self._records = 0
+        self._bytes = 0
+
+    def begin(self, stage, kind, records, rendered, *, output_id=None):
+        if self.unavailable:
+            return None
+        try:
+            if len(self.stages) >= self.MAX_STAGES:
+                raise ValueError("stage budget")
+            key = {"experience": "experience_id", "fact": "fact_id"}[kind]
+            snapshots = []
+            for record in records:
+                self._records += 1
+                if self._records > self.MAX_RECORDS:
+                    raise ValueError("record budget")
+                payload = record.to_dict()
+                identity = payload[key]
+                if not isinstance(identity, str) or not identity:
+                    raise ValueError("identity")
+                snapshots.append({"kind": kind, "id": identity, "record": payload})
+            item = {
+                "stage": stage, "status": "pending", "inputs": snapshots,
+                "rendered": rendered() if callable(rendered) else rendered, "output_id": output_id,
+            }
+            # No default=str: unknown objects must not become apparently valid evidence.
+            serialized = json.dumps(item, ensure_ascii=False, allow_nan=False)
+            self._bytes += len(serialized.encode())
+            if self._bytes > self.MAX_BYTES:
+                raise ValueError("byte budget")
+            frozen = json.loads(serialized)
+            self.stages.append(frozen)
+            return len(self.stages) - 1
+        except Exception:
+            self.unavailable = True
+            self.stages.clear()
+            return None
+
+    def end(self, token, status):
+        if token is not None and not self.unavailable:
+            if status not in {"used", "fallback", "skipped"}:
+                self.unavailable = True
+                self.stages.clear()
+            else:
+                self.stages[token]["status"] = status
+
+    def result(self, required=()):
+        observed = {item["stage"] for item in self.stages}
+        unavailable = (
+            self.unavailable or not set(required) <= observed
+            or any(item["status"] == "pending" for item in self.stages)
+        )
+        result = {
+            "schema_version": 1,
+            "status": "unavailable" if unavailable else "complete",
+            "stages": [] if unavailable else json.loads(json.dumps(self.stages)),
+        }
+        if len(json.dumps(result, ensure_ascii=False).encode()) > self.MAX_BYTES:
+            return {"schema_version": 1, "status": "unavailable", "stages": []}
+        return result
+
+
+def begin_capture(capture, *args, **kwargs):
+    return capture.begin(*args, **kwargs) if capture is not None else None
+
+
+def end_capture(capture, token, status):
+    if capture is not None:
+        capture.end(token, status)
