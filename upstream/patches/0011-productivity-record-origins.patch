diff --git a/hy_memory/coding/record_origin.py b/hy_memory/coding/record_origin.py
new file mode 100644
index 0000000..f320a8f
--- /dev/null
+++ b/hy_memory/coding/record_origin.py
@@ -0,0 +1,90 @@
+"""Bind a productivity record's semantic version to its producing SDK request."""
+
+import hashlib
+import hmac
+import json
+
+_FIELDS = {
+    "experience": (
+        "experience_id",
+        "user_id",
+        "agent_id",
+        "task",
+        "search_keys",
+        "solution",
+        "boundary_envs",
+        "workspace_id",
+        "branch",
+        "session_id",
+        "files",
+        "confidence",
+        "source",
+        "extraction_source",
+        "created_at",
+        "updated_at",
+    ),
+    "fact": (
+        "fact_id",
+        "user_id",
+        "agent_id",
+        "session_id",
+        "workspace_id",
+        "branch",
+        "source",
+        "statement",
+        "files",
+        "subject",
+        "details",
+        "fact_chain_summary",
+        "created_at",
+    ),
+}
+
+
+def record_digest(kind, record):
+    body = {name: record[name] for name in _FIELDS[kind]}
+    if kind == "experience":
+        body["confidence"] = float(body["confidence"])
+    else:
+        for name in ("subject", "details", "fact_chain_summary"):
+            body[name] = body[name] or ""
+    encoded = json.dumps(
+        ["productivity-origin-v1", kind, record.get("origin_request_id"), body],
+        sort_keys=True,
+        ensure_ascii=False,
+        allow_nan=False,
+        separators=(",", ":"),
+    ).encode()
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def stamp_origin(record, kind, request_id):
+    if request_id is not None and (
+        not isinstance(request_id, str) or not request_id or len(request_id) > 512
+    ):
+        raise ValueError("productivity_origin_request_invalid")
+    record.origin_request_id = request_id
+    record.origin_digest = (
+        record_digest(kind, record.to_dict()) if request_id is not None else None
+    )
+
+
+def verified_origin(kind, record):
+    request = record.get("origin_request_id")
+    digest = record.get("origin_digest")
+    if request is None and digest is None:
+        return None
+    try:
+        valid = (
+            isinstance(request, str)
+            and bool(request)
+            and len(request) <= 512
+            and isinstance(digest, str)
+            and len(digest) == 64
+            and hmac.compare_digest(digest, record_digest(kind, record))
+        )
+    except (KeyError, ValueError, TypeError, OverflowError):
+        valid = False
+    if not valid:
+        raise ValueError("productivity_origin_invalid")
+    return request
