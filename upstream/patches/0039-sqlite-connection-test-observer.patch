+@pytest.mark.parametrize("entrypoint", ["sqlite3", "dbapi2"])
+def test_counter_detects_unclosed_connections_without_retaining_them(
+    connection_tracker, entrypoint
+):
+    connect = sqlite3.connect if entrypoint == "sqlite3" else sqlite3.dbapi2.connect
+
+    def use_connection(*, close):
+        connection = connect(":memory:")
+        connection.execute("SELECT 1").fetchone()
+        reference = weakref.ref(connection)
+        if close:
+            connection.close()
+        return reference
+
+    with _without_cyclic_collection():
+        before = connection_tracker.count()
+        closed = use_connection(close=True)
+        assert closed() is None
+        assert connection_tracker.count() == before
+        unclosed = use_connection(close=False)
+        try:
+            assert unclosed() is not None
+            assert connection_tracker.count() == before + 1
+        finally:
+            if unclosed() is not None:
+                unclosed().close()
+        assert unclosed() is None
+        assert connection_tracker.count() == before
+
+
+@pytest.mark.parametrize("positional", [False, True])
+def test_counter_rejects_an_untracked_factory(connection_tracker, positional):
+    class OtherConnection(sqlite3.Connection):
+        pass
+
+    with pytest.raises(AssertionError, match="untracked connection factory"):
+        if positional:
+            sqlite3.connect(":memory:", 5.0, 0, "", True, OtherConnection)
+        else:
+            sqlite3.connect(":memory:", factory=OtherConnection)
+    assert connection_tracker.count() == 0
+
