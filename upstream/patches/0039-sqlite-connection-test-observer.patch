+def test_counter_does_not_retain_a_concurrently_growing_tuple(connection_tracker, monkeypatch):
+    entered, resume, finished = threading.Event(), threading.Event(), threading.Event()
+    errors, result = [], []
+    snapshot_calls = 0
+    get_objects = gc.get_objects
+
+    def values():
+        for value in range(20):
+            if value == 10:
+                entered.set()
+                assert resume.wait(5), "counter did not release tuple construction"
+            yield value
+
+    def construct():
+        try:
+            result.append(tuple(values()))
+        except BaseException as error:  # noqa: BLE001 - worker errors must fail the test
+            errors.append(error)
+        finally:
+            finished.set()
+
+    def held_heap_snapshot():
+        nonlocal snapshot_calls
+        snapshot_calls += 1
+        # Fix the old counter's thread interleaving: retain the real heap snapshot
+        # while tuple() resizes its partially filled tuple. No exception is faked.
+        # The replacement counter must never enter this wrapper.
+        snapshot = get_objects()
+        resume.set()
+        assert finished.wait(5), "tuple construction did not finish"
+        return snapshot
+
+    monkeypatch.setattr(gc, "get_objects", held_heap_snapshot)
+    # Collect before the worker starts; collecting the partial tuple could untrack it.
+    with _without_cyclic_collection():
+        worker = threading.Thread(target=construct)
+        worker.start()
+        try:
+            assert entered.wait(5), "tuple construction did not reach its resize"
+            assert connection_tracker.count() == 0
+        finally:
+            resume.set()
+            worker.join(5)
+        assert not worker.is_alive()
+        assert [str(error) for error in errors] == []
+        assert result == [tuple(range(20))]
+        assert snapshot_calls == 0
