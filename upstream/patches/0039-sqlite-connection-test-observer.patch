+class _TrackedConnection(sqlite3.Connection):
+    # Add weak-reference support without changing close, caching, or transactions.
+    __slots__ = ("__weakref__",)
+
+
+class _ConnectionTracker:
+    def __init__(self, connect):
+        self._connect = connect
+        self._references = []
+        self._lock = threading.Lock()
+
+    def connect(self, *args, **kwargs):
+        # The fixed Core/SDK/Chroma paths use the default connection factory.
+        # An unexpected factory must fail this test instead of escaping its count.
+        assert len(args) < 6 and "factory" not in kwargs, "untracked connection factory"
+        connection = self._connect(*args, **kwargs, factory=_TrackedConnection)
+        with self._lock:
+            self._references.append(weakref.ref(connection))
+        return connection
+
+    def count(self) -> int:
+        with self._lock:
+            references = list(self._references)
+        return sum(reference() is not None for reference in references)
+
+
