@@ -0,0 +1,60 @@
+// @vitest-environment jsdom
+import { cleanup, render, screen, within } from "@testing-library/react";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { MemorySpace } from "./MemorySpace";
+
+const api = vi.hoisted(() => ({ sdk: vi.fn(), legacy: vi.fn() }));
+vi.mock("./api", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("./api")>()),
+  getMemoryAuthority: async () => ({ authority: "sdk", migration_id: null }),
+  getSdkMemoryLibrary: api.sdk,
+  getMemoryLibrary: api.legacy,
+  getMemories: api.legacy,
+  getMemoryGraph: api.legacy,
+  getMemoryProcessing: async () => null,
+  getModelProfiles: async () => [],
+}));
+vi.mock("./GraphWidthPrompt", () => ({ GraphWidthPrompt: () => null }));
+vi.mock("./MemoryNoteComposer", () => ({ MemoryNoteComposer: () => null }));
+
+afterEach(cleanup);
+beforeEach(() => {
+  vi.clearAllMocks();
+  api.sdk.mockResolvedValue({ memories: [], total: 0, offset: 0, limit: 100 });
+});
+
+it("shows an empty fresh SDK library in the default simplified view", async () => {
+  render(<MemorySpace simplified />);
+  const library = await screen.findByRole("region", { name: "SDK 记忆库" });
+  // Initial mount has neither a spinner nor a total; wait for the SDK result.
+  expect(await within(library).findByText("共 0 条")).toBeTruthy();
+  expect(within(library).queryByRole("status")).toBeNull();
+  expect(within(library).queryAllByRole("listitem")).toHaveLength(0);
+  expect(screen.getByText("查看已保存的记忆")).toBeTruthy();
+  expect(screen.getByRole("tab", { name: "问记忆" })).toBeTruthy();
+  expect(screen.getByRole("tab", { name: "历史对话" })).toBeTruthy();
+  expect(api.legacy).not.toHaveBeenCalled();
+});
+
+it("shows stored SDK content without consulting the retired library", async () => {
+  api.sdk.mockResolvedValue({
+    memories: [{ memory_id: "m1", content: "用中文回复", status: "active" }],
+    total: 1,
+    offset: 0,
+    limit: 100,
+  });
+  render(<MemorySpace simplified />);
+  expect(
+    await screen.findByRole("button", { name: "用中文回复" }),
+  ).toBeTruthy();
+  expect(api.legacy).not.toHaveBeenCalled();
+});
+
+it("shows a failed SDK read instead of leaving the legacy loading view", async () => {
+  api.sdk.mockRejectedValue(new Error("synthetic failure"));
+  render(<MemorySpace simplified />);
+  expect((await screen.findByRole("alert")).textContent).toContain(
+    "记忆库读取失败",
+  );
+  expect(api.legacy).not.toHaveBeenCalled();
+});
